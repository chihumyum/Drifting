{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "node scripts/compile-macos-icon.mjs"
  },
  "bundle": {
    "icon": [
      "../src/assets/icon.png",
      "../src/assets/icon.ico",
      "../src/assets/icon.icns",
      "../out/macos-icon/Assets.car"
    ]
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Drifting",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 18,
          "y": 23
        },
        "backgroundThrottling": "disabled",
        "transparent": false,
        "visible": false
      }
    ]
  }
}
