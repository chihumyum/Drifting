{
  "name": "drifting-core",
  "productName": "Drifting",
  "version": "0.1.0",
  "description": "Drifting - A creative writing and storytelling tool",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "cross-env DRIFTING_DB_DIR=.local-data/databases tauri dev",
    "tauri:build": "cross-env VITE_API_BASE_URL=https://api.drifting.cc VITE_REQUIRE_AUTH=true VITE_AI_TRANSPORT=proxy VITE_CLOSED_BETA=false API_BASE_URL=https://api.drifting.cc tauri build",
    "tauri:build:debug": "cross-env VITE_API_BASE_URL=https://api.drifting.cc VITE_REQUIRE_AUTH=true VITE_AI_TRANSPORT=proxy VITE_CLOSED_BETA=false API_BASE_URL=https://api.drifting.cc tauri build --debug",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "cross-env VITE_API_BASE_URL=https://api.drifting.cc VITE_REQUIRE_AUTH=true VITE_AI_TRANSPORT=proxy VITE_CLOSED_BETA=false API_BASE_URL=https://api.drifting.cc tauri ios build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "cross-env VITE_API_BASE_URL=https://api.drifting.cc VITE_REQUIRE_AUTH=true VITE_AI_TRANSPORT=proxy VITE_CLOSED_BETA=false API_BASE_URL=https://api.drifting.cc tauri android build",
    "dev": "cross-env DRIFTING_DB_DIR=.local-data/databases tauri dev",
    "dev:local": "cross-env VITE_LOCAL_ONLY_MODE=true VITE_ENABLE_SYNC=false DRIFTING_DB_DIR=.local-data/databases tauri dev",
    "start": "cross-env DRIFTING_DB_DIR=.local-data/databases tauri dev",
    "package": "pnpm tauri:build",
    "db:inspect": "node scripts/inspect-local-db.js",
    "db:inspect:all": "cross-env DRIFTING_DB_INSPECT_USERDATA=1 node scripts/inspect-local-db.js",
    "demo:seed": "node scripts/seed-demo-project.js",
    "demo:purge-local": "node scripts/seed-demo-project.js --purge-only",
    "db:generate": "drizzle-kit generate",
    "make": "pnpm tauri:build",
    "icons": "node scripts/gen-icons.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "test:agent-runtime": "vitest run src/renderer/lib/agent/runtime --reporter=dot",
    "eval:agent:p1:live": "node scripts/run-p1-deepseek-live-eval.mjs",
    "eval:agent:canary": "cross-env DRIFTING_AGENT_LIVE_SUITE=product-canary node scripts/run-p1-deepseek-live-eval.mjs",
    "eval:agent:p2:crash": "node src/renderer/lib/agent/runtime/acceptance/p2-crash-recovery.acceptance.mjs",
    "eval:agent:p3:write": "vitest run src/renderer/lib/agent/runtime/acceptance/p3-write-path.acceptance.test.ts --reporter=verbose",
    "eval:agent:p3:crash": "node src/renderer/lib/agent/runtime/acceptance/p3-crash-consistency.acceptance.mjs",
    "eval:agent:p3": "node src/renderer/lib/agent/runtime/acceptance/p3.acceptance.mjs",
    "eval:agent:p4": "node src/renderer/lib/agent/runtime/acceptance/p4.acceptance.mjs --output=docs/agent-runtime/acceptance/p4-summary.json",
    "eval:agent:p5": "node src/renderer/lib/agent/runtime/acceptance/p5.acceptance.mjs --output=docs/agent-runtime/acceptance/p5-summary.json",
    "eval:shadow": "vitest run --config vitest.eval.config.ts src/renderer/lib/shadow/eval/shadow-eval.eval.ts",
    "eval:shadow:smoke": "vitest run --config vitest.eval.config.ts src/renderer/lib/shadow/eval/smoke.eval.ts",
    "eval:corpus": "node scripts/eval-corpus.mjs",
    "eval:chunk-ab": "vitest run --config vitest.eval.config.ts src/renderer/lib/shadow/eval/chunk-ab.eval.ts",
    "eval:dep-hint-ab": "vitest run --config vitest.eval.config.ts src/renderer/lib/shadow/eval/dep-hint-ab.eval.ts",
    "eval:model-hint-sweep": "vitest run --config vitest.eval.config.ts src/renderer/lib/shadow/eval/model-hint-sweep.eval.ts",
    "eval:diag-timeout": "vitest run --config vitest.eval.config.ts src/renderer/lib/shadow/eval/diag-timeout.eval.ts",
    "eval:diag-focus": "vitest run --config vitest.eval.config.ts src/renderer/lib/shadow/eval/diag-focus.eval.ts",
    "eval:diag-search": "vitest run --config vitest.eval.config.ts src/renderer/lib/shadow/eval/diag-search.eval.ts",
    "eval:gen": "vitest run --config vitest.eval.config.ts src/renderer/lib/shadow/eval/corpus-gen.eval.ts"
  },
  "keywords": [
    "tauri",
    "writing",
    "storytelling",
    "creative"
  ],
  "author": {
    "name": "chihumyum",
    "email": "108172547+chihumyum@users.noreply.github.com"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "2.11.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@google/genai": "^2.6.0",
    "@sinclair/typebox": "^0.34.49",
    "@tanstack/react-query": "^5.90.20",
    "@tauri-apps/api": "2.11.1",
    "@tiptap/core": "^3.17.0",
    "@tiptap/extension-collaboration": "^3.19.0",
    "@tiptap/extension-link": "^3.17.0",
    "@tiptap/extension-text-align": "^3.17.0",
    "@tiptap/extension-underline": "^3.17.0",
    "@tiptap/extensions": "^3.17.0",
    "@tiptap/pm": "^3.17.0",
    "@tiptap/react": "^3.17.0",
    "@tiptap/starter-kit": "^3.17.0",
    "@tiptap/suggestion": "^3.17.0",
    "@tiptap/y-tiptap": "^3.0.7",
    "axios": "^1.13.2",
    "better-auth": "^1.4.17",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "docx": "^9.5.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.29.0",
    "html-parse-stringify": "^3.0.1",
    "i18next": "^25.6.0",
    "jszip": "^3.10.1",
    "loglevel": "^1.9.2",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.10.0",
    "marked": "^16.0.0",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.6",
    "openai": "^6.39.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.13.0",
    "react-use-measure": "^2.1.7",
    "react-window": "^2.2.5",
    "uuid": "^13.0.0",
    "uuidv7": "^1.1.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29",
    "zod": "^4.4.3",
    "zustand": "^5.0.10"
  }
}
