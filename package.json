{
  "name": "drifting",
  "productName": "Drifting",
  "version": "0.1.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.23.1"
  },
  "description": "Drifting - A creative writing and storytelling tool",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "node scripts/run-desktop-tauri.mjs dev",
    "tauri:build": "node scripts/run-desktop-tauri.mjs build",
    "tauri:build:debug": "node scripts/run-desktop-tauri.mjs build --debug",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "cross-env VITE_LOCAL_ONLY_MODE=true VITE_REQUIRE_AUTH=false VITE_AI_TRANSPORT=direct VITE_API_BASE_URL=http://localhost:3000 API_BASE_URL=http://localhost:3000 tauri ios build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "cross-env VITE_LOCAL_ONLY_MODE=true VITE_REQUIRE_AUTH=false VITE_AI_TRANSPORT=direct VITE_API_BASE_URL=http://localhost:3000 API_BASE_URL=http://localhost:3000 tauri android build",
    "dev": "pnpm tauri:dev",
    "dev:local": "pnpm tauri:dev",
    "dev:online": "node scripts/run-desktop-tauri.mjs dev --online",
    "start": "pnpm tauri:dev",
    "package": "pnpm tauri:build",
    "db:inspect": "node scripts/inspect-local-db.js",
    "db:inspect:all": "cross-env DRIFTING_DB_INSPECT_USERDATA=1 node scripts/inspect-local-db.js",
    "dev:cli": "tsx --conditions=import src/dev-cli/main.ts",
    "dev:cli:capabilities": "tsx scripts/generate-dev-cli-capabilities.ts",
    "dev:cli:check": "tsx scripts/generate-dev-cli-capabilities.ts --check && vitest run src/dev-cli --reporter=verbose",
    "frontend:debug:check": "vitest run src/dev-cli/frontend-debug src/renderer/lib/frontend-debug --reporter=verbose && node scripts/check-frontend-debug-release.mjs",
    "macos:dev-signing:check": "node scripts/check-macos-dev-signing.mjs",
    "db:generate": "drizzle-kit generate",
    "make": "pnpm tauri:build",
    "icons": "node scripts/gen-icons.mjs",
    "icons:mobile": "node scripts/gen-mobile-icons.mjs",
    "icons:mobile:check": "node scripts/check-mobile-icons.mjs",
    "mobile:ios:dev": "node scripts/run-mobile-dev.mjs ios",
    "mobile:android:dev": "node scripts/run-mobile-dev.mjs android",
    "mobile:ios:debug": "node scripts/run-mobile-debug.mjs ios",
    "mobile:ios:device:debug": "node scripts/install-ios-debug-device.mjs",
    "mobile:android:debug": "node scripts/run-mobile-debug.mjs android",
    "mobile:google-drive:acceptance:contract": "tsx scripts/check-google-drive-physical-evidence.ts --contract",
    "mobile:google-drive:acceptance": "tsx scripts/check-google-drive-physical-evidence.ts",
    "drifting": "pnpm dev:cli",
    "drifting:check": "pnpm dev:cli:check",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "test:renderer-architecture": "vitest run src/renderer/architecture/renderer-boundaries.test.ts",
    "perf:renderer": "node scripts/run-renderer-performance.mjs",
    "perf:renderer:check": "node scripts/check-renderer-performance.mjs",
    "perf:renderer:settings": "node scripts/run-renderer-deferred-settings.mjs",
    "perf:renderer:graphs": "node scripts/run-renderer-deferred-graphs.mjs",
    "perf:renderer:preload": "node scripts/run-renderer-deferred-graphs.mjs --preload",
    "perf:renderer:native": "node scripts/run-renderer-native.mjs",
    "perf:renderer:selection": "node --conditions=import --import=tsx scripts/measure-selection-memory.ts",
    "perf:renderer:libraries": "node scripts/run-renderer-deferred-libraries.mjs",
    "workspace:generation:acceptance": "node scripts/run-workspace-generation-acceptance.mjs",
    "agent:removal:acceptance": "node scripts/run-agent-removal-acceptance.mjs",
    "agent:navigation:acceptance": "node scripts/run-agent-navigation-acceptance.mjs",
    "agent:send:acceptance": "node scripts/run-agent-send-acceptance.mjs",
    "workspace:elements:acceptance": "node scripts/run-workspace-element-acceptance.mjs",
    "workspace:refresh:acceptance": "node scripts/run-workspace-refresh-acceptance.mjs",
    "workspace:projection:recovery": "node scripts/run-workspace-projection-recovery.mjs",
    "reference:index:acceptance": "node scripts/run-reference-index-acceptance.mjs",
    "reference:index:recovery": "node scripts/run-reference-index-recovery.mjs",
    "agent:checkpoint:acceptance": "node scripts/run-agent-checkpoint-acceptance.mjs",
    "agent:control:recovery": "node scripts/run-agent-control-recovery.mjs",
    "agent:chat:recovery": "node scripts/run-agent-chat-recovery.mjs",
    "test:agent-runtime": "vitest run src/renderer/lib/agent/runtime --reporter=dot",
    "agent:debug:server": "node scripts/agent-headless-debug-server.mjs",
    "agent:debug:turn": "node scripts/agent-headless-debug-turn.mjs",
    "agent:debug:review": "node scripts/agent-headless-debug-review.mjs",
    "agent:debug:writes": "node scripts/agent-headless-debug-write-matrix.mjs",
    "agent:conversation-sync:evidence": "tsx scripts/generate-agent-conversation-sync.ts",
    "agent:conversation-sync:check": "tsx scripts/generate-agent-conversation-sync.ts --check && vitest run src/renderer/sync/agent-chat --reporter=verbose",
    "agent:capabilities:generate": "tsx scripts/generate-agent-capabilities.ts",
    "agent:capabilities:check": "tsx scripts/generate-agent-capabilities.ts --check && vitest run src/renderer/lib/agent/runtime/drifting-agent-capability-manifest.test.ts src/renderer/lib/agent/runtime/acceptance/retired-shadow-arc-evolve.acceptance.test.ts src/renderer/lib/agent/runtime/acceptance/ambient-editor-design.acceptance.test.ts --reporter=verbose",
    "eval:agent:tool-reliability": "node src/renderer/lib/agent/runtime/acceptance/milestone-b-tool-reliability.acceptance.mjs --output=docs/agent-runtime/acceptance/milestone-b-tool-reliability.json",
    "eval:agent:durability": "node src/renderer/lib/agent/runtime/acceptance/milestone-c-durable-review.acceptance.mjs --output=docs/agent-runtime/acceptance/milestone-c-durable-review.json",
    "eval:agent:crud": "node src/renderer/lib/agent/runtime/acceptance/milestone-d-domain-crud.acceptance.mjs --output=docs/agent-runtime/acceptance/milestone-d-domain-crud.json",
    "eval:agent:long-task": "node src/renderer/lib/agent/runtime/acceptance/milestone-e-long-task.acceptance.mjs --output=docs/agent-runtime/acceptance/milestone-e-long-task.json",
    "eval:agent:working-memory": "vitest run src/renderer/usecase/useAgentWorkingMemory.test.ts src/renderer/lib/agent/runtime/working-memory-document.test.ts src/renderer/lib/agent/runtime/working-memory-tool-runtime.test.ts src/renderer/lib/agent/runtime/drifting-agent-capability-manifest.test.ts src/renderer/lib/agent/runtime/drifting-workspace-tool-selection.test.ts src/renderer/lib/agent/runtime/system-prompt.test.ts src/renderer/lib/agent/runtime/acceptance/p3-product-migrations.integration.test.ts --reporter=verbose",
    "eval:prose-metrics": "vitest run src/renderer/domain/book-node.test.ts src/renderer/lib/word-count.test.ts src/renderer/services/node-prose-metrics.service.test.ts src/renderer/store/writing-stats-store.test.ts src/renderer/usecase/useProject-summary.test.ts src/renderer/lib/agent/runtime/drifting-domain-crud-write-strategy.integration.test.ts --reporter=verbose",
    "eval:agent:context": "node src/renderer/lib/agent/runtime/acceptance/milestone-f-context-engineering.acceptance.mjs --output=docs/agent-runtime/acceptance/milestone-f-context-engineering.json",
    "eval:agent:writing": "node src/renderer/lib/agent/runtime/acceptance/milestone-h-writing-intelligence.acceptance.mjs --output=docs/agent-runtime/acceptance/milestone-h-writing-intelligence.json",
    "eval:agent:writing:live": "cross-env DRIFTING_AGENT_LIVE_SUITE=writing-canary node scripts/run-p1-deepseek-live-eval.mjs",
    "eval:agent:concurrency:live": "cross-env DRIFTING_AGENT_LIVE_SUITE=concurrent-writing-canary node scripts/run-p1-deepseek-live-eval.mjs",
    "eval:agent:extensions": "node src/renderer/lib/agent/runtime/acceptance/milestone-i-provider-extension.acceptance.mjs --output=docs/agent-runtime/acceptance/milestone-i-provider-extension.json",
    "eval:agent:extensions:live": "node scripts/run-agent-provider-live-canary.mjs",
    "eval:agent:openai-native": "node src/renderer/lib/agent/runtime/acceptance/openai-native-transport.acceptance.mjs --output=docs/agent-runtime/acceptance/openai-native-transport.json",
    "eval:agent:endurance:4h": "node scripts/agent-endurance-soak.mjs --profile=4h",
    "eval:agent:endurance:12h": "node scripts/agent-endurance-soak.mjs --profile=12h",
    "eval:agent:native:verify": "node scripts/agent-native-artifact-smoke.mjs",
    "eval:agent:p1:live": "node scripts/run-p1-deepseek-live-eval.mjs",
    "eval:agent:canary": "cross-env DRIFTING_AGENT_LIVE_SUITE=product-canary node scripts/run-p1-deepseek-live-eval.mjs",
    "eval:agent:p2:crash": "node src/renderer/lib/agent/runtime/acceptance/p2-crash-recovery.acceptance.mjs",
    "eval:agent:p3:write": "vitest run src/renderer/lib/agent/runtime/acceptance/p3-write-path.acceptance.test.ts --reporter=verbose",
    "eval:agent:p3:crash": "node src/renderer/lib/agent/runtime/acceptance/p3-crash-consistency.acceptance.mjs",
    "eval:agent:p3": "node src/renderer/lib/agent/runtime/acceptance/p3.acceptance.mjs",
    "eval:agent:p4": "node src/renderer/lib/agent/runtime/acceptance/p4.acceptance.mjs --output=docs/agent-runtime/acceptance/p4-summary.json",
    "eval:agent:p5": "node src/renderer/lib/agent/runtime/acceptance/p5.acceptance.mjs --output=docs/agent-runtime/acceptance/p5-summary.json",
    "ci:contract:check": "node scripts/check-ci-contract.mjs",
    "public:check": "node scripts/check-public-boundaries.mjs",
    "release:check": "node scripts/check-alpha-release.mjs",
    "release:sbom": "node scripts/generate-release-sbom.mjs"
  },
  "keywords": [
    "tauri",
    "writing",
    "storytelling",
    "creative"
  ],
  "author": "chihumyum",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chihumyum/Drifting.git"
  },
  "bugs": {
    "url": "https://github.com/chihumyum/Drifting/issues"
  },
  "homepage": "https://github.com/chihumyum/Drifting#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "2.11.4",
    "@types/chrome-remote-interface": "0.34.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "chrome-remote-interface": "0.34.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@drifting/prose-metrics": "workspace:*",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@google/genai": "^2.6.0",
    "@sinclair/typebox": "^0.34.49",
    "@tanstack/react-query": "^5.90.20",
    "@tauri-apps/api": "2.11.1",
    "@tiptap/core": "^3.17.0",
    "@tiptap/extension-collaboration": "^3.19.0",
    "@tiptap/extension-link": "^3.17.0",
    "@tiptap/extension-text-align": "^3.17.0",
    "@tiptap/extension-underline": "^3.17.0",
    "@tiptap/extensions": "^3.17.0",
    "@tiptap/pm": "^3.17.0",
    "@tiptap/react": "^3.17.0",
    "@tiptap/starter-kit": "^3.17.0",
    "@tiptap/suggestion": "^3.17.0",
    "@tiptap/y-tiptap": "^3.0.7",
    "axios": "^1.13.2",
    "better-auth": "^1.4.17",
    "buffer": "^6.0.3",
    "cborg": "6.1.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "docx": "^9.5.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "fractional-indexing": "4.0.0",
    "framer-motion": "^12.29.0",
    "html-parse-stringify": "^3.0.1",
    "i18next": "^25.6.0",
    "jszip": "^3.10.1",
    "loglevel": "^1.9.2",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.10.0",
    "marked": "^16.0.0",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.6",
    "openai": "^6.39.0",
    "pdfjs-dist": "^6.2.108",
    "pinyin-pro": "^3.29.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.13.0",
    "react-use-measure": "^2.1.7",
    "react-window": "^2.2.5",
    "uuid": "^13.0.0",
    "uuidv7": "^1.1.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29",
    "zustand": "^5.0.10"
  }
}
