# Copy this file to .env.local for local development.
# .env.local is ignored by git.

# Server sync is enabled by default. Vite only exposes variables with the VITE_ prefix.
VITE_API_BASE_URL=http://localhost:3000
VITE_REQUIRE_AUTH=true

# Loopback `tauri dev` keeps its login token under an isolated localStorage key
# to avoid repeated macOS Keychain prompts from ad-hoc debug signatures.
# Set this to `keychain` when explicitly testing the production storage path.
# VITE_DEV_SESSION_STORAGE=keychain

# AI transport. "proxy" sends the task to Drifting Server together with the
# user's transient BYOK header. The server does not provide its own model key.
VITE_AI_TRANSPORT=proxy

# Native host/server env. This must match VITE_API_BASE_URL for OAuth callbacks.
API_BASE_URL=http://localhost:3000

# Optional dev override. Keeps SQLite in the repository-local development directory.
DRIFTING_DB_DIR=.local-data/databases
