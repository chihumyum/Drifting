# Copy this file to .env.local for local development.
# .env.local is ignored by git.

# Renderer env. Vite only exposes variables with the VITE_ prefix.
VITE_API_BASE_URL=http://localhost:3000
VITE_LOCAL_ONLY_MODE=false
VITE_ENABLE_SYNC=true
VITE_REQUIRE_AUTH=true

# Electron main process env. This must match VITE_API_BASE_URL for OAuth cookies.
API_BASE_URL=http://localhost:3000

# Optional dev override. Keeps SQLite out of Electron userData so local cleanup
# scripts cannot remove it.
DRIFTING_DB_DIR=.local-data/databases

# Optional SQLite debug tracing.
# Use "project" to log project-related db:run SQL.
DRIFTING_DB_TRACE=project

# Use "true" to print project rows before/after migrations, after traced writes,
# and before DB close.
DRIFTING_DB_TRACE_PROJECT_STATE=true

# Use "true" to print .db/.db-wal/.db-shm size and mtime around open/close.
DRIFTING_DB_TRACE_FILES=true
