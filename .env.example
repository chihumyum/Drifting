# Optional: copy this file to .env.local for provider/development overrides.
# A normal local-only source build does not require this file.
# .env.local is ignored by git.

# Apple Developer team id (ten alphanumerics) for iOS device signing. The
# mobile launcher writes it into the ignored LocalBuild.local.xcconfig.
# Simulator builds work without it; leave empty if you have no Apple team.
# DRIFTING_APPLE_DEVELOPMENT_TEAM=

# Public-source builds are local-only by default. These explicit values make
# the network boundary visible when copying this file to .env.local.
VITE_API_BASE_URL=http://localhost:3000
VITE_TERMS_URL=
VITE_PRIVACY_URL=https://github.com/chihumyum/Drifting/blob/main/PRIVACY.md
VITE_LOCAL_ONLY_MODE=true
VITE_REQUIRE_AUTH=false

# Optional Hosted-build Sentry project (public DSN, never an auth token).
# Local-only builds remain silent even when these values are present.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=  # normally generated from package version + Git SHA
# VITE_DRIFTING_CRASH_REPORTS_IN_DEV=1  # explicit opt-in for an isolated dev run
# Configured Sentry production builds require these private CI upload inputs:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Loopback `tauri dev` keeps its login token under an isolated localStorage key
# to isolate development logins from the production Keychain session.
# Set this to `keychain` when explicitly testing the production storage path.
# VITE_DEV_SESSION_STORAGE=keychain

# "direct" sends BYOK requests straight to the selected model provider.
# Set "proxy" only when using a compatible service that you operate or trust.
VITE_AI_TRANSPORT=direct

# Native host/server env. This must match VITE_API_BASE_URL for OAuth callbacks.
API_BASE_URL=http://localhost:3000

# Optional dev override. Keeps SQLite in the repository-local development directory.
DRIFTING_DB_DIR=.local-data/databases
