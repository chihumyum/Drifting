# Copy this file to .env.local for local development.
# .env.local is ignored by git.

# Server sync is enabled by default. Vite only exposes variables with the VITE_ prefix.
VITE_API_BASE_URL=http://localhost:3000
VITE_REQUIRE_AUTH=true

# AI transport. "proxy" routes all copilot LLM calls through the Drifting server
# (the server holds the hosted provider key — NO provider key in the renderer).
# Requires DEEPSEEK_AI_API_KEY set on the server. Leave unset/empty for the
# legacy direct-to-provider path (which needs VITE_DEEPSEEK_AI_API_KEY here).
VITE_AI_TRANSPORT=proxy

# Electron main process env. This must match VITE_API_BASE_URL for OAuth cookies.
API_BASE_URL=http://localhost:3000

# Optional dev override. Keeps SQLite out of Electron userData so local cleanup
# scripts cannot remove it.
DRIFTING_DB_DIR=.local-data/databases
