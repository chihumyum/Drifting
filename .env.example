# Copy this file to .env.local for local development.
# .env.local is ignored by git.

# Public-source builds are local-only by default. These explicit values make
# the network boundary visible when copying this file to .env.local.
VITE_API_BASE_URL=http://localhost:3000
VITE_TERMS_URL=
VITE_PRIVACY_URL=https://github.com/chihumyum/drifting/blob/main/PRIVACY.md
VITE_LOCAL_ONLY_MODE=true
VITE_REQUIRE_AUTH=false

# Loopback `tauri dev` keeps its login token under an isolated localStorage key
# to avoid repeated macOS Keychain prompts from ad-hoc debug signatures.
# Set this to `keychain` when explicitly testing the production storage path.
# VITE_DEV_SESSION_STORAGE=keychain

# "direct" sends BYOK requests straight to the selected model provider.
# Set "proxy" only when using a compatible service that you operate or trust.
VITE_AI_TRANSPORT=direct

# Native host/server env. This must match VITE_API_BASE_URL for OAuth callbacks.
API_BASE_URL=http://localhost:3000

# Optional dev override. Keeps SQLite in the repository-local development directory.
DRIFTING_DB_DIR=.local-data/databases

# Native OAuth client configuration. Release clients must be separate
# Desktop/iOS/Android clients in the same Google Cloud project. The desktop
# `pnpm dev`/build launcher loads these ignored `.env.local` values into the
# native build environment; explicit shell or CI values take precedence.
# Missing or malformed values disable capability.
# The Desktop installed-app `client_secret` is not a confidential product secret:
# Google distributes it with the installed client, and it is compiled only into
# native code. Keep the local value in ignored `.env.local`, never a `VITE_*` key.
DRIFTING_GOOGLE_DESKTOP_CLIENT_ID=
DRIFTING_GOOGLE_DESKTOP_CLIENT_SECRET=
DRIFTING_GOOGLE_IOS_CLIENT_ID=
DRIFTING_GOOGLE_IOS_REVERSED_CLIENT_ID=
DRIFTING_GOOGLE_ANDROID_CLIENT_ID=
