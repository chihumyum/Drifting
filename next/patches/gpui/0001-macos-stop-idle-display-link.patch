From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Drifting <noreply@drifting.invalid>
Date: Sat, 7 Nov 2026 18:08:42 +0800
Subject: [PATCH 1/2] gpui_macos: stop the display link when a window goes idle

---
 crates/gpui_macos/src/window.rs | 95 ++++++++++++++++++++++++++++++++-
 1 file changed, 94 insertions(+), 1 deletion(-)

diff --git a/crates/gpui_macos/src/window.rs b/crates/gpui_macos/src/window.rs
index 01807c773a..fe1f95339c 100644
--- a/crates/gpui_macos/src/window.rs
+++ b/crates/gpui_macos/src/window.rs
@@ -648,6 +648,16 @@ struct MacWindowState {
     cursor_style: CursorStyle,
     cursor_visible: Arc<AtomicBool>,
     frame_source: Option<WindowFrameSource>,
+    /// Display-link ticks in a row that drew nothing and had no frame demand.
+    idle_ticks: u32,
+    /// The display link is stopped because the window went idle; the frame
+    /// waker restarts it (shared with the waker, which must not lock).
+    idle_stopped: Arc<AtomicBool>,
+    /// Whether this window drew (or re-presented) since the last tick began.
+    drew_since_tick: bool,
+    /// Set by the frame waker, so a tick that is running when GPUI gains
+    /// demand does not stop the link under it.
+    frame_demand: Arc<AtomicBool>,
     renderer: renderer::Renderer,
     request_frame_callback: Option<Box<dyn FnMut(RequestFrameOptions)>>,
     event_callback: Option<Box<dyn FnMut(PlatformInput) -> gpui::DispatchEventResult>>,
@@ -816,6 +826,8 @@ impl MacWindowState {
 
     fn start_display_link(&mut self) {
         self.stop_display_link();
+        self.idle_ticks = 0;
+        self.idle_stopped.store(false, Ordering::Relaxed);
         if !self
             .native_window()
             .occlusionState()
@@ -1073,6 +1085,10 @@ impl MacWindow {
                 cursor_style: CursorStyle::Arrow,
                 cursor_visible,
                 frame_source: None,
+                idle_ticks: 0,
+                idle_stopped: Arc::new(AtomicBool::new(false)),
+                drew_since_tick: false,
+                frame_demand: Arc::new(AtomicBool::new(false)),
                 renderer,
                 request_frame_callback: None,
                 event_callback: None,
@@ -1991,6 +2007,30 @@ impl PlatformWindow for MacWindow {
         self.0.as_ref().lock().request_frame_callback = Some(callback);
     }
 
+    fn frame_waker(&self) -> Option<Rc<dyn Fn()>> {
+        // Weak: the waker lives in the window's invalidator, which the frame
+        // callback this state holds also captures.
+        let state = Arc::downgrade(&self.0);
+        let (demand, idle_stopped) = {
+            let lock = self.0.lock();
+            (lock.frame_demand.clone(), lock.idle_stopped.clone())
+        };
+        Some(Rc::new(move || {
+            demand.store(true, Ordering::Relaxed);
+            // The waker runs on the main thread, possibly inside a platform
+            // callback that holds the state lock, so it never locks: waking
+            // from idle is finished on the next turn of the main queue.
+            if idle_stopped.swap(false, Ordering::AcqRel) {
+                let context = Box::into_raw(Box::new(state.clone())) as *mut c_void;
+                // SAFETY: `wake_from_idle` takes back exactly this box, once,
+                // on the main queue.
+                unsafe {
+                    DispatchQueue::main().exec_async_f(context, wake_from_idle);
+                }
+            }
+        }))
+    }
+
     fn on_input(&self, callback: Box<dyn FnMut(PlatformInput) -> gpui::DispatchEventResult>) {
         self.0.as_ref().lock().event_callback = Some(callback);
     }
@@ -2092,6 +2132,7 @@ impl PlatformWindow for MacWindow {
 
     fn draw(&self, scene: &gpui::Scene) {
         let mut this = self.0.lock();
+        this.drew_since_tick = true;
         this.renderer.draw(scene);
     }
 
@@ -3338,12 +3379,49 @@ extern "C" fn display_layer(this: &AnyObject, _: Sel, _: *mut AnyObject) {
     }
 }
 
+/// Display-link ticks in a row with nothing drawn and no frame demand after
+/// which the link stops until GPUI wakes it (50 ms at 120 Hz).
+const IDLE_TICKS_BEFORE_STOP: u32 = 6;
+
+/// Restarts an idle-stopped display link and draws the waking frame now:
+/// waiting for the restarted link's first tick would add most of a frame to
+/// every keystroke typed after a pause.
+extern "C" fn wake_from_idle(context: *mut c_void) {
+    // SAFETY: `frame_waker` boxed this weak reference for exactly this call.
+    let state = unsafe { Box::from_raw(context as *mut Weak<Mutex<MacWindowState>>) };
+    let Some(state) = state.upgrade() else {
+        return;
+    };
+    let signal_at = PlatformFrameSignal::capture(scheduler::Instant::now);
+    let mut lock = state.lock();
+    lock.start_display_link();
+    if !lock
+        .native_window()
+        .occlusionState()
+        .contains(NSWindowOcclusionState::Visible)
+    {
+        return;
+    }
+    if let Some(mut callback) = lock.request_frame_callback.take() {
+        drop(lock);
+        callback(RequestFrameOptions {
+            signal_at,
+            signal_source: FrameRequestSource::NativeCallback,
+            ..Default::default()
+        });
+        state.lock().request_frame_callback = Some(callback);
+    }
+}
+
 extern "C" fn step(view: *mut c_void) {
     let view = view as *mut AnyObject;
     let window_state = unsafe { get_window_state(&*view) };
     let mut lock = window_state.lock();
 
     if let Some(mut callback) = lock.request_frame_callback.take() {
+        let demand = lock.frame_demand.clone();
+        demand.store(false, Ordering::Relaxed);
+        lock.drew_since_tick = false;
         let (signal_at, signal_source) = lock
             .frame_source
             .as_ref()
@@ -3358,7 +3436,22 @@ extern "C" fn step(view: *mut c_void) {
             signal_source,
             ..Default::default()
         });
-        window_state.lock().request_frame_callback = Some(callback);
+        let mut lock = window_state.lock();
+        lock.request_frame_callback = Some(callback);
+        // Stop the display link once the window has had nothing to do for a
+        // few ticks; GPUI's frame waker restarts it on the next invalidation
+        // or next-frame request.
+        if lock.drew_since_tick || demand.load(Ordering::Relaxed) {
+            lock.idle_ticks = 0;
+        } else {
+            lock.idle_ticks += 1;
+            if lock.idle_ticks >= IDLE_TICKS_BEFORE_STOP
+                && !lock.idle_stopped.load(Ordering::Relaxed)
+            {
+                lock.stop_display_link();
+                lock.idle_stopped.store(true, Ordering::Release);
+            }
+        }
     }
 }
 
