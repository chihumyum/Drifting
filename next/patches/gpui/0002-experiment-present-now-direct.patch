From: Drifting <noreply@drifting.invalid>
Date: Sat, 7 Nov 2026 18:08:55 +0800
Subject: [PATCH 2/2] gpui_macos: experiment, present from displayLayer without
 a CA transaction

---
 crates/gpui_macos/src/window.rs | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/crates/gpui_macos/src/window.rs b/crates/gpui_macos/src/window.rs
index fe1f95339c..9b5b950b21 100644
--- a/crates/gpui_macos/src/window.rs
+++ b/crates/gpui_macos/src/window.rs
@@ -3358,10 +3358,30 @@ extern "C" fn set_frame_size(this: &AnyObject, _: Sel, size: NSSize) {
     };
 }
 
+/// Experiment: draw from `displayLayer:` without a Core Animation
+/// transaction and without restarting the display link
+/// (`GPUI_PRESENT_NOW_DIRECT=1`).
+fn present_now_direct() -> bool {
+    static DIRECT: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *DIRECT.get_or_init(|| std::env::var_os("GPUI_PRESENT_NOW_DIRECT").is_some())
+}
+
 extern "C" fn display_layer(this: &AnyObject, _: Sel, _: *mut AnyObject) {
     let signal_at = PlatformFrameSignal::capture(scheduler::Instant::now);
     let window_state = unsafe { get_window_state(this) };
     let mut lock = window_state.lock();
+    if present_now_direct()
+        && let Some(mut callback) = lock.request_frame_callback.take()
+    {
+        drop(lock);
+        callback(RequestFrameOptions {
+            signal_at,
+            signal_source: FrameRequestSource::NativeCallback,
+            ..Default::default()
+        });
+        window_state.lock().request_frame_callback = Some(callback);
+        return;
+    }
     if let Some(mut callback) = lock.request_frame_callback.take() {
         lock.renderer.set_presents_with_transaction(true);
         lock.stop_display_link();
