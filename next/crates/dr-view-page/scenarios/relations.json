{
  "about": "RD: a relation row expands into two graph edges in T9's filled left Tab.",
  "steps": [
    {"seed": "lite"},
    {"call": "book.list", "save": "books"},
    {
      "call": "entry.list",
      "input": {"book":"${books.0.id}", "all":true},
      "save": "characters"
    },
    {
      "call":"entry.create",
      "input":{"book":"${books.0.id}", "title":"RD counterpart", "template":"tpl-character", "parent":"${characters.[template=tpl-character].parent}"},
      "save":"second"
    },
    {
      "call":"entry.create",
      "input":{"book":"${books.0.id}", "title":"RD witness", "template":"tpl-character", "parent":"${characters.[template=tpl-character].parent}"},
      "save":"third"
    },
    {
      "call":"relation_row.create_pair",
      "input":{
        "book":"${books.0.id}", "left":"${characters.[template=tpl-character].id}", "right":"${second.id}",
        "new_type":{"name":"RD alliance", "direction":"symmetric"}
      },
      "save":"row"
    },
    {
      "call":"relation_row.add_entry",
      "input":{"book":"${books.0.id}", "id":"${row.id}", "side":"right", "entry":"${third.id}"}
    },
    {
      "launch": {
        "env": {"DRIFTING_APPEARANCE":"light"},
        "settings": {
          "device":{"modules":{"first_run.done":true,"guides.seen":["workspace-tour"]}},
          "account":{"language.ui_locale":"en"}
        }
      }
    },
    {"app":"app.info","save":"environment"},
    {"app":"book.open","params":{"book":"${books.0.id}"}},
    {
      "app":"ui.wait",
      "params":{"state":{"/book/version":5,"/book/loaded":true},"timeout_ms":30000}
    },
    {
      "call":"relation_type.list",
      "input":{"book":"${books.0.id}", "entry":"${characters.[template=tpl-character].id}"},
      "expect":{
        "/[name=RD alliance]/direction":"symmetric",
        "/[name=RD alliance]/pair_count":2,
        "/[name=RD alliance]/rows/0/id":"${row.id}"
      }
    },
    {"app":"ui.press","params":{"label":"Fill left sidebar", "role":"Button"}},
    {"app":"ui.wait","params":{"state":{"/fill":"left"}, "timeout_ms":12000}},
    {"app":"ui.press","params":{"label":"Relations", "role":"RadioButton"}},
    {"app":"ui.wait","params":{"state":{"/v3Sidebar/fillLayout":"relation"}, "timeout_ms":12000}},
    {"app":"ui.find","params":{"label":"RD counterpart", "role":"Button"}},
    {"app":"ui.find","params":{"label":"RD witness", "role":"Button"}},
    {
      "app":"ui.find",
      "params":{"label":"Hide \"RD alliance\"", "role":"Button", "timeout_ms":30000},
      "save":"legend"
    },
    {"app":"app.info","save":"graph_window","expect":{"/windows/0/visible":true}},
    {"app":"ui.screenshot","png":"relations-graph.png"},
    {"app":"app.quit"}
  ]
}
