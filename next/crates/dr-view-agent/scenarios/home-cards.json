{
  "about": "HC 建议卡回作品主页，真窗口（副屏）。只跑 debug-bridge 的 home-cards-acceptance 例程：临时 showcase 库（《慢钟》）、合成模型流、回环地址，不连真实服务、不用真 Key。打开项目落在主页、Agent 看一眼、三张卡两列排在「继续写」下面；点一张：右栏停在 Agent 的那段新对话、主页不动；× 掉一张；设置 → 智能 → Agent 关掉「主动建议」主页上什么都没有，再打开卡回来；Agent 栏里没有「主动建议」开关。深色再开一次截图。",
  "steps": [
    { "launch": { "env": { "DRIFTING_APPEARANCE": "light" } } },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/book/name": "慢钟", "/activeTab": null } } },
    { "app": "ui.find", "params": { "role": "Button", "label": "这一章说钟慢了七分钟，前面写的是五分钟，要对一下吗？", "timeout_ms": 20000 }, "note": "打开项目落在主页：Agent 看完出的卡" },
    { "app": "ui.find", "params": { "role": "Button", "label": "这一章停在钟楼的台阶上，要我先读一遍、留几条批注吗？" } },
    { "app": "ui.find", "params": { "role": "Button", "label": "项目记忆里有两条都在说对话不用引号，要合成一条吗？" } },
    { "app": "ui.find", "params": { "role": "Button", "label": "忽略" }, "expect": { "/count": 3 }, "note": "每张卡右上角一个 ×" },
    { "app": "ui.find", "params": { "label": "主动建议", "absent": true }, "note": "主页上没有开关" },
    { "app": "ui.screenshot", "png": "01-home-cards-light.png" },

    { "app": "ui.press", "params": { "role": "Button", "label": "这一章说钟慢了七分钟，前面写的是五分钟，要对一下吗？" }, "note": "点卡：开一段新对话" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/right/open": true, "/activeTab": null }, "timeout_ms": 10000 }, "note": "右栏打开，主页不动" },
    { "app": "ui.wait", "params": { "until": "time", "ms": 1500 } },
    { "app": "state.get", "contains": { "/right/panes/panes/0/tab": "companion" }, "note": "停在 Agent" },
    { "app": "ui.find", "params": { "label": "主动建议", "absent": true }, "note": "Agent 栏里也没有开关" },
    { "app": "ui.screenshot", "png": "02-card-opened-light.png" },

    { "app": "ui.press", "params": { "role": "Button", "label": "忽略", "nth": 2 }, "note": "× 掉第三张" },
    { "app": "ui.find", "params": { "role": "Button", "label": "项目记忆里有两条都在说对话不用引号，要合成一条吗？", "absent": true } },
    { "app": "ui.find", "params": { "role": "Button", "label": "忽略" }, "expect": { "/count": 2 } },
    { "app": "ui.screenshot", "png": "03-dismissed-light.png" },

    { "app": "action.dispatch", "params": { "name": "app::OpenSettings" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": "settings" } } },
    { "app": "ui.focus", "params": { "field": "settings.search" } },
    { "app": "input.type", "params": { "text": "主动建议" } },
    { "app": "ui.find", "params": { "label": "主动建议" }, "note": "设置 → 智能 → Agent 里的一行" },
    { "app": "ui.screenshot", "png": "04-settings-switch-light.png" },
    { "app": "ui.press", "params": { "label": "主动建议", "role": "CheckBox" } },
    { "app": "settings.get", "params": { "keys": ["agent.proactive_suggestions"] }, "expect": { "/values/agent.proactive_suggestions": false } },
    { "app": "input.key", "params": { "keys": "escape" } },
    { "app": "input.key", "params": { "keys": "escape" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": null } } },
    { "app": "ui.find", "params": { "role": "Button", "label": "这一章停在钟楼的台阶上，要我先读一遍、留几条批注吗？", "absent": true }, "note": "关着：主页上什么都没有" },
    { "app": "ui.screenshot", "png": "05-off-light.png" },

    { "app": "action.dispatch", "params": { "name": "app::OpenSettings" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": "settings" } } },
    { "app": "ui.focus", "params": { "field": "settings.search" } },
    { "app": "input.type", "params": { "text": "主动建议" } },
    { "app": "ui.press", "params": { "label": "主动建议", "role": "CheckBox" } },
    { "app": "settings.get", "params": { "keys": ["agent.proactive_suggestions"] }, "expect": { "/values/agent.proactive_suggestions": true } },
    { "app": "input.key", "params": { "keys": "escape" } },
    { "app": "input.key", "params": { "keys": "escape" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": null } } },
    { "app": "ui.find", "params": { "role": "Button", "label": "这一章停在钟楼的台阶上，要我先读一遍、留几条批注吗？" }, "note": "打开：卡回来（90 分钟内不再看，卡还在）" },
    { "app": "app.quit", "expect": { "/quit": true } },

    { "launch": { "env": { "DRIFTING_APPEARANCE": "dark" } }, "note": "深色再开一次" },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "app": "ui.find", "params": { "role": "Button", "label": "这一章说钟慢了七分钟，前面写的是五分钟，要对一下吗？", "timeout_ms": 20000 } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 600 } },
    { "app": "ui.screenshot", "png": "06-home-cards-dark.png" },
    { "app": "ui.press", "params": { "role": "Button", "label": "这一章说钟慢了七分钟，前面写的是五分钟，要对一下吗？" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/right/open": true, "/activeTab": null }, "timeout_ms": 10000 } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 1500 } },
    { "app": "ui.screenshot", "png": "07-card-opened-dark.png" },
    { "app": "app.quit", "expect": { "/quit": true } }
  ]
}
