    {"app": "ui.press", "params": {"label": "开始录音", "role": "Button"}},
    {"app": "ui.find", "params": {"label": "尚未配置语音转写 Key（阿里云百炼）"}},
    {"app": "ui.screenshot", "png": "04-key-removed.png"},
    {"app": "app.quit", "expect": {"/quit": true, "/exitCode": 0, "/connectionFileLeft": false}}
