    { "app": "ui.press", "params": { "label": "连接", "role": "Button", "dy": -34 }, "note": "Into the key field, just above the buttons." },
    { "app": "input.type", "params": { "text": "synthetic-ca-window-key" } },
    { "app": "ui.press", "params": { "label": "连接", "role": "Button" } },
