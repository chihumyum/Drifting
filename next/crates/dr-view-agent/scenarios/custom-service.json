    { "app": "ui.screenshot", "png": "04-model-name.png" },
    { "app": "input.type", "params": { "text": "example-chat-large" }, "note": "The form put the keyboard in 「模型名」." },
    { "app": "ui.press", "params": { "label": "添加", "role": "Button" } },
    { "app": "ui.find", "params": { "label": "发送", "role": "Button", "timeout_ms": 15000 }, "note": "Connected: the conversation and its composer." },
    { "app": "ui.wait", "params": { "until": "time", "ms": 800 } },
    { "app": "ui.screenshot", "png": "05-connected.png" },
    { "app": "ui.press", "params": { "label": "发送", "role": "Button", "dy": -60 }, "note": "Into the composer above the send button." },
    { "app": "input.type", "params": { "text": "核对一下这一章的记录" } },
    { "app": "input.key", "params": { "keys": "enter" } },
    { "app": "ui.find", "params": { "label": "思考过程", "role": "Button", "count": 1, "timeout_ms": 30000 }, "note": "The stand-in's answer, its <think> folded as reasoning." },
    { "app": "ui.wait", "params": { "until": "time", "ms": 1500 } },
    { "app": "ui.screenshot", "png": "06-answered.png" },
    { "app": "action.dispatch", "params": { "name": "app::OpenSettings" } },
