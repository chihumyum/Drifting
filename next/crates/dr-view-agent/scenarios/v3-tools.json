{
  "about": "K6 real-window smoke. Run with dr-view-agent's v3-acceptance example only: v3 Tiny testkit seed, memory credential, recorded runtime responses, loopback-only unused provider. Window must open on secondary display.",
  "steps": [
    {
      "launch": {
        "env": {
          "DRIFTING_WINDOW_DISPLAY": "secondary"
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/window/active": true
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "app.info",
      "save": "environment"
    },
    {
      "app": "ui.press",
      "params": {
        "label": "展开右侧栏"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/right/open": true
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "发送",
        "role": "Button",
        "dy": -60
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "Inspect this synthetic book and add a module comment."
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "enter"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "结果 · level-off",
        "role": "Button",
        "timeout_ms": 30000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "comment.create",
        "role": "Button"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "entry.set_level",
        "role": "Button"
      }
    },
    {
      "app": "state.get",
      "save": "state"
    },
    {
      "call": "book.get",
      "input": {
        "book": "${state.book.id}"
      },
      "expect": {
        "/summary": "K6 synthetic window update",
        "/word_target": 3000,
        "/daily_word_target": 1500
      }
    },
    {
      "call": "comment.list",
      "input": {
        "book": "${state.book.id}"
      },
      "save": "comments",
      "expect": {
        "/[origin=agent]/body/text": "K6 synthetic module comment",
        "/[origin=agent]/module": "mod-prose",
        "/[origin=agent]/target/kind": "entry",
        "/[origin=agent]/author_kind": "ai",
        "/[origin=agent]/source": "api",
        "/[origin=agent]/anchored": true
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${state.book.id}",
        "id": "${comments.[origin=agent].target.id}"
      },
      "expect": {
        "/title": "K6 checkpointed entry"
      }
    },
    {
      "call": "entry_snapshot.list",
      "input": {
        "book": "${state.book.id}",
        "entry": "${comments.[origin=agent].target.id}"
      },
      "save": "checkpoints",
      "expect": {
        "/0/entry": "${comments.[origin=agent].target.id}"
      }
    },
    {
      "call": "entry_snapshot.preview",
      "input": {
        "book": "${state.book.id}",
        "entry": "${comments.[origin=agent].target.id}",
        "point": "${checkpoints.0.id}"
      },
      "save": "checkpoint_preview",
      "expect": {
        "/metadata/title": "${checkpoints.0.title}"
      }
    },
    {
      "call": "entry_snapshot.restore",
      "input": {
        "book": "${state.book.id}",
        "entry": "${comments.[origin=agent].target.id}",
        "point": "${checkpoints.0.id}",
        "expected": "${checkpoint_preview.expected}"
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${state.book.id}",
        "id": "${comments.[origin=agent].target.id}"
      },
      "expect": {
        "/title": "${checkpoints.0.title}"
      }
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${state.book.id}",
        "query": "V4 smoke",
        "all": true,
        "trashed": true
      },
      "save": "smoke_entries",
      "expect": {
        "/[title=V4 smoke parent]/level": false,
        "/[title=V4 smoke parent]/deleted_at": null
      },
      "note": "Turning 层级 off puts what lives under the entry into Recently Deleted, in place (kernel-v5 §16): the child keeps its parent and is listed only with `trashed`."
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${state.book.id}",
        "query": "V4 smoke",
        "all": true
      },
      "expect": {
        "/0/title": "V4 smoke parent",
        "/1": null
      },
      "note": "Without `trashed` the child is not listed."
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${state.book.id}",
        "id": "${smoke_entries.[title=V4 smoke child].id}"
      },
      "expect": {
        "/parent": "${smoke_entries.[title=V4 smoke parent].id}"
      },
      "note": "It stays where it was."
    },
    {
      "call": "entry_snapshot.list",
      "input": {
        "book": "${state.book.id}",
        "entry": "${smoke_entries.[title=V4 smoke parent].id}"
      },
      "save": "parent_checkpoints",
      "expect": {
        "/0/entry": "${smoke_entries.[title=V4 smoke parent].id}"
      }
    },
    {
      "call": "entry_snapshot.preview",
      "input": {
        "book": "${state.book.id}",
        "entry": "${smoke_entries.[title=V4 smoke parent].id}",
        "point": "${parent_checkpoints.0.id}"
      },
      "save": "parent_preview"
    },
    {
      "call": "entry_snapshot.restore",
      "input": {
        "book": "${state.book.id}",
        "entry": "${smoke_entries.[title=V4 smoke parent].id}",
        "point": "${parent_checkpoints.0.id}",
        "expected": "${parent_preview.expected}"
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${state.book.id}",
        "id": "${smoke_entries.[title=V4 smoke parent].id}"
      },
      "expect": {
        "/level": true
      },
      "note": "The parent's checkpoint turns 层级 back on."
    },
    {
      "call": "entry_snapshot.list",
      "input": {
        "book": "${state.book.id}",
        "entry": "${smoke_entries.[title=V4 smoke child].id}"
      },
      "save": "child_checkpoints",
      "expect": {
        "/0/entry": "${smoke_entries.[title=V4 smoke child].id}"
      }
    },
    {
      "call": "entry_snapshot.preview",
      "input": {
        "book": "${state.book.id}",
        "entry": "${smoke_entries.[title=V4 smoke child].id}",
        "point": "${child_checkpoints.0.id}"
      },
      "save": "child_preview"
    },
    {
      "call": "entry_snapshot.restore",
      "input": {
        "book": "${state.book.id}",
        "entry": "${smoke_entries.[title=V4 smoke child].id}",
        "point": "${child_checkpoints.0.id}",
        "expected": "${child_preview.expected}"
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${state.book.id}",
        "id": "${smoke_entries.[title=V4 smoke child].id}"
      },
      "expect": {
        "/parent": "${smoke_entries.[title=V4 smoke parent].id}",
        "/deleted_at": null
      },
      "note": "The child's checkpoint brings it back from Recently Deleted, under its parent."
    },
    {
      "app": "app.quit",
      "expect": {
        "/quit": true,
        "/exitCode": 0,
        "/connectionFileLeft": false
      }
    }
  ]
}
