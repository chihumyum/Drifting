{
  "about": "K4 G1 boundary evidence, NOT complete entry snapshot restoration: current entry_history.restore restores metadata while both independently edited prose modules remain changed. Uses the public command in a v3-lite real window.",
  "steps": [
    {
      "seed": "lite"
    },
    {
      "call": "book.list",
      "save": "books"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "call": "entry_template.put_module",
      "input": {
        "book": "${books.0.id}",
        "template": "tpl-chapter",
        "module": {
          "id": "second-prose",
          "kind": "prose",
          "name": "Second",
          "pos": "a9"
        }
      }
    },
    {
      "call": "module.prose_document",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "second-prose"
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "save": "original"
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "second-prose"
      },
      "save": "second_original"
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "checkpoint"
    },
    {
      "launch": {
        "env": {
          "DRIFTING_APPEARANCE": "light"
        },
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000
      }
    },
    {
      "app": "window.focus",
      "params": {}
    },
    {
      "app": "book.open",
      "params": {
        "book": "${books.0.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "state": {
          "/book/version": 3,
          "/book/loaded": true
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "entry:${entries.[template=tpl-chapter].id}/mod-prose"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 700
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-j"
      },
      "note": "Close the default timeline so the G1 page uses the whole paper."
    },
    {
      "app": "ui.wait",
      "params": {
        "state": {
          "/bottom/pane": null
        },
        "timeout_ms": 10000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 700
      }
    },
    {
      "app": "ui.press",
      "params": {
        "role": "TextArea",
        "nth": 0,
        "dy": 40
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-up"
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "A"
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "expect": {
        "/paragraphs/0/text": "A${original.paragraphs.0.text}"
      }
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 380,
        "y": 550,
        "dy": 20000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 700
      }
    },
    {
      "app": "ui.screenshot",
      "png": "second-before.png"
    },
    {
      "app": "ui.press",
      "params": {
        "role": "TextArea",
        "nth": 1
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "B"
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "second-prose"
      },
      "expect": {
        "/paragraphs/0/text": "B"
      }
    },
    {
      "call": "entry.update",
      "input": {
        "book": "${books.0.id}",
        "id": "${entries.[template=tpl-chapter].id}",
        "title": "G1 Changed"
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${entries.[template=tpl-chapter].id}"
      },
      "expect": {
        "/title": "G1 Changed"
      }
    },
    {
      "call": "entry_history.restore",
      "input": {
        "book": "${books.0.id}",
        "at": "${checkpoint.version}",
        "targets": [
          {
            "collection": "entries",
            "id": "${entries.[template=tpl-chapter].id}"
          }
        ]
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${entries.[template=tpl-chapter].id}"
      },
      "expect": {
        "/title": "${entries.[template=tpl-chapter].title}"
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "expect": {
        "/paragraphs/0/text": "A${original.paragraphs.0.text}"
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "second-prose"
      },
      "expect": {
        "/paragraphs/0/text": "B"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 1000
      }
    },
    {
      "app": "ui.screenshot",
      "png": "02-second-body-after-metadata-restore.png"
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 380,
        "y": 550,
        "dy": -20000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 700
      }
    },
    {
      "app": "ui.screenshot",
      "png": "03-title-and-body-after-metadata-restore.png"
    },
    {
      "app": "app.quit"
    }
  ]
}
