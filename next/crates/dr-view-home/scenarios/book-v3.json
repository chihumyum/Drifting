{
  "about": "v5-lite 主流程冒烟：作品主页就地改标题并一步撤销、验证底部「项目模板」块（无设定对话框），按模板动作新建，成稿导出，单本书导出并作为新书导入。运行器须把此隔离窗口放在副屏；本场景不做截图或 heavy 测量。",
  "steps": [
    {
      "seed": "lite"
    },
    {
      "call": "book.list",
      "save": "books"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "launch": {
        "book": "${books.0.id}",
        "env": {
          "DRIFTING_APPEARANCE": "light"
        },
        "settings": {
          "account": {
            "language.ui_locale": "en"
          },
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          }
        }
      },
      "save": "app"
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 1500
      }
    },
    {
      "app": "app.info",
      "save": "environment"
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/book/version": 5,
          "/book/loaded": true
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "action.dispatch",
      "params": {
        "name": "workspace::ShowProjectHome"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/page": "home",
          "/book/version": 5,
          "/book/loaded": true
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "${books.0.name}",
        "timeout_ms": 10000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Synopsis…",
        "timeout_ms": 10000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "role": "CheckBox",
        "label": "Manuscript",
        "timeout_ms": 10000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Book target",
        "timeout_ms": 10000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Daily goal",
        "timeout_ms": 10000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Instructions",
        "timeout_ms": 10000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Save as project template",
        "absent": true,
        "timeout_ms": 5000
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "ui.press",
      "params": {
        "label": "${books.0.name}"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-a"
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "T2 inline title"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "enter"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/book/name": "T2 inline title",
          "/dialog": false
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "T2 inline title",
        "timeout_ms": 10000
      },
      "note": "标题框的读屏名字跟着项目名变"
    },
    {
      "app": "input.key",
      "params": {
        "keys": "escape"
      },
      "note": "回车进了梗概（作者四乙）；Esc 离开梗概，撤销回到工作区"
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/focus/workspace": true,
          "/dialog": false
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-z"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/book/name": "${books.0.name}"
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "ui.press",
      "params": {
        "role": "Button",
        "label": "新建章节 · 书稿",
        "nth": 0
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "G4 synthetic chapter"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "enter"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/dialog": false
        },
        "timeout_ms": 30000
      }
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "created",
      "expect": {
        "/[title=G4 synthetic chapter]/template": "tpl-chapter",
        "/[title=G4 synthetic chapter]/parent": "${entries.[template=tpl-manuscript].id}"
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "book:${entries.[template=tpl-manuscript].id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000
      }
    },
    {
      "app": "ui.press",
      "params": {
        "role": "Button",
        "label": "More actions"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Export manuscript"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Word"
      }
    },
    {
      "app": "panel.answer",
      "params": {
        "path": "${app.out}/g4-manuscript.docx"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "role": "Button",
        "label": "Export Word"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "file",
        "path": "${app.out}/g4-manuscript.docx",
        "timeout_ms": 30000
      }
    },
    {
      "app": "ui.press",
      "params": {
        "role": "Button",
        "label": "Close"
      }
    },
    {
      "app": "shelf.show"
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/shelf": true,
          "/dialog": false
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "ui.find",
      "params": {
        "role": "Button",
        "label": "Open “${books.0.name}”",
        "timeout_ms": 10000
      }
    },
    {
      "app": "panel.answer",
      "params": {
        "path": "${app.out}/g4-book.driftingproject"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Export this project (.driftingproject)",
        "within": {
          "label": "Open “${books.0.name}”"
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "file",
        "path": "${app.out}/g4-book.driftingproject",
        "timeout_ms": 60000
      }
    },
    {
      "app": "panel.answer",
      "params": {
        "path": "${app.out}/g4-book.driftingproject"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "role": "Button",
        "contains": "Import project"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/dialog": false
        },
        "timeout_ms": 60000
      }
    },
    {
      "app": "ui.find",
      "params": {
        "role": "Button",
        "label": "Open “${books.0.name}”",
        "count": 2,
        "timeout_ms": 30000
      }
    },
    {
      "call": "book.list",
      "save": "after"
    },
    {
      "app": "app.info",
      "save": "final_environment"
    },
    {
      "app": "app.quit",
      "expect": {
        "/quit": true
      }
    }
  ]
}
