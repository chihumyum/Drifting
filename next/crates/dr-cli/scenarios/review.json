{
  "about": "M18 批注：正文里选中几个字，选区浮条出来；⌘⌥M 打开撰写框，写一条批注、点「保存」；再选一段写成 TODO（⌘↵ 存）；右栏「审阅」标签列出这两条；批注锚在选中的字上。界面用英文。",
  "steps": [
    { "seed": "showcase" },
    { "call": "book.list", "save": "books" },
    { "call": "chapter.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "chapters" },
    { "call": "comment.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "before" },

    { "launch": { "env": { "DRIFTING_APPEARANCE": "light" }, "settings": { "account": { "language.ui_locale": "en" } } } },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "慢钟" } } },
    { "app": "nav.open", "params": { "chapter": "${chapters.0.id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "chapter:${chapters.0.id}", "/focus/editor": true } } },

    { "app": "input.key", "params": { "keys": "shift-right", "times": 4 }, "note": "光标在开头：选中「推开怀山」" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/selection/anchor": 0, "/selection/head": 4, "/selectionBar": true } },
      "note": "选区停下 180 ms 后浮条该出来（dr-editor 的状态里有了）" },
    { "app": "ui.find", "params": { "label": "添加批注" }, "pending": "浮条的状态有了却没画出来，按钮也不在无障碍树里（待协调 F4e）" },
    { "app": "input.key", "params": { "keys": "secondary-alt-m" }, "note": "⌘⌥M：撰写框在选区下面" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/composer": true } } },
    { "app": "ui.find", "params": { "role": "RadioButton", "label": "Comments" } },
    { "app": "input.type", "params": { "text": "验收批注：这里的门声要更轻。" } },
    { "app": "ui.screenshot", "png": "01-composer.png" },
    { "app": "input.key", "params": { "keys": "secondary-enter" }, "note": "⌘↵ 存" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/composer": false } } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 600 } },
    { "call": "comment.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[body=验收批注：这里的门声要更轻。]/kind": "note", "/[body=验收批注：这里的门声要更轻。]/quote": "推开怀山",
                  "/[body=验收批注：这里的门声要更轻。]/anchored": true, "/[body=验收批注：这里的门声要更轻。]/target/id": "${chapters.0.id}" } },

    { "app": "state.get", "expect": { "/focus/editor": true }, "note": "存完光标回到正文" },
    { "app": "input.key", "params": { "keys": "secondary-up" } },
    { "app": "input.key", "params": { "keys": "right", "times": 27 }, "note": "第二段「铺子里挂」之后" },
    { "app": "input.key", "params": { "keys": "shift-right", "times": 6 } },
    { "app": "input.key", "params": { "keys": "secondary-alt-m" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/composer": true } } },
    { "app": "input.type", "params": { "text": "验收 TODO：核对钟的数目。" } },
    { "app": "ui.press", "params": { "role": "RadioButton", "label": "TODOs" }, "note": "写完再改成 TODO" },
    { "app": "state.get", "save": "afterKind", "note": "点了「批注 | TODO」，正文把键盘拿走了（待协调 M18）" },
    { "app": "ui.press", "params": { "label": "Save" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/composer": false } } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 600 } },
    { "call": "comment.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "after",
      "expect": { "/[body=验收 TODO：核对钟的数目。]/kind": "todo", "/[body=验收 TODO：核对钟的数目。]/quote": "着四十多只钟",
                  "/[body=验收 TODO：核对钟的数目。]/status": "open", "/[body=验收 TODO：核对钟的数目。]/anchored": true } },

    { "app": "ui.press", "params": { "label": "Open right sidebar" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/right/open": true } } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "app": "ui.screenshot", "png": "02-review.png", "note": "右栏「审阅」：这两条排在第一章一组的最上面" },
    { "app": "app.quit", "expect": { "/quit": true } }
  ]
}
