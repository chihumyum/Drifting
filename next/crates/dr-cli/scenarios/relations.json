{
  "about": "M17 关系与关系类型：打开要素「沈知微」，滚到页尾的「关联」（她的关系都在）；「编辑类型」→「新建」，写「宿敌」保存（有向、默认角色）；给「宿敌」换第三个颜色；「关联实体」搜「林晚秋」、选「宿敌」、「创建」；F3 里有沈知微 → 林晚秋 的宿敌；× 移除这条关系；再开「编辑类型」，「宿敌」的垃圾桶：类型面板收起、问「删除关系类型」，确认后 F3 里没有了。界面用英文。",
  "steps": [
    { "seed": "showcase" },
    { "call": "book.list", "save": "books" },
    { "call": "element.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "els" },
    { "call": "relation.list",
      "input": { "book": "${books.[name=慢钟].id}", "entity": { "kind": "element", "id": "${els.[name=沈知微].id}" } },
      "save": "before", "note": "沈知微原有的关系" },

    { "launch": { "env": { "DRIFTING_APPEARANCE": "light" }, "settings": { "account": { "language.ui_locale": "en" } } } },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "慢钟" } } },
    { "app": "nav.open", "params": { "target": "element:${els.[name=沈知微].id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "element:${els.[name=沈知微].id}" } } },
    { "app": "input.scroll", "params": { "x": 600, "y": 400, "dy": 20000 }, "note": "滚到页尾：「字段」下面是「关联」" },
    { "app": "ui.find", "params": { "label": "Edit types" }, "expect": { "/count": 1 } },
    { "app": "ui.find", "params": { "label": "Remove relation" }, "save": "cards", "note": "她原有的关系，一条一张卡片" },
    { "app": "ui.screenshot", "png": "01-relations.png" },

    { "app": "ui.press", "params": { "label": "Edit types" }, "note": "打开全书的关系类型" },
    { "app": "ui.press", "params": { "label": "New" } },
    { "app": "input.type", "params": { "text": "宿敌" }, "note": "新类型的编辑器打开时，名称框拿着键盘" },
    { "app": "ui.screenshot", "png": "02-new-type.png" },
    { "app": "ui.press", "params": { "label": "Save" } },
    { "app": "ui.find", "params": { "label": "Change color for 宿敌" }, "note": "存好，列表里有它" },
    { "call": "relation_type.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "types",
      "expect": { "/[name=宿敌]/orientation": "directed", "/[name=宿敌]/source_role": "Source", "/[name=宿敌]/target_role": "Target" } },

    { "app": "ui.press", "params": { "label": "Change color for 宿敌" }, "note": "展开七个颜色" },
    { "app": "ui.press", "params": { "label": "Change color 3" } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "call": "relation_type.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[name=宿敌]/color": "hsl(var(--story-3))" } },
    { "app": "ui.screenshot", "png": "03-coloured.png" },
    { "app": "ui.press", "params": { "label": "Edit types" }, "note": "再点一下收起" },
    { "app": "ui.find", "params": { "label": "Change color for 宿敌", "absent": true } },

    { "app": "ui.press", "params": { "label": "Link entity" }, "note": "选择器就地打开，搜索框拿着键盘" },
    { "app": "input.type", "params": { "text": "林晚秋" } },
    { "app": "ui.press", "params": { "role": "Button", "label": "林晚秋" }, "note": "选中，等着定类型" },
    { "app": "ui.press", "params": { "label": "Choose a relation type" } },
    { "app": "ui.press", "params": { "role": "MenuItem", "label": "宿敌" } },
    { "app": "ui.screenshot", "png": "04-pending.png" },
    { "app": "ui.press", "params": { "label": "Create" } },
    { "app": "ui.find", "params": { "role": "Group", "label": "林晚秋" }, "note": "多了一张卡片" },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "call": "relation.list",
      "input": { "book": "${books.[name=慢钟].id}", "entity": { "kind": "element", "id": "${els.[name=沈知微].id}" } },
      "expect": { "/[relation_type=${types.[name=宿敌].id}]/from/id": "${els.[name=沈知微].id}",
                  "/[relation_type=${types.[name=宿敌].id}]/to/id": "${els.[name=林晚秋].id}" } },
    { "app": "ui.screenshot", "png": "05-related.png" },

    { "app": "ui.press", "params": { "label": "Remove relation", "within": { "role": "Group", "label": "林晚秋" } },
      "note": "× 悬停才出现；用的类型删不掉，先移除这条关系" },
    { "app": "ui.find", "params": { "role": "Group", "label": "林晚秋", "absent": true } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "call": "relation.list",
      "input": { "book": "${books.[name=慢钟].id}", "entity": { "kind": "element", "id": "${els.[name=沈知微].id}" } },
      "expect": { "/[relation_type=${types.[name=宿敌].id}]": null } },

    { "app": "ui.press", "params": { "label": "Edit types" } },
    { "app": "ui.find", "params": { "role": "Group", "label": "亲人" }, "save": "top" },
    { "app": "input.scroll", "params": { "x": "${top.nodes.0.center.0}", "y": "${top.nodes.0.center.1}", "dy": 800 },
      "note": "「宿敌」是最后一行：和作者一样把类型列表滚到底" },
    { "app": "ui.press", "params": { "label": "Delete relation type", "within": { "role": "Group", "label": "宿敌" } } },
    { "app": "ui.find", "params": { "label": "Delete relation type", "count": 1 },
      "note": "类型面板收起，只剩对话框里的按钮" },
    { "app": "ui.screenshot", "png": "06-delete.png" },
    { "app": "ui.press", "params": { "label": "Delete relation type" } },
    { "app": "ui.find", "params": { "label": "Delete relation type", "absent": true } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "call": "relation_type.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[name=宿敌]": null, "/[name=师徒]/name": "师徒" } },
    { "app": "ui.find", "params": { "label": "Remove relation", "count": "${cards.count}" }, "note": "回到原来那么多张" },
    { "app": "ui.screenshot", "png": "07-after.png" },
    { "app": "app.quit" }
  ]
}
