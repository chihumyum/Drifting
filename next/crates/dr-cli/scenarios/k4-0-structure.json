{
  "about": "K4-0 structure correctness: isolated secondary window, setting override and inherited source refresh, explicit null, retained prose input, Book/Material/template navigation and persisted reload. No heavy or visual acceptance.",
  "steps": [
    {
      "seed": "lite"
    },
    {
      "call": "book.list",
      "input": {},
      "save": "books"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "call": "entry.create",
      "input": {
        "book": "${books.0.id}",
        "parent": "${entries.[template=tpl-manuscript].id}",
        "template": "tpl-group",
        "title": "Synthetic structure smoke"
      },
      "save": "level"
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "save": "original"
    },
    {
      "launch": {
        "env": {
          "DRIFTING_APPEARANCE": "light",
          "DRIFTING_WINDOW_DISPLAY": "secondary"
        },
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      },
      "save": "firstLaunch"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "app.info",
      "save": "firstEnvironment",
      "expect": {
        "/windows/0/active": true,
        "/windows/0/visible": true
      }
    },
    {
      "app": "book.open",
      "params": {
        "book": "${books.0.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/book/version": 3
        }
      }
    },
    {
      "app": "state.get",
      "save": "loaded"
    },
    {
      "app": "action.dispatch",
      "params": {
        "name": "workspace::ToggleBottomTimeline"
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "entry:${level.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "entry:${level.id}"
        }
      }
    },
    {
      "app": "state.get",
      "expect": {
        "/v3Page/sections/[id=settings]/registered": true
      },
      "note": "Filtered array selectors belong to scenario expectations; ui.wait takes plain JSON pointers."
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 1050,
        "y": 420,
        "dy": 2000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Default template",
        "role": "Group",
        "count": 1
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Off",
        "role": "Button",
        "within": {
          "label": "Automatic links",
          "role": "Group"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "On",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      },
      "note": "Use the existing settings-smoke save interval before comparing the authoritative frontier."
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "refreshed1"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/revision": "${refreshed1.version}"
        }
      }
    },
    {
      "app": "state.get",
      "expect": {
        "/v3/levels/${level.id}/settings/auto_link": true,
        "/v3/levels/${level.id}/sources/auto_link": {
          "kind": "override",
          "entry": "${level.id}"
        }
      },
      "note": "Dynamic pointer keys are expanded by scenario expectations, after ui.wait has matched the kernel frontier."
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true,
        "below": true
      },
      "expect": {
        "/[id=${level.id}]/below/settings/auto_link": true,
        "/[id=${level.id}]/below/sources/auto_link": {
          "kind": "override",
          "entry": "${level.id}"
        }
      }
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "overridden"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/revision": "${overridden.version}"
        }
      }
    },
    {
      "app": "ui.find",
      "params": {
        "contains": "Override · Synthetic structure smoke"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Restore Automatic links",
        "role": "Button"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      },
      "note": "Use the existing settings-smoke save interval before comparing the authoritative frontier."
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "refreshed2"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/revision": "${refreshed2.version}"
        }
      }
    },
    {
      "app": "state.get",
      "expect": {
        "/v3/levels/${level.id}/settings/auto_link": false,
        "/v3/levels/${level.id}/sources/auto_link": {
          "kind": "template",
          "entry": "${entries.[template=tpl-manuscript].id}",
          "template": "tpl-manuscript"
        }
      },
      "note": "Dynamic pointer keys are expanded by scenario expectations, after ui.wait has matched the kernel frontier."
    },
    {
      "app": "ui.find",
      "params": {
        "contains": "Template ·"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "章",
        "role": "Button",
        "within": {
          "label": "Default template",
          "role": "Group"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "None",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      },
      "note": "Use the existing settings-smoke save interval before comparing the authoritative frontier."
    },
    {
      "call": "entry_history.version",
