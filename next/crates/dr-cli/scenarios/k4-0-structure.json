    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "material:${loaded.v3.materials.[kind=text].id}"
        }
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "template:tpl-chapter"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "template:tpl-chapter"
        }
      }
    },
    {
      "app": "app.quit"
    },
    {
      "launch": {
        "env": {
          "DRIFTING_APPEARANCE": "light",
          "DRIFTING_WINDOW_DISPLAY": "secondary"
        },
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      },
      "save": "secondLaunch"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "app.info",
      "save": "secondEnvironment",
      "expect": {
        "/windows/0/active": true,
        "/windows/0/visible": true
      }
    },
    {
      "app": "book.open",
      "params": {
        "book": "${books.0.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      },
      "note": "Use the existing settings-smoke save interval before comparing the authoritative frontier."
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "refreshed5"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/book/version": 3,
          "/v3/revision": "${refreshed5.version}"
