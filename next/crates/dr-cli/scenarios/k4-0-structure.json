      }
    },
    {
      "app": "state.get",
      "expect": {
        "/v3/levels/${level.id}/settings/default_template": null,
        "/v3/levels/${level.id}/sources/default_template": {
          "kind": "override",
          "entry": "${level.id}"
        }
      },
      "note": "Dynamic pointer keys are expanded by scenario expectations, after ui.wait has matched the kernel frontier."
    },
    {
      "app": "nav.open",
      "params": {
        "target": "entry:${entries.[template=tpl-chapter].id}/mod-prose"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "entry:${entries.[template=tpl-chapter].id}/mod-prose"
        }
      }
    },
    {
      "app": "ui.find",
      "params": {
        "role": "TextArea",
        "timeout_ms": 15000
      },
      "note": "Use the G1 entry-module prose selector; page/module and persisted paragraph assertions identify the edited document."
    },
    {
      "app": "ui.press",
      "params": {
        "role": "TextArea",
        "nth": 0,
        "dy": 40
      },
      "note": "Use the G1 entry-module prose selector; page/module and persisted paragraph assertions identify the edited document."
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-up"
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "StructureSmoke "
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "expect": {
        "/paragraphs/0/text": "StructureSmoke ${original.paragraphs.0.text}"
      }
    },
    {
      "call": "entry.update",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}",
        "overrides": {
          "display": "grid",
          "default_template": null
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      },
      "note": "Use the existing settings-smoke save interval before comparing the authoritative frontier."
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "refreshed4"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "entry:${entries.[template=tpl-chapter].id}/mod-prose",
          "/v3/revision": "${refreshed4.version}"
        }
      }
    },
    {
      "app": "state.get",
      "expect": {
        "/v3/levels/${level.id}/settings/display": "grid"
      },
      "note": "Dynamic pointer keys are expanded by scenario expectations, after ui.wait has matched the kernel frontier."
    },
    {
      "app": "input.type",
      "params": {
        "text": "AfterRefresh "
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "expect": {
        "/paragraphs/0/text": "StructureSmoke AfterRefresh ${original.paragraphs.0.text}"
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "book:${entries.[template=tpl-manuscript].id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "book:${entries.[template=tpl-manuscript].id}"
        }
      }
    },
    {
      "app": "state.get",
      "expect": {
        "/pages/[key=book:${entries.[template=tpl-manuscript].id}]/ready": true
      },
      "note": "Filtered array selectors belong to scenario expectations; ui.wait takes plain JSON pointers."
    },
    {
      "app": "nav.open",
      "params": {
        "target": "material:${loaded.v3.materials.[kind=text].id}"
