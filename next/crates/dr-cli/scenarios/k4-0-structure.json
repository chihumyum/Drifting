    },
    {
      "app": "state.get",
      "expect": {
        "/v3/levels/${level.id}/settings/display": "grid",
        "/v3/levels/${level.id}/settings/default_template": null,
        "/v3/levels/${level.id}/sources/default_template": {
          "kind": "override",
          "entry": "${level.id}"
        }
      },
      "note": "Dynamic pointer keys are expanded by scenario expectations, after ui.wait has matched the kernel frontier."
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true,
        "below": true
      },
      "expect": {
        "/[id=${level.id}]/below/settings/display": "grid",
        "/[id=${level.id}]/below/sources/display": {
          "kind": "override",
          "entry": "${level.id}"
        }
      }
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "reopened"
