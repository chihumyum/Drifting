      "params": {
        "label": "Synthetic board A",
        "role": "Button",
        "count": 1
      },
      "save": "boardFrom"
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Synthetic board B",
        "role": "Button",
        "count": 1
      },
      "save": "boardTo"
    },
    {
      "app": "input.drag",
      "params": {
        "from": "${boardFrom.nodes.0.center}",
        "to": "${boardTo.nodes.0.center}",
        "steps": 12
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 600
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${boardA.id}"
      },
      "expect": {
        "/layout/board": [
          56.0,
          220.0
        ],
        "/layout/grid": [
          2,
          3
        ],
        "/layout/relation_graph": [
          7.0,
          8.0
        ]
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 4000
      }
    },
    {
      "app": "ui.wait"
    },
    {
      "app": "state.get",
      "expect": {
        "/v3/entries/[id=${boardA.id}]/layout/board": [
          56.0,
          220.0
        ]
      }
    },
    {
      "call": "entry.update",
      "input": {
        "book": "${books.0.id}",
        "id": "${boardB.id}",
        "layout": {
          "board": [
            96.0,
            300.0
          ],
          "grid": [
            2,
            3
          ],
          "relation_graph": [
            7.0,
            8.0
          ]
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 4000
      }
    },
    {
      "app": "ui.wait"
    },
    {
      "app": "state.get",
      "expect": {
        "/v3/entries/[id=${boardB.id}]/layout/board": [
          96.0,
          300.0
        ]
      }
    },
    {
      "app": "input.move",
      "params": {
        "x": 800,
        "y": 120
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Synthetic board A",
        "role": "Button",
        "count": 1
      },
      "save": "boardANode"
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Synthetic board B",
        "role": "Button",
        "count": 1
      },
      "save": "boardBNode"
