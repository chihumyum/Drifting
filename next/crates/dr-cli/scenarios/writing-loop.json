{
  "about": "阶段 2 写作闭环：建 showcase 库 → 从书架打开《慢钟》 → 打开一章 → 在编辑器里输入一段 → 回车 → 撤销 → 换章 → 关闭重开 → 内容、字数、搜索都对。另有一处修改经 F3 以作者身份从窗口外写进第二章，验证打开着的编辑器跟着变、重开后还在。",
  "steps": [
    { "seed": "showcase", "note": "一个全新 profile 的空库里写入 showcase 预设，并补齐索引" },
    { "call": "book.list", "save": "books" },
    { "call": "chapter.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "chapters" },
    { "call": "book.get", "input": { "book": "${books.[name=慢钟].id}" }, "save": "before" },
    { "call": "prose.read", "input": { "doc": "node:${chapters.0.id}" }, "save": "ch1" },
    { "call": "prose.read", "input": { "doc": "node:${chapters.1.id}" }, "save": "ch2" },

    { "launch": { "env": { "DRIFTING_APPEARANCE": "light" } }, "note": "不指定书：窗口先显示书架" },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "state.get", "expect": { "/shelf": true, "/library": true } },
    { "app": "window.focus" },
    { "app": "ui.screenshot", "png": "01-shelf.png" },
    { "app": "book.open", "params": { "name": "慢钟" }, "expect": { "/opened": "${books.[name=慢钟].id}" }, "note": "打开书，和在书架上点书卡一样" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "慢钟" } } },
    { "app": "state.get", "expect": { "/page": "home" } },
    { "app": "ui.screenshot", "png": "02-home.png" },

    { "app": "nav.open", "params": { "chapter": "${chapters.0.title}" }, "expect": { "/opened": "chapter:${chapters.0.id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "chapter:${chapters.0.id}", "/focus/editor": true } },
      "note": "编辑器打开、拿到键盘" },
    { "app": "page.text", "save": "page1",
      "expect": { "/title": "${chapters.0.title}", "/source": "editor", "/paragraphs/0/text": "${ch1.paragraphs.0.text}" } },
    { "app": "ui.screenshot", "png": "03-chapter-1.png" },

    { "app": "input.type", "params": { "text": "验收打字一句。" }, "expect": { "/typed": 7 }, "note": "光标在开头：这句打在第一段前面" },
    { "app": "input.key", "params": { "keys": "enter" }, "expect": { "/handled": [true] } },
    { "app": "ui.wait", "params": { "until": "ready", "text": "验收打字一句。" } },
    { "app": "page.text", "note": "回车把第一段拆成两段",
      "expect": { "/paragraphs/0/text": "验收打字一句。", "/paragraphs/1/text": "${ch1.paragraphs.0.text}" } },
    { "app": "ui.screenshot", "png": "04-typed.png" },
    { "app": "input.key", "params": { "keys": "secondary-z" }, "expect": { "/handled": [true] }, "note": "撤销只撤回车，打的字还在" },
    { "app": "page.text",
      "expect": { "/paragraphs/0/text": "验收打字一句。${ch1.paragraphs.0.text}", "/paragraphs/1/text": "${ch1.paragraphs.1.text}" } },

    { "call": "prose.replace", "note": "窗口外的写入：以作者身份经 F3 改第二章第一段（像帮手那样）",
      "input": { "doc": "node:${chapters.1.id}", "block_id": "${ch2.paragraphs.0.block_id}",
                 "find": "${ch2.paragraphs.0.text}", "replace": "验收的钟停了一下。${ch2.paragraphs.0.text}" } },
    { "app": "nav.open", "params": { "chapter": "${chapters.1.title}" }, "note": "换章" },
    { "app": "ui.wait", "params": { "until": "ready", "text": "验收的钟停了一下。",
                                     "state": { "/page": "chapter:${chapters.1.id}", "/focus/editor": true } } },
    { "app": "state.get",
      "expect": { "/tabs/0/leaves/0/target": "chapter:${chapters.0.id}", "/tabs/1/leaves/0/target": "chapter:${chapters.1.id}", "/activeTab": 1 } },
    { "app": "ui.screenshot", "png": "05-chapter-2.png" },
    { "app": "app.quit", "expect": { "/quit": true, "/connectionFileLeft": false } },

    { "launch": { "env": { "DRIFTING_APPEARANCE": "light" } }, "note": "关闭重开" },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "text": "验收的钟停了一下。",
                                     "state": { "/shelf": false, "/page": "chapter:${chapters.1.id}" } },
      "note": "布局恢复：停在第二章，窗口外写进去的那句还在" },
    { "app": "state.get",
      "expect": { "/tabs/0/leaves/0/target": "chapter:${chapters.0.id}", "/tabs/1/leaves/0/target": "chapter:${chapters.1.id}" } },
    { "app": "nav.open", "params": { "target": "chapter:${chapters.0.id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "chapter:${chapters.0.id}" } } },
    { "app": "page.text", "note": "编辑器里打的那句重开后还在",
      "expect": { "/paragraphs/0/text": "验收打字一句。${ch1.paragraphs.0.text}" } },
    { "call": "prose.read", "input": { "doc": "node:${chapters.0.id}" }, "note": "落盘的和编辑器里的一样，段数没变",
      "expect": { "/total": "${ch1.total}", "/paragraphs/0/text": "验收打字一句。${ch1.paragraphs.0.text}" } },
    { "call": "book.get", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/words": { "$sum": ["${before.words}", 8, 6] } }, "note": "「验收的钟停了一下」8 个字，「验收打字一句」6 个字" },
    { "call": "book.search", "input": { "book": "${books.[name=慢钟].id}", "query": "验收的钟停了一下" },
      "expect": { "/0/title": "${chapters.1.title}" } },
    { "call": "book.search", "input": { "book": "${books.[name=慢钟].id}", "query": "验收打字一句" },
      "expect": { "/0/title": "${chapters.0.title}" } },
    { "app": "ui.screenshot", "png": "06-reopened.png" },
    { "app": "app.quit", "expect": { "/quit": true } }
  ]
}
