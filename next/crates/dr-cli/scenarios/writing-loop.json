{
  "about": "阶段 2 写作闭环：建 showcase 库 → 打开《慢钟》 → 打开一章 → 输入一段 → 回车 → 撤销 → 换章 → 关闭重开 → 内容、字数、搜索都对。编辑器接进稿纸之前（F6），在编辑器里打字的几步标着 pending；另有一处修改经 F3 以作者身份写进去，验证稿纸跟着变、重开后还在。",
  "steps": [
    { "seed": "showcase", "note": "一个全新 profile 的空库里写入 showcase 预设" },
    { "call": "book.list", "save": "books" },
    { "call": "chapter.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "chapters" },
    { "call": "book.get", "input": { "book": "${books.[name=慢钟].id}" }, "save": "before" },
    { "call": "prose.read", "input": { "doc": "node:${chapters.0.id}" }, "save": "ch1" },
    { "call": "prose.read", "input": { "doc": "node:${chapters.1.id}" }, "save": "ch2" },

    { "launch": { "book": "${books.[name=慢钟].id}", "env": { "DRIFTING_APPEARANCE": "light" } } },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "state.get", "expect": { "/book/name": "慢钟", "/library": true, "/page": "home" } },
    { "app": "window.focus" },
    { "app": "ui.screenshot", "png": "01-home.png" },

    { "app": "nav.open", "params": { "chapter": "${chapters.0.title}" }, "expect": { "/opened": "chapter:${chapters.0.id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "chapter:${chapters.0.id}" } } },
    { "app": "page.text", "save": "page1",
      "expect": { "/title": "${chapters.0.title}", "/ready": true, "/paragraphs/0/text": "${ch1.paragraphs.0.text}" } },
    { "app": "ui.screenshot", "png": "02-chapter-1.png" },

    { "app": "input.type", "params": { "text": "验收打字一句。" }, "pending": "F6：编辑器接进稿纸，打开的一章由编辑器拿到焦点" },
    { "app": "input.key", "params": { "keys": "enter" }, "pending": "F6" },
    { "app": "ui.wait", "params": { "until": "ready", "text": "验收打字一句。" }, "pending": "F6" },
    { "app": "ui.screenshot", "png": "03-typed.png", "pending": "F6" },
    { "app": "input.key", "params": { "keys": "secondary-z" }, "note": "撤销回车：段落数回到原样，打的字还在", "pending": "F6" },
    { "call": "prose.read", "input": { "doc": "node:${chapters.0.id}" }, "pending": "F6",
      "contains": { "/paragraphs/0/text": "验收打字一句。" }, "expect": { "/total": "${ch1.total}" } },

    { "call": "prose.replace", "note": "今天就能走通的修改：以作者身份经 F3 改第二章第一段（窗口外的写入，像帮手那样）",
      "input": { "doc": "node:${chapters.1.id}", "block_id": "${ch2.paragraphs.0.block_id}",
                 "find": "${ch2.paragraphs.0.text}", "replace": "验收的钟停了一下。${ch2.paragraphs.0.text}" } },
    { "app": "nav.open", "params": { "chapter": "${chapters.1.title}" }, "note": "换章" },
    { "app": "ui.wait", "params": { "until": "ready", "text": "验收的钟停了一下。", "state": { "/page": "chapter:${chapters.1.id}" } } },
    { "app": "state.get",
      "expect": { "/tabs/0/leaves/0/target": "chapter:${chapters.0.id}", "/tabs/1/leaves/0/target": "chapter:${chapters.1.id}", "/activeTab": 1 } },
    { "app": "ui.screenshot", "png": "04-chapter-2.png" },
    { "app": "app.quit", "expect": { "/quit": true, "/connectionFileLeft": false } },

    { "launch": { "book": "${books.[name=慢钟].id}", "env": { "DRIFTING_APPEARANCE": "light" } }, "note": "关闭重开" },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000, "text": "验收的钟停了一下。", "state": { "/page": "chapter:${chapters.1.id}" } } },
    { "app": "state.get",
      "expect": { "/tabs/0/leaves/0/target": "chapter:${chapters.0.id}", "/tabs/1/leaves/0/target": "chapter:${chapters.1.id}" } },
    { "app": "nav.open", "params": { "target": "chapter:${chapters.0.id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "chapter:${chapters.0.id}" } } },
    { "app": "page.text", "expect": { "/paragraphs/0/text": "${page1.paragraphs.0.text}" }, "note": "第一章没被动过（编辑器接上以后换成下一步）" },
    { "app": "page.text", "contains": { "/text": "验收打字一句。" }, "pending": "F6" },
    { "call": "book.get", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/words": { "$sum": ["${before.words}", 8] } }, "note": "「验收的钟停了一下」8 个字" },
    { "call": "book.get", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/words": { "$sum": ["${before.words}", 8, 6] } }, "pending": "F6：再加「验收打字一句」6 个字" },
    { "call": "book.search", "input": { "book": "${books.[name=慢钟].id}", "query": "验收的钟停了一下" },
      "expect": { "/0/title": "${chapters.1.title}" } },
    { "call": "book.search", "input": { "book": "${books.[name=慢钟].id}", "query": "验收打字一句" },
      "expect": { "/0/title": "${chapters.0.title}" }, "pending": "F6" },
    { "app": "ui.screenshot", "png": "05-reopened.png" },
    { "app": "app.quit", "expect": { "/quit": true } }
  ]
}
