{
  "about": "M11 要素页：打开要素「沈知微」，页头的名字、别名、简介、字段和正文都对；改名（回车离开就存）；改成别人的名字被拒、弹出提示、名字放回；加别名（回车）、去掉旧别名（×）；改简介；「添加字段」新加一行写键和值；再开它的类目页。写进去的都经 F3 的 element.list 读回来对。界面用英文。",
  "steps": [
    { "seed": "showcase" },
    { "call": "book.list", "save": "books" },
    { "call": "element.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "els" },

    { "launch": { "env": { "DRIFTING_APPEARANCE": "light" }, "settings": { "account": { "language.ui_locale": "en" } } } },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "慢钟" } } },
    { "app": "nav.open", "params": { "target": "element:${els.[name=沈知微].id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "element:${els.[name=沈知微].id}" } } },
    { "app": "page.text", "save": "page",
      "expect": { "/head/name": "沈知微", "/head/summary": "${els.[name=沈知微].summary}",
                  "/head/fields/0/key": "${els.[name=沈知微].fields.0.key}", "/head/fields/0/value": "${els.[name=沈知微].fields.0.value}",
                  "/source": "editor" } },
    { "app": "ui.find", "params": { "label": "Remove alias" }, "expect": { "/count": 1 }, "note": "一个别名「知微」，带 ×" },
    { "app": "ui.screenshot", "png": "01-element.png" },

    { "app": "ui.focus", "params": { "field": "element.name", "select_all": true } },
    { "app": "input.type", "params": { "text": "沈知微微" } },
    { "app": "input.key", "params": { "keys": "enter" }, "note": "回车离开名字框，离开就存" },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/focus": null } } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "call": "element.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[id=${els.[name=沈知微].id}]/name": "沈知微微" } },

    { "app": "ui.focus", "params": { "field": "element.name", "select_all": true } },
    { "app": "input.type", "params": { "text": "周阿婆" }, "note": "另一个要素已经叫这个名字" },
    { "app": "input.key", "params": { "keys": "enter" } },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/name": "沈知微微" }, "timeout_ms": 5000 }, "note": "被拒：名字放回" },
    { "app": "page.text", "contains": { "/head/alert": "周阿婆" } },
    { "app": "ui.screenshot", "png": "02-name-taken.png" },
    { "app": "ui.press", "params": { "label": "Close" }, "note": "关掉提示" },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/alert": null } } },

    { "app": "ui.focus", "params": { "field": "element.alias" } },
    { "app": "input.type", "params": { "text": "阿微" } },
    { "app": "input.key", "params": { "keys": "enter" }, "note": "回车加上别名，输入框清空" },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/alias": "" } } },
    { "app": "ui.find", "params": { "label": "Remove alias", "count": 2 } },
    { "app": "ui.press", "params": { "label": "Remove alias", "nth": 0 }, "note": "去掉第一个别名「知微」" },
    { "app": "ui.find", "params": { "label": "Remove alias", "count": 1 } },
    { "call": "element.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[id=${els.[name=沈知微].id}]/aliases": ["阿微"] } },

    { "app": "ui.focus", "params": { "field": "element.summary", "select_all": true } },
    { "app": "input.type", "params": { "text": "验收简介：修钟的人。" } },
    { "app": "input.key", "params": { "keys": "secondary-enter" }, "note": "简介是多行的：⌘↵ 离开" },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/focus": null } } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "call": "element.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[id=${els.[name=沈知微].id}]/summary": "验收简介：修钟的人。" } },

    { "app": "ui.press", "params": { "label": "Add field" }, "note": "新加一行，光标在键里" },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/focus": "field.3" } } },
    { "app": "input.type", "params": { "text": "籍贯" } },
    { "app": "ui.focus", "params": { "field": "element.field.value" } },
    { "app": "input.type", "params": { "text": "青梅镇" } },
    { "app": "ui.press", "params": { "role": "TextArea", "label": "沈知微微" }, "note": "点回正文：字段离开就存" },
    { "app": "ui.wait", "params": { "until": "time", "ms": 600 } },
    { "call": "element.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[id=${els.[name=沈知微].id}]/fields/3/key": "籍贯", "/[id=${els.[name=沈知微].id}]/fields/3/value": "青梅镇" } },
    { "app": "page.text", "expect": { "/head/name": "沈知微微", "/head/fields/3/key": "籍贯", "/head/summary": "验收简介：修钟的人。" } },
    { "app": "ui.screenshot", "png": "03-edited.png" },

    { "app": "nav.open", "params": { "target": "category:${els.[name=沈知微].category}" }, "note": "它的类目页" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "category:${els.[name=沈知微].category}" } } },
    { "app": "page.text", "save": "category" },
    { "app": "ui.find", "params": { "label": "沈知微微" }, "note": "要素清单里有改过名的它" },
    { "app": "ui.screenshot", "png": "04-category.png" },
    { "app": "app.quit", "expect": { "/quit": true } }
  ]
}
