{
  "about": "K4 G2 第二批：lite 层级页八项设置、有效值与来源、逐项还原、接收开关往返保留归属、住处与归属看板分节。",
  "steps": [
    {
      "seed": "lite"
    },
    {
      "call": "book.list",
      "input": {},
      "save": "books"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "roots"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "call": "entry.create",
      "input": {
        "book": "${books.0.id}",
        "parent": "${roots.0.id}",
        "template": "tpl-group",
        "title": "Synthetic level settings"
      },
      "save": "level"
    },
    {
      "call": "entry.create",
      "input": {
        "book": "${books.0.id}",
        "parent": "${level.id}",
        "template": "tpl-chapter",
        "title": "Synthetic resident"
      },
      "save": "resident"
    },
    {
      "call": "entry.update",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}",
        "overrides": {
          "accept": true
        }
      }
    },
    {
      "call": "membership.add",
      "input": {
        "book": "${books.0.id}",
        "host": "${level.id}",
        "member": "${entries.[template=tpl-chapter].id}"
      }
    },
    {
      "launch": {
        "env": {
          "DRIFTING_APPEARANCE": "light"
        },
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "book.open",
      "params": {
        "book": "${books.0.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "state": {
          "/book/version": 3
        }
      }
    },
    {
      "app": "action.dispatch",
      "params": {
        "name": "workspace::ToggleBottomTimeline"
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "entry:${level.id}"
      }
    },
    {
      "app": "ui.wait"
    },
    {
      "app": "state.get",
      "expect": {
        "/v3Page/sections/[id=settings]/registered": true
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Residents",
        "role": "Heading"
      }
    },
    {
      "app": "ui.screenshot",
      "png": "00-level-top.png"
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 1050,
        "y": 420,
        "dy": 250
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Assigned entries",
        "role": "Heading"
      },
      "save": "membersHeading20"
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 1050,
        "y": 420,
        "dy": 2000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Default template",
        "role": "Group",
        "count": 1
      }
    },
    {
      "app": "ui.find",
      "params": {
        "contains": "Template ·"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Off",
        "role": "Button",
        "within": {
          "label": "Automatic links",
          "role": "Group"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "On",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "On",
        "role": "Button",
        "within": {
          "label": "Automatic links",
          "role": "Group"
        },
        "timeout_ms": 15000
      },
      "note": "Wait for this value in the refreshed settings view before reading it or starting another guarded edit."
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/auto_link": true
      }
    },
    {
      "app": "ui.find",
      "params": {
        "contains": "Override · Synthetic level settings"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Restore Automatic links",
        "role": "Button"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Restore Automatic links",
        "role": "Button",
        "absent": true,
        "timeout_ms": 15000
      },
      "note": "Wait for the refreshed snapshot to remove this override before the next guarded edit."
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/auto_link": null
