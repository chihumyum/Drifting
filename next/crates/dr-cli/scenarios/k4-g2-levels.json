{
  "about": "K4 G2 第二批：lite 层级页的三项设置与两块上的开关、有效值与来源、逐项还原、接收开关往返保留归属、住处与归属看板分节。",
  "steps": [
    {
      "seed": "lite"
    },
    {
      "call": "book.list",
      "input": {},
      "save": "books"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "roots"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "call": "entry.create",
      "input": {
        "book": "${books.0.id}",
        "parent": "${roots.0.id}",
        "template": "tpl-group",
        "title": "Synthetic level settings"
      },
      "save": "level"
    },
    {
      "call": "entry.create",
      "input": {
        "book": "${books.0.id}",
        "parent": "${level.id}",
        "template": "tpl-chapter",
        "title": "Synthetic resident"
      },
      "save": "resident"
    },
    {
      "call": "entry.update",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}",
        "overrides": {
          "accept": true
        }
      }
    },
    {
      "call": "membership.add",
      "input": {
        "book": "${books.0.id}",
        "host": "${level.id}",
        "member": "${entries.[template=tpl-chapter].id}"
      }
    },
    {
      "launch": {
        "env": {
          "DRIFTING_APPEARANCE": "light"
        },
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      },
      "note": "The workspace tour comes up once on a device that has not seen it, 0.7 s after a book's workspace shows, its first bubble over the left column's Tab row and the rows under it (m24-sea.md 「导览」, kernel-v5 §15 item 50; on books of the current format since UP, 2026-11-17). This profile is fresh: the device is told it has seen the tour, as the other window scenarios do, so no bubble lies over what the steps below press."
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "book.open",
      "params": {
        "book": "${books.0.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "state": {
          "/book/version": 5
        }
      }
    },
    {
      "app": "action.dispatch",
      "params": {
        "name": "workspace::ToggleBottomTimeline"
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "entry:${level.id}"
      }
    },
    {
      "app": "ui.wait"
    },
    {
      "app": "state.get",
      "expect": {
        "/v3Page/sections/[id=settings]/registered": true
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Level",
        "role": "CheckBox"
      },
      "note": "「下面的条目」 is a block whose head is its 「层级」 switch (kernel-v5 §16 「条目页」, T1); its residents follow."
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Synthetic resident",
        "role": "Group",
        "count": 1
      }
    },
    {
      "app": "ui.screenshot",
      "png": "00-level-top.png"
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Automatic links",
        "role": "CheckBox"
      },
      "note": "「自动链接」 is a switch under the 「下面的条目」 block's head now (T1), with no source line or 「还原」: the switch writes the entry's own value either way."
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "autoOn"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/revision": "${autoOn.version}"
        }
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/auto_link": true
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Automatic links",
        "role": "CheckBox"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "autoOff"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/revision": "${autoOff.version}"
        }
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/auto_link": false
      }
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 1050,
        "y": 420,
        "dy": 250
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Accept entries from elsewhere",
        "role": "CheckBox"
      },
      "save": "membersHeading20",
      "note": "「挂在这里的条目」 is a block whose head is its 「收别处的条目」 switch."
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 1050,
        "y": 420,
        "dy": 2000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Default template",
        "role": "Group",
        "count": 1
      }
    },
    {
      "app": "ui.find",
      "params": {
        "contains": "Template ·"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "章",
        "role": "Button",
        "within": {
          "label": "Default template",
          "role": "Group"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "None",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "None",
        "role": "Button",
        "within": {
          "label": "Default template",
          "role": "Group"
        },
        "timeout_ms": 15000
      },
      "note": "Wait for this value in the refreshed settings view before reading it or starting another guarded edit."
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/below/settings/default_template": null
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Restore Default template",
        "role": "Button"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Restore Default template",
        "role": "Button",
        "absent": true,
        "timeout_ms": 15000
      },
      "note": "Wait for the refreshed snapshot to remove this override before the next guarded edit."
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/below/settings/default_template": "tpl-chapter"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Synthetic level settings",
        "role": "PopUpButton"
      },
      "note": "「新条目住在」 is a dropdown on the 「挂在这里的条目」 block (T1): its first choice is the entry itself, then every level; there is no source line or 「还原」."
    },
    {
      "app": "ui.press",
      "params": {
        "label": "${roots.0.title}",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "${roots.0.title}",
        "role": "PopUpButton",
        "timeout_ms": 15000
      },
      "note": "Wait for this value in the refreshed settings view before reading it or starting another guarded edit."
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/home": "${roots.0.id}"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "${roots.0.title}",
        "role": "PopUpButton"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Synthetic level settings",
        "role": "MenuItem",
        "nth": 0
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Synthetic level settings",
        "role": "PopUpButton",
        "timeout_ms": 15000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/home": null
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Plain text",
        "role": "Button",
        "within": {
          "label": "Formatting shortcuts",
          "role": "Group"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Full",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Full",
        "role": "Button",
        "within": {
          "label": "Formatting shortcuts",
          "role": "Group"
        },
        "timeout_ms": 15000
      },
      "note": "Wait for this value in the refreshed settings view before reading it or starting another guarded edit."
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/format_shortcuts": "full"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Restore Formatting shortcuts",
        "role": "Button"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Restore Formatting shortcuts",
        "role": "Button",
        "absent": true,
        "timeout_ms": 15000
      },
      "note": "Wait for the refreshed snapshot to remove this override before the next guarded edit."
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Accept entries from elsewhere",
        "role": "CheckBox"
      },
      "note": "「收别处的条目」 is the switch on the 「挂在这里的条目」 block's head (T1); turning it off asks nothing."
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "acceptOff"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/revision": "${acceptOff.version}"
        }
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/accept": false
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/below/members": null
      },
      "note": "With 「收别处的条目」 off the entry lists no members at all (BelowInfo.members is absent, kernel-v5 §16)."
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Accept entries from elsewhere",
        "role": "CheckBox"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "call": "entry_history.version",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "acceptOn"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/revision": "${acceptOn.version}"
        }
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/below/members/0/id": "${entries.[template=tpl-chapter].id}"
      }
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 1050,
        "y": 420,
        "dy": 2000
      },
      "note": "The members block opened again above the settings; bring them back into the window."
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "List",
        "role": "Button",
        "within": {
          "label": "Display",
          "role": "Group"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Grid",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Grid",
        "role": "Button",
        "within": {
          "label": "Display",
          "role": "Group"
        },
        "timeout_ms": 15000
      },
      "note": "Wait for this value in the refreshed settings view before reading it or starting another guarded edit."
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/display": "grid"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Grid",
        "role": "Button",
        "within": {
          "label": "Display",
          "role": "Group"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Islands",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Islands",
        "role": "Button",
        "within": {
          "label": "Display",
          "role": "Group"
        },
        "timeout_ms": 15000
      },
      "note": "Wait for this value in the refreshed settings view before reading it or starting another guarded edit."
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/display": "island"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Islands",
        "role": "Button",
        "within": {
          "label": "Display",
          "role": "Group"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Board",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Board",
        "role": "Button",
        "within": {
          "label": "Display",
          "role": "Group"
        },
        "timeout_ms": 15000
      },
      "note": "Wait for this value in the refreshed settings view before reading it or starting another guarded edit."
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${level.id}"
      },
      "expect": {
        "/overrides/display": "board"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Board",
        "role": "Button",
        "within": {
          "label": "Display",
          "role": "Group"
        }
      }
    },
    {
      "app": "ui.screenshot",
      "png": "01-level-settings.png"
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 1050,
        "y": 420,
        "dy": -2000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Level",
        "role": "CheckBox"
      }
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 1050,
        "y": 420,
        "dy": 500
      },
      "note": "The real description editor places this display lower than the placeholder did; bring the board into the window before testing its inner wheel."
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "app": "ui.find",
      "params": {
        "role": "Group",
        "label": "Entries",
        "count": 2
      },
      "save": "boardViewportBefore",
      "note": "Each block shows its own display (T1): the residents' board under 「下面的条目」 and the attached entries' board under 「挂在这里的条目」."
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Synthetic resident",
        "role": "Button",
        "count": 1
      }
    },
    {
      "app": "ui.screenshot",
      "png": "02-residents-board.png"
    },
    {
      "app": "input.scroll",
      "params": {
        "x": 800,
        "y": 420,
        "dy": 480
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 450
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Accept entries from elsewhere",
        "role": "CheckBox"
      },
      "save": "boardMembersHeading"
    },
    {
      "app": "ui.find",
      "params": {
        "label": "${entries.[template=tpl-chapter].title}",
        "count": 1
      },
      "save": "memberShown"
    },
    {
      "app": "ui.find",
      "params": {
        "role": "Group",
        "label": "Entries",
        "count": 2
      },
      "save": "boardViewportAfter"
    },
    {
      "app": "ui.screenshot",
      "png": "03-members-board.png"
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${entries.[template=tpl-chapter].id}"
      },
      "expect": {
        "/parent": "${entries.[template=tpl-chapter].parent}"
      }
    },
    {
      "app": "app.quit"
    }
  ]
}
