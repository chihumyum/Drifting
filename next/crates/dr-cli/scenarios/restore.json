{
  "about": "M41 整库备份与恢复：设置里搜「backup」，点「Export backup…」，应用要系统的保存面板时桥答上路径（面板的界面在系统服务里，点不到），写完说「Saved …」；备份以后改库（第一章开头打字、新建一本书）；再点「Choose backup…」，打开面板答那个备份，核对以后问「Replace and restore」，外壳关库、换库、重开，书架重新出现：改动没了，旧库存成恢复前副本；最后选一个不是备份的文件，说不是有效的备份，库不动。界面用英文。",
  "steps": [
    { "seed": "showcase" },
    { "call": "book.list", "save": "books" },
    { "call": "chapter.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "chapters" },
    { "call": "prose.read", "input": { "doc": "node:${chapters.0.id}" }, "save": "ch1" },

    { "launch": { "env": { "DRIFTING_APPEARANCE": "light" }, "settings": { "account": { "language.ui_locale": "en" } } }, "save": "app" },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "慢钟" } } },
    { "app": "library.info", "expect": { "/preRestore": [] } },

    { "app": "action.dispatch", "params": { "name": "app::OpenSettings" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": "settings" } } },
    { "app": "ui.focus", "params": { "field": "settings.search" } },
    { "app": "input.type", "params": { "text": "backup" } },
    { "app": "panel.answer", "params": { "path": "${app.out}/library.drifting" }, "note": "先替作者想好存到哪：下一个系统面板就答这个" },
    { "app": "ui.press", "params": { "role": "Button", "label": "Export backup…" }, "note": "设置关掉，应用要系统的保存面板，桥答上路径" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/transfer/state": "done", "/layer": null }, "timeout_ms": 60000 } },
    { "app": "panel.state", "expect": { "/last/kind": "save", "/last/answer": "${app.out}/library.drifting", "/armed": null, "/shown": false },
      "contains": { "/last/name": ".drifting" }, "note": "应用要的是保存面板，建议的文件名 Drifting-<日期>.drifting" },
    { "app": "state.get", "expect": { "/transfer/title": "Library backup" }, "contains": { "/transfer/text": "Saved “library.drifting”." } },
    { "app": "ui.screenshot", "png": "01-backup-done.png" },
    { "app": "ui.press", "params": { "role": "Button", "label": "Close" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/dialog": false } } },

    { "app": "nav.open", "params": { "chapter": "${chapters.0.id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "chapter:${chapters.0.id}", "/focus/editor": true } } },
    { "app": "input.type", "params": { "text": "备份之后。" }, "note": "备份以后的改动" },
    { "app": "ui.wait", "params": { "until": "time", "ms": 1500 } },
    { "call": "prose.read", "input": { "doc": "node:${chapters.0.id}" }, "expect": { "/paragraphs/0/text": "备份之后。${ch1.paragraphs.0.text}" } },
    { "call": "book.create", "input": { "name": "备份之后的书" }, "save": "later" },
    { "call": "book.get", "input": { "book": "${later.id}" }, "expect": { "/name": "备份之后的书" } },

    { "app": "action.dispatch", "params": { "name": "app::OpenSettings" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": "settings" } } },
    { "app": "ui.focus", "params": { "field": "settings.search", "select_all": true } },
    { "app": "input.type", "params": { "text": "backup" } },
    { "app": "panel.answer", "params": { "path": "${app.out}/library.drifting" } },
    { "app": "ui.press", "params": { "role": "Button", "label": "Choose backup…" }, "note": "打开面板选中刚才的备份" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/transfer/state": "confirm" }, "timeout_ms": 60000 }, "note": "先核对（库照常开着）" },
    { "app": "panel.state", "expect": { "/last/kind": "open", "/last/prompt": "Choose backup…", "/last/answer": "${app.out}/library.drifting" } },
    { "app": "state.get",
      "expect": { "/transfer/title": "Restore from backup", "/transfer/confirm": "Replace and restore" },
      "contains": { "/transfer/text": "Replace the current library with “library.drifting”." } },
    { "app": "state.get", "contains": { "/transfer/text": "慢钟" }, "note": "备份里有哪些书" },
    { "app": "ui.screenshot", "png": "02-restore-confirm.png" },
    { "app": "ui.press", "params": { "role": "Button", "label": "Replace and restore" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/dialog": false, "/library": true, "/shelf": true }, "timeout_ms": 60000 },
      "note": "外壳关库、换库、重开；窗口回到书架" },
    { "app": "ui.screenshot", "png": "03-restored-shelf.png" },

    { "call": "book.get", "input": { "book": "${later.id}" }, "expect_error": "not_found", "note": "备份以后新建的书没了" },
    { "call": "prose.read", "input": { "doc": "node:${chapters.0.id}" }, "expect": { "/paragraphs/0/text": "${ch1.paragraphs.0.text}" }, "note": "第一章回到备份时" },
    { "app": "library.info", "contains": { "/preRestore/0": "Drifting-pre-restore-" }, "note": "换掉的库先存成恢复前副本" },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "慢钟" } } },
    { "app": "nav.open", "params": { "chapter": "${chapters.0.id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "chapter:${chapters.0.id}" }, "page": { "/paragraphs/0/text": "${ch1.paragraphs.0.text}" } },
      "note": "换过的库里照常打开、读出" },

    { "app": "action.dispatch", "params": { "name": "app::OpenSettings" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": "settings" } } },
    { "app": "ui.focus", "params": { "field": "settings.search", "select_all": true } },
    { "app": "input.type", "params": { "text": "backup" } },
    { "app": "panel.answer", "params": { "path": "${app.log}" }, "note": "选一个不是备份的文件（应用自己的日志）" },
    { "app": "ui.press", "params": { "role": "Button", "label": "Choose backup…" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/transfer/state": "failed" }, "timeout_ms": 30000 } },
    { "app": "state.get", "expect": { "/transfer/reason": "settings.sync.backup.errors.invalid" },
      "contains": { "/transfer/text": "not a valid Drifting backup" } },
    { "app": "ui.screenshot", "png": "04-not-a-backup.png" },
    { "app": "ui.press", "params": { "role": "Button", "label": "Close" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/dialog": false } } },
    { "app": "library.info", "contains": { "/preRestore/0": "Drifting-pre-restore-" } },
    { "call": "prose.read", "input": { "doc": "node:${chapters.0.id}" }, "expect": { "/paragraphs/0/text": "${ch1.paragraphs.0.text}" }, "note": "库没动" },
    { "app": "app.quit", "expect": { "/quit": true } }
  ]
}
