{
  "about": "M16 构想面板：左栏换到「Ideas」；「New group」建出「新分组」，双击就地改名「结构」；分组卡片「New subgroup」建出子分组；构想卡片的「结构」把一条构想移进去；另一条点「Resting」休息（还在列表里）；排序菜单选「Title A-Z」；分组卡片「Delete group」：分组没了，里面的构想和子分组往上挪。每一步都经 F3 读回来核对。界面用英文。",
  "steps": [
    { "seed": "showcase" },
    { "call": "book.list", "save": "books" },
    { "call": "idea.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "ideas" },

    { "launch": { "env": { "DRIFTING_APPEARANCE": "light" }, "settings": { "account": { "language.ui_locale": "en" } } } },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "慢钟" } } },
    { "app": "action.dispatch", "params": { "name": "workspace::ToggleLeftSidebar" }, "note": "新 profile 的左栏是收着的" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/left/open": true } } },
    { "app": "ui.press", "params": { "label": "Ideas" }, "note": "左栏换到构想" },
    { "app": "ui.press", "params": { "label": "Skip tour" }, "note": "新 profile 的首次导览气泡盖着面板头" },
    { "app": "ui.find", "params": { "label": "New group" }, "note": "面板头是 M16 的" },
    { "app": "ui.find", "params": { "label": "时间是证词" } },
    { "app": "ui.screenshot", "png": "01-panel.png" },

    { "app": "ui.press", "params": { "label": "New group" } },
    { "app": "ui.find", "params": { "role": "Button", "label": "新分组" }, "save": "group" },
    { "call": "idea_group.list", "input": { "book": "${books.[name=慢钟].id}" }, "expect": { "/0/name": "新分组", "/0/parent": null } },
    { "app": "input.click", "params": { "x": "${group.nodes.0.center.0}", "y": "${group.nodes.0.center.1}", "count": 2 },
      "note": "双击分组头：就地改名，名字全选着" },
    { "app": "input.type", "params": { "text": "结构" } },
    { "app": "input.key", "params": { "keys": "enter" } },
    { "app": "ui.find", "params": { "role": "Button", "label": "结构" } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 400 } },
    { "call": "idea_group.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "groups", "expect": { "/0/name": "结构" } },

    { "app": "ui.hover", "params": { "role": "Button", "label": "结构" }, "note": "分组的卡片" },
    { "app": "ui.find", "params": { "role": "MenuItem", "label": "New subgroup", "timeout_ms": 6000 }, "note": "卡片停稳" },
    { "app": "ui.screenshot", "png": "02-group-card.png" },
    { "app": "ui.press", "params": { "role": "MenuItem", "label": "New subgroup" } },
    { "app": "ui.find", "params": { "role": "Button", "label": "新分组" } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 400 } },
    { "call": "idea_group.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[name=新分组]/parent": "${groups.[name=结构].id}" } },

    { "app": "ui.hover", "params": { "label": "时间是证词" }, "note": "构想的卡片：外壳的页面卡，带构想的几行" },
    { "app": "ui.find", "params": { "role": "MenuItem", "label": "结构", "count": 1 }, "note": "共享页面菜单只列一次移动目标，面板不再追加重复的行" },
    { "app": "ui.screenshot", "png": "03-idea-card.png" },
    { "app": "ui.press", "params": { "role": "MenuItem", "label": "结构" }, "note": "移动到分组：结构" },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "call": "idea.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[title=时间是证词]/group": "${groups.[name=结构].id}" } },

    { "app": "ui.hover", "params": { "label": "一张单子一个人" } },
    { "app": "ui.press", "params": { "role": "MenuItem", "label": "Resting" } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "call": "idea.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[title=一张单子一个人]/status": "resting" } },
    { "app": "ui.find", "params": { "label": "一张单子一个人" }, "note": "休息的构想还在原处，只是变淡" },

    { "app": "ui.press", "params": { "label": "Sort" } },
    { "app": "ui.press", "params": { "role": "MenuItem", "label": "Title A-Z" } },
    { "app": "ui.find", "params": { "role": "MenuItem", "label": "Title A-Z", "absent": true }, "note": "选完菜单收起" },
    { "app": "ui.screenshot", "png": "04-sorted.png" },

    { "app": "ui.hover", "params": { "role": "Button", "label": "结构" } },
    { "app": "ui.press", "params": { "role": "MenuItem", "label": "Delete group" } },
    { "app": "ui.find", "params": { "role": "Button", "label": "结构", "absent": true } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "call": "idea_group.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[name=结构]": null, "/[name=新分组]/parent": null } },
    { "call": "idea.list", "input": { "book": "${books.[name=慢钟].id}" },
      "expect": { "/[title=时间是证词]/group": null }, "note": "分组里的构想往上挪到顶层" },
    { "app": "ui.screenshot", "png": "05-after-delete.png" },
    { "app": "app.quit" }
  ]
}
