{
  "about": "设置：打开设置（⌘,）；主题选「深色」；编辑器字号加一档；搜索「width」只剩「页面宽度」；界面语言从 English 换成简体中文，按钮立刻变中文；关掉重开，这些都还在；Esc 关掉设置。值经桥读 dr-shell 的设置文件对。",
  "steps": [
    { "seed": "showcase" },
    { "launch": { "settings": { "account": { "language.ui_locale": "en", "appearance.theme": "light" } } } },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "慢钟" } } },
    { "app": "settings.get", "params": { "keys": ["appearance.theme", "editor.font_size", "language.ui_locale"] },
      "expect": { "/locale": "en", "/values/appearance.theme": "light", "/values/editor.font_size": 17.0 } },

    { "app": "action.dispatch", "params": { "name": "app::OpenSettings" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": "settings" } } },
    { "app": "ui.screenshot", "png": "01-settings.png" },
    { "app": "ui.press", "params": { "role": "RadioButton", "label": "Dark" } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 500 } },
    { "app": "settings.get", "params": { "keys": ["appearance.theme"] }, "expect": { "/values/appearance.theme": "dark" } },
    { "app": "app.info", "contains": { "/windows/0/appearance": "Dark" }, "note": "窗口跟着变深" },
    { "app": "ui.press", "params": { "role": "Slider", "label": "Font size", "via": "increment" }, "note": "字号滑杆加一档（无障碍的「增加」，和方向键一样）" },
    { "app": "ui.wait", "params": { "until": "time", "ms": 300 } },
    { "app": "settings.get", "params": { "keys": ["editor.font_size"] }, "expect": { "/values/editor.font_size": 18.0 } },
    { "app": "ui.find", "params": { "role": "Incrementor", "label": "Font size" }, "expect": { "/nodes/0/value": "18" }, "note": "旁边的数字跟着到 18" },

    { "app": "ui.focus", "params": { "field": "settings.search" }, "note": "点进搜索框（点过别的控件，键盘不在这里了）" },
    { "app": "input.type", "params": { "text": "width" } },
    { "app": "ui.find", "params": { "role": "Slider", "label": "Page width" }, "expect": { "/count": 1 } },
    { "app": "ui.find", "params": { "role": "Slider", "label": "Font size", "absent": true }, "note": "别的设置筛掉了" },
    { "app": "ui.screenshot", "png": "02-search.png" },
    { "app": "input.key", "params": { "keys": "escape" }, "note": "第一下 Esc 清空搜索" },
    { "app": "ui.find", "params": { "role": "Slider", "label": "Font size" }, "expect": { "/count": 1 } },

    { "app": "ui.focus", "params": { "field": "settings.search" } },
    { "app": "input.type", "params": { "text": "language" }, "note": "搜到「界面语言」一行" },
    { "app": "ui.press", "params": { "role": "PopUpButton", "label": "English" }, "note": "界面语言的下拉" },
    { "app": "ui.press", "params": { "role": "MenuItem", "label": "简体中文" } },
    { "app": "ui.wait", "params": { "until": "time", "ms": 400 } },
    { "app": "settings.get", "params": { "keys": ["language.ui_locale"] }, "expect": { "/locale": "zh-CN", "/values/language.ui_locale": "zh-CN" } },
    { "app": "ui.find", "params": { "role": "Button", "label": "关闭" }, "note": "按钮立刻变中文" },
    { "app": "ui.find", "params": { "role": "PopUpButton", "label": "简体中文" } },
    { "app": "ui.screenshot", "png": "03-chinese-dark.png" },
    { "app": "app.quit", "expect": { "/quit": true } },

    { "launch": {}, "note": "关掉重开" },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "settings.get", "params": { "keys": ["appearance.theme", "editor.font_size", "language.ui_locale"] },
      "expect": { "/locale": "zh-CN", "/values/appearance.theme": "dark", "/values/editor.font_size": 18.0 } },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false } } },
    { "app": "action.dispatch", "params": { "name": "app::OpenSettings" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": "settings" } } },
    { "app": "ui.find", "params": { "role": "Slider", "label": "字号" }, "expect": { "/nodes/0/value": "18" } },
    { "app": "input.key", "params": { "keys": "escape" }, "note": "Esc 关掉设置" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/layer": null } } },
    { "app": "app.quit", "expect": { "/quit": true } }
  ]
}
