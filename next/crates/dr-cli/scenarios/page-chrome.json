{
  "about": "M03 章首章末：从章首的标题框改标题、回车把光标交给正文；写梗概（⌘↵ 存）；Esc 放回原标题；⁂ 改回草稿、新建下一章（光标在新章标题里、标题选中），给新章起名、写第一句。界面用英文，写进去的都经 F3 读回来对。",
  "steps": [
    { "seed": "showcase" },
    { "call": "book.list", "save": "books" },
    { "call": "chapter.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "chapters" },
    { "call": "prose.read", "input": { "doc": "node:${chapters.0.id}" }, "save": "ch1" },

    { "launch": { "env": { "DRIFTING_APPEARANCE": "light" }, "settings": { "account": { "language.ui_locale": "en" } } } },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "app": "book.open", "params": { "name": "慢钟" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "慢钟" } } },
    { "app": "nav.open", "params": { "chapter": "${chapters.0.id}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "chapter:${chapters.0.id}", "/focus/editor": true } } },
    { "app": "page.text", "note": "章首：第 1 章、标题、梗概、状态",
      "expect": { "/head/title": "${chapters.0.title}", "/head/number": 1, "/head/status": "${chapters.0.status}", "/head/synopsis": "${chapters.0.summary}" } },
    { "app": "ui.screenshot", "png": "01-head.png" },

    { "app": "ui.focus", "params": { "field": "page.title", "select_all": true }, "note": "点进标题框，标题全选" },
    { "app": "input.type", "params": { "text": "停摆的钟" } },
    { "app": "input.key", "params": { "keys": "enter" }, "note": "回车：标题存下，光标交给正文开头" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/focus/editor": true, "/pageTitle": "停摆的钟" } } },
    { "app": "page.text", "expect": { "/head/title": "停摆的钟", "/head/focus": null, "/selection/head": 0 } },
    { "call": "chapter.list", "input": { "book": "${books.[name=慢钟].id}" }, "expect": { "/0/title": "停摆的钟" } },
    { "app": "input.type", "params": { "text": "章首验收。" }, "note": "回车之后直接打字，进的是正文第一段" },
    { "app": "page.text", "expect": { "/paragraphs/0/text": "章首验收。${ch1.paragraphs.0.text}" } },

    { "app": "ui.focus", "params": { "field": "page.synopsis", "select_all": true } },
    { "app": "input.type", "params": { "text": "验收梗概：钟停在三点。" } },
    { "app": "input.key", "params": { "keys": "secondary-enter" }, "note": "⌘↵ 离开梗概框，离开就存" },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/focus": null } } },
    { "app": "page.text", "expect": { "/head/synopsis": "验收梗概：钟停在三点。", "/head/focus": null } },
    { "call": "chapter.list", "input": { "book": "${books.[name=慢钟].id}" }, "expect": { "/0/summary": "验收梗概：钟停在三点。" } },

    { "app": "ui.focus", "params": { "field": "page.title" } },
    { "app": "input.type", "params": { "text": "多打的字" } },
    { "app": "input.key", "params": { "keys": "escape" }, "note": "Esc 把存着的标题放回去" },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/focus": null } } },
    { "app": "page.text", "expect": { "/head/title": "停摆的钟", "/head/focus": null } },
    { "app": "ui.screenshot", "png": "02-renamed.png" },

    { "app": "ui.press", "params": { "role": "TextArea", "label": "停摆的钟" }, "note": "点回正文" },
    { "app": "input.key", "params": { "keys": "secondary-down" }, "note": "光标到章末" },
    { "app": "ui.wait", "params": { "until": "time", "ms": 400 } },
    { "app": "input.scroll", "params": { "x": 720, "y": 450, "dy": 600 }, "note": "把 ⁂ 滚进窗口" },
    { "app": "ui.wait", "params": { "until": "time", "ms": 400 } },
    { "app": "ui.press", "params": { "contains": "Chapter end actions" }, "note": "点 ⁂：动作展开" },
    { "app": "ui.find", "params": { "label": "Back to draft" }, "expect": { "/count": 1 } },
    { "app": "ui.find", "params": { "label": "New chapter after" }, "expect": { "/count": 1 } },
    { "app": "ui.screenshot", "png": "03-end-actions.png" },
    { "app": "ui.press", "params": { "label": "Back to draft" } },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/status": "draft" }, "timeout_ms": 5000 } },
    { "app": "page.text", "expect": { "/head/status": "draft", "/head/finished": false } },
    { "call": "chapter.list", "input": { "book": "${books.[name=慢钟].id}" }, "expect": { "/0/status": "draft" } },

    { "app": "ui.press", "params": { "label": "New chapter after" }, "note": "新建下一章：建好、打开、光标在标题里且标题选中" },
    { "app": "ui.wait", "params": { "until": "ready", "page": { "/head/number": 2, "/head/focus": "title" }, "timeout_ms": 5000 } },
    { "app": "page.text", "save": "fresh", "expect": { "/head/number": 2, "/head/focus": "title", "/head/status": "draft" } },
    { "app": "input.type", "params": { "text": "新的一章" }, "note": "标题是选中的，打字就换掉它" },
    { "app": "input.key", "params": { "keys": "enter" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/focus/editor": true, "/pageTitle": "新的一章" } } },
    { "app": "input.type", "params": { "text": "新章第一句。" } },
    { "app": "page.text", "expect": { "/head/title": "新的一章", "/paragraphs/0/text": "新章第一句。" } },
    { "call": "chapter.list", "input": { "book": "${books.[name=慢钟].id}" }, "save": "after",
      "expect": { "/1/title": "新的一章", "/1/status": "draft", "/2/title": "${chapters.1.title}" } },
    { "call": "prose.read", "input": { "doc": "node:${after.1.id}" }, "expect": { "/paragraphs/0/text": "新章第一句。" } },
    { "app": "ui.screenshot", "png": "04-new-chapter.png" },
    { "app": "app.quit", "expect": { "/quit": true } }
  ]
}
