{
  "about": "G1 real mounted editor, versioned module URL, OS rich clipboard, global find, selected comment save, final accepted head write and fallible close checkpoint, guarded restore and reopen. Synthetic isolated secondary-window correctness flow; no heavy or visual/performance acceptance.",
  "steps": [
    {
      "seed": "v3-tiny"
    },
    {
      "call": "book.list",
      "save": "books"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "call": "entry_template.put_module",
      "input": {
        "book": "${books.0.id}",
        "template": "tpl-chapter",
        "module": {
          "id": "g1-wired",
          "kind": "prose",
          "name": "Wiring body",
          "pos": "a2"
        }
      }
    },
    {
      "call": "module.set_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "g1-wired",
        "paragraphs": [
          {
            "text": "G1 clipboard."
          }
        ]
      }
    },
    {
      "launch": {
        "env": {
          "DRIFTING_APPEARANCE": "light",
          "DRIFTING_WINDOW_DISPLAY": "secondary"
        },
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "app.info",
      "save": "environment",
      "expect": {
        "/windows/0/active": true,
        "/windows/0/visible": true
      }
    },
    {
      "app": "input.url",
      "params": {
        "url": "drifting-next-dev://open/${books.0.id}/entries/id-${entries.[template=tpl-chapter].id}/modules/id-g1-wired/prose.md#L1"
      },
      "expect": {
        "/accepted": 1
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000,
        "state": {
          "/book/id": "${books.0.id}",
          "/page": "entry:${entries.[template=tpl-chapter].id}/g1-wired",
          "/focus/editor": true
        },
        "page": {
          "/source": "editor",
          "/doc": "body:${entries.[template=tpl-chapter].id}/g1-wired",
          "/paragraphs/0/text": "G1 clipboard."
        }
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "Wired "
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-a"
      },
      "expect": {
        "/handled": true
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-c"
      },
      "expect": {
        "/handled": true
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "right"
      },
      "expect": {
        "/handled": true
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-v"
      },
      "expect": {
        "/handled": true
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000,
        "page": {
          "/doc": "body:${entries.[template=tpl-chapter].id}/g1-wired",
          "/paragraphs/0/text": "Wired G1 clipboard.Wired G1 clipboard."
        }
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "g1-wired"
      },
      "expect": {
        "/paragraphs/0/text": "Wired G1 clipboard.Wired G1 clipboard."
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-f"
      },
      "expect": {
        "/handled": true
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "G1"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "escape"
      },
      "expect": {
        "/handled": true
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000,
        "state": {
          "/focus/editor": true
        },
        "page": {
          "/doc": "body:${entries.[template=tpl-chapter].id}/g1-wired",
          "/selection/anchor": 6,
          "/selection/head": 8
        }
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-alt-m"
      },
      "expect": {
        "/handled": true
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000,
        "state": {
          "/composer": true
        }
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "G1 wiring comment"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-enter"
      },
      "expect": {
        "/handled": true
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000,
        "state": {
          "/composer": false
        }
      }
    },
    {
      "call": "comment.list",
      "input": {
        "book": "${books.0.id}"
      },
      "expect": {
        "/[body=G1 wiring comment]/module": "g1-wired",
        "/[body=G1 wiring comment]/quote": "G1",
        "/[body=G1 wiring comment]/target/id": "${entries.[template=tpl-chapter].id}"
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "entry:${entries.[template=tpl-chapter].id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000,
        "state": {
          "/page": "entry:${entries.[template=tpl-chapter].id}"
        }
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "entry:${entries.[template=tpl-chapter].id}/g1-wired"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000,
        "state": {
          "/page": "entry:${entries.[template=tpl-chapter].id}/g1-wired",
          "/focus/editor": true
        },
        "page": {
          "/source": "editor",
          "/doc": "body:${entries.[template=tpl-chapter].id}/g1-wired",
          "/paragraphs/0/text": "Wired G1 clipboard.Wired G1 clipboard."
        }
      }
    },
    {
      "app": "ui.focus",
      "params": {
        "field": "page.title",
        "select_all": true
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "G1 final title"
      }
    },
    {
      "app": "app.info",
      "save": "beforeQuit",
      "expect": {
        "/windows/0/active": true
      }
    },
    {
      "app": "app.quit"
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${entries.[template=tpl-chapter].id}"
      },
      "expect": {
        "/title": "G1 final title"
      }
    },
    {
      "call": "entry_snapshot.list",
      "input": {
        "book": "${books.0.id}",
        "entry": "${entries.[template=tpl-chapter].id}"
      },
      "save": "points"
    },
    {
      "call": "entry_snapshot.preview",
      "input": {
        "book": "${books.0.id}",
        "entry": "${entries.[template=tpl-chapter].id}",
        "point": "${points.0.id}"
      },
      "save": "closed",
      "expect": {
        "/entry/title": "G1 final title"
      },
      "contains": {
        "/bodies/[doc=body:${entries.[template=tpl-chapter].id}~1g1-wired]/text": "Wired G1 clipboard.Wired G1 clipboard."
      }
    },
    {
      "call": "module.set_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "g1-wired",
        "paragraphs": [
          {
            "text": "Later edit to restore"
          }
        ]
      }
    },
    {
      "call": "entry_snapshot.preview",
      "input": {
        "book": "${books.0.id}",
        "entry": "${entries.[template=tpl-chapter].id}",
        "point": "${closed.point.id}"
      },
      "save": "restoreView"
    },
    {
      "call": "entry_snapshot.restore",
      "input": {
        "book": "${books.0.id}",
        "entry": "${entries.[template=tpl-chapter].id}",
        "point": "${closed.point.id}",
        "expected": "${restoreView.expected}"
      }
    },
    {
      "launch": {
        "env": {
          "DRIFTING_APPEARANCE": "light",
          "DRIFTING_WINDOW_DISPLAY": "secondary"
        },
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "app.info",
      "save": "reopenEnvironment",
      "expect": {
        "/windows/0/active": true,
        "/windows/0/visible": true
      }
    },
    {
      "app": "input.url",
      "params": {
        "url": "drifting-next-dev://open/${books.0.id}/entries/id-${entries.[template=tpl-chapter].id}/modules/id-g1-wired/prose.md#L1"
      },
      "expect": {
        "/accepted": 1
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "timeout_ms": 30000,
        "state": {
          "/page": "entry:${entries.[template=tpl-chapter].id}/g1-wired",
          "/focus/editor": true
        },
        "page": {
          "/source": "editor",
          "/doc": "body:${entries.[template=tpl-chapter].id}/g1-wired",
          "/paragraphs/0/text": "Wired G1 clipboard.Wired G1 clipboard.",
          "/head/title": "G1 final title"
        }
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "g1-wired"
      },
      "expect": {
        "/paragraphs/0/text": "Wired G1 clipboard.Wired G1 clipboard."
      }
    },
    {
      "app": "app.quit"
    }
  ]
}
