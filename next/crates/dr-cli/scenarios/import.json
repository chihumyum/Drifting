{
  "about": "M10 导入旧库：一个合成的 Drifting 0.1 库（dr-import-v1 测试用的那份：一本《阿Q正传》）放在临时文件夹里，用 DRIFTING_APP_DATA_DIR 让它成为「这台设备上的 0.1 库」；新 profile 的库是空的。书架「导入」→ 列出找到的库 → 选它 → 导入 → 总结 → 书上了书架；打开它，第一章的正文、要素、TODO 都在。系统选文件夹面板点不到，走自动找到的那条路。界面用英文。",
  "steps": [
    { "legacy": "sample", "save": "old" },
    { "launch": { "env": { "DRIFTING_APPEARANCE": "light", "DRIFTING_APP_DATA_DIR": "${old.root}" },
                  "settings": { "account": { "language.ui_locale": "en" } } } },
    { "app": "ui.wait", "params": { "until": "ready", "timeout_ms": 30000 } },
    { "app": "window.focus" },
    { "call": "book.list", "expect": { "": [] }, "note": "新库是空的" },
    { "app": "state.get", "expect": { "/shelf": true } },
    { "app": "ui.screenshot", "png": "01-empty-shelf.png" },
    { "app": "ui.press", "params": { "role": "Button", "label": "Import" }, "note": "书架左栏的「导入 · Drifting 0.1」" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/dialog": true } } },
    { "app": "ui.find", "params": { "role": "Button", "label": "Choose folder" }, "note": "列出了找到的库，旁边是「选择文件夹」" },
    { "app": "ui.screenshot", "png": "02-found.png" },
    { "app": "ui.press", "params": { "role": "Button", "label": "Choose folder", "dx": -250, "dy": -48 },
      "note": "点找到的那一行（「选择文件夹」上面一行；这一行还不在无障碍树里）" },
    { "app": "ui.find", "params": { "role": "Button", "label": "Done" }, "note": "总结：一本书、字数、imported" },
    { "app": "ui.find", "params": { "role": "Button", "label": "Open “阿Q正传”" }, "note": "书架边读边多出这本书" },
    { "app": "ui.screenshot", "png": "03-done.png" },
    { "app": "ui.press", "params": { "role": "Button", "label": "Done" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/dialog": false, "/shelf": true } } },
    { "call": "book.list", "save": "books",
      "expect": { "/0/id": "${old.book}", "/0/name": "阿Q正传", "/0/summary": "一部小说", "/0/word_target": 80000 } },
    { "call": "chapter.list", "input": { "book": "${old.book}" }, "save": "chapters", "expect": { "/0/id": "${old.chapter}" } },
    { "call": "prose.read", "input": { "doc": "node:${old.chapter}" },
      "expect": { "/total": 5, "/paragraphs/0/heading": 1, "/paragraphs/0/text": "第一章 序", "/paragraphs/1/text": "我要给阿Q做正传，已经不止一两年了。",
                  "/paragraphs/4/text": "TODO: 查一查赵太爷的年纪" }, "note": "引用块的两段各自成段，H1 还是 H1" },
    { "call": "element.list", "input": { "book": "${old.book}" }, "expect": { "/[name=阿Q]/aliases": ["阿桂", "阿贵"] } },
    { "call": "comment.list", "input": { "book": "${old.book}" },
      "expect": { "/[body=这句好]/quote": "阿Q做正传", "/[body=这句好]/status": "resolved", "/[body=核对称呼]/kind": "todo",
                  "/[body=查一查赵太爷的年纪]/kind": "todo" } },

    { "app": "ui.press", "params": { "role": "Button", "label": "Open “阿Q正传”" }, "note": "点书卡打开" },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/shelf": false, "/book/name": "阿Q正传" } } },
    { "app": "nav.open", "params": { "target": "chapter:${old.chapter}" } },
    { "app": "ui.wait", "params": { "until": "ready", "state": { "/page": "chapter:${old.chapter}" } } },
    { "app": "page.text",
      "expect": { "/head/title": "第一章 序", "/head/synopsis": "梗概", "/head/status": "draft", "/paragraphs/1/text": "我要给阿Q做正传，已经不止一两年了。" } },
    { "app": "ui.screenshot", "png": "04-chapter.png" },
    { "app": "app.quit", "expect": { "/quit": true } }
  ]
}
