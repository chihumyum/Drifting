{
  "about": "F6 canonical v3 导航：Book/Material 目标、重排刷新保留标签与真实全书输入撤销、关开恢复。旧产品路由已退役；旧书拒开由切换验收覆盖。正文来自共享种子。",
  "steps": [
    {
      "seed": "lite"
    },
    {
      "call": "book.list",
      "save": "books"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "save": "original"
    },
    {
      "launch": {
        "env": {
          "DRIFTING_APPEARANCE": "light"
        },
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000
      }
    },
    {
      "app": "book.open",
      "params": {
        "book": "${books.0.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/book/version": 3,
          "/book/loaded": true
        }
      }
    },
    {
      "app": "window.focus"
    },
    {
      "app": "state.get",
      "save": "loaded"
    },
    {
      "app": "nav.open",
      "params": {
        "target": "entry:${entries.[template=tpl-chapter].id}/mod-prose"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "entry:${entries.[template=tpl-chapter].id}/mod-prose"
        }
      }
    },
    {
      "app": "nav.open",
      "expect": {
        "/opened": "material:${loaded.v3.materials.[kind=text].id}"
      },
      "params": {
        "target": "material:${loaded.v3.materials.[kind=text].id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "material:${loaded.v3.materials.[kind=text].id}"
        }
      }
    },
    {
      "app": "nav.open",
      "expect_error": "not_found",
      "params": {
        "target": "material:missing-material"
      }
    },
    {
      "app": "nav.open",
      "expect_error": "bad_request",
      "params": {
        "target": "chapter:${entries.[template=tpl-chapter].id}"
      },
      "note": "chapter:<id> is no longer a page key at all: it is refused as a bad request, not looked up."
    },
    {
      "app": "nav.open",
      "expect": {
        "/opened": "book:${entries.[template=tpl-manuscript].id}"
      },
      "params": {
        "target": "book:${entries.[template=tpl-manuscript].id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "book:${entries.[template=tpl-manuscript].id}"
        }
      }
    },
    {
      "app": "ui.find",
      "params": {
        "role": "TextArea",
        "count": 1,
        "timeout_ms": 15000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 1200
      }
    },
    {
      "app": "ui.screenshot",
      "png": "01-whole-book-before.png"
    },
    {
      "call": "entry.move",
      "input": {
        "book": "${books.0.id}",
        "id": "${entries.[template=tpl-chapter].id}",
        "parent": "${entries.[template=tpl-chapter].parent}",
        "index": 1
      }
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "reordered"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/entries": "${reordered}",
          "/page": "book:${entries.[template=tpl-manuscript].id}"
        }
      }
    },
    {
      "app": "state.get",
      "expect": {
        "/tabs/[key=book:${entries.[template=tpl-manuscript].id}]/leaves/0/target": "book:${entries.[template=tpl-manuscript].id}",
        "/pages/[key=book:${entries.[template=tpl-manuscript].id}]/ready": true,
        "/tabs/[key=material:${loaded.v3.materials.[kind=text].id}]/leaves/0/target": "material:${loaded.v3.materials.[kind=text].id}"
      },
      "note": "重排已进入外壳快照，全书及素材标签仍保留"
    },
    {
      "app": "ui.find",
      "params": {
        "role": "TextArea",
        "count": 1,
        "timeout_ms": 15000
      }
    },
    {
      "app": "ui.screenshot",
      "png": "02-whole-book-reordered.png"
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${reordered.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "save": "firstAfterMove"
    },
    {
      "app": "window.focus"
    },
    {
      "app": "app.info",
      "save": "typingEnvironment",
      "expect": {
        "/windows/0/active": true,
        "/windows/0/visible": true
      }
    },
    {
      "app": "ui.press",
      "params": {
        "role": "TextArea",
        "label": "${entries.[template=tpl-chapter].title}"
      },
      "note": "重排保留原章节的阅读位置；在当前篇开头输入，不强迫跳到全书第一篇"
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-up"
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "F6Reordered "
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "expect": {
        "/paragraphs/0/text": "F6Reordered ${original.paragraphs.0.text}"
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${reordered.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "expect": {
        "/paragraphs": "${firstAfterMove.paragraphs}"
      },
      "note": "另一篇未被输入或重排覆盖"
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-z"
      }
    },
    {
      "call": "module.read_prose",
      "input": {
        "book": "${books.0.id}",
        "owner": "${entries.[template=tpl-chapter].id}",
        "module": "mod-prose"
      },
      "expect": {
        "/paragraphs": "${original.paragraphs}"
      }
    },
    {
      "call": "book.update",
      "input": {
        "book": "${books.0.id}",
        "name": "Synthetic v3 refreshed"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/book/name": "Synthetic v3 refreshed",
          "/page": "book:${entries.[template=tpl-manuscript].id}"
        }
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "material:${loaded.v3.materials.[kind=text].id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "material:${loaded.v3.materials.[kind=text].id}"
        }
      }
    },
    {
      "call": "book.update",
      "input": {
        "book": "${books.0.id}",
        "name": "Synthetic v3 material refreshed"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/book/name": "Synthetic v3 material refreshed",
          "/page": "material:${loaded.v3.materials.[kind=text].id}"
        }
      }
    },
    {
      "app": "state.get",
      "expect": {
        "/pageTitle": "${loaded.v3.materials.[kind=text].title}",
        "/tabs/[key=book:${entries.[template=tpl-manuscript].id}]/leaves/0/target": "book:${entries.[template=tpl-manuscript].id}",
        "/pages/[key=book:${entries.[template=tpl-manuscript].id}]/ready": true
      }
    },
    {
      "app": "app.quit"
    },
    {
      "launch": {
        "env": {
          "DRIFTING_APPEARANCE": "light"
        },
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000
      }
    },
    {
      "app": "book.open",
      "params": {
        "book": "${books.0.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/book/version": 3,
          "/page": "material:${loaded.v3.materials.[kind=text].id}"
        }
      }
    },
    {
      "app": "nav.open",
      "expect": {
        "/opened": "book:${entries.[template=tpl-manuscript].id}"
      },
      "params": {
        "target": "book:${entries.[template=tpl-manuscript].id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/page": "book:${entries.[template=tpl-manuscript].id}"
        }
      }
    },
    {
      "app": "ui.find",
      "params": {
        "role": "TextArea",
        "count": 1,
        "timeout_ms": 15000
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 1200
      }
    },
    {
      "app": "ui.screenshot",
      "png": "03-whole-book-reopened.png"
    },
    {
      "app": "app.quit"
    }
  ]
}
