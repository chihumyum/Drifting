{
  "about": "G4 v3-lite 主流程：主页保存书名，打开素材笔记，在原文选区新建批注并读回持久记录。仅副屏隔离 profile；无 heavy 或截图验收。",
  "steps": [
    {
      "seed": "lite"
    },
    {
      "call": "book.list",
      "save": "books"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "call": "comment.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "seed_comments"
    },
    {
      "call": "prose.read",
      "input": {
        "doc": "body:${entries.[template=tpl-note].id}/mod-prose",
        "limit": 1
      },
      "save": "sample"
    },
    {
      "call": "entry.create",
      "input": {
        "book": "${books.0.id}",
        "template": "tpl-note",
        "parent": "${entries.[template=tpl-note].parent}",
        "title": "G4 synthetic note",
        "bodies": {
          "mod-prose": "${sample.paragraphs.0.text}"
        }
      },
      "save": "note",
      "note": "Text materials are ordinary 笔记 entries now (kernel-v5 §6); the lite seed keeps imported ones under its 「文本素材」 group. entry.create takes a body as text."
    },
    {
      "launch": {
        "book": "${books.0.id}",
        "env": {
          "DRIFTING_APPEARANCE": "light",
          "DRIFTING_WINDOW_DISPLAY": "secondary"
        },
        "settings": {
          "account": {
            "language.ui_locale": "en"
          },
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          }
        }
      },
      "save": "app"
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/book/version": 5,
          "/book/loaded": true
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "app.info",
      "save": "environment"
    },
    {
      "app": "action.dispatch",
      "params": {
        "name": "workspace::ShowProjectHome"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "${books.0.name}"
      },
      "note": "T2: the project's name is edited in place on Project Home (the Settings dialog is gone)"
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-a"
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "G4 synthetic book"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "enter"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/book/name": "G4 synthetic book",
          "/dialog": false
        },
        "timeout_ms": 30000
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "escape"
      },
      "note": "Enter moved into the summary (T2); Esc leaves it so the page opened next takes the keyboard"
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/focus/workspace": true,
          "/dialog": false
        },
        "timeout_ms": 30000
      }
    },
    {
      "call": "book.get",
      "input": {
        "book": "${books.0.id}"
      },
      "expect": {
        "/name": "G4 synthetic book"
      }
    },
    {
      "app": "nav.open",
      "params": {
        "target": "entry:${note.id}/mod-prose"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 800
      }
    },
    {
      "app": "page.text",
      "save": "source"
    },
    {
      "app": "input.key",
      "params": {
        "keys": "secondary-up"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "shift-right",
        "times": 4
      }
    },
    {
      "app": "action.dispatch",
      "params": {
        "name": "review::NewComment"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/composer": true
        },
        "timeout_ms": 5000
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "${seed_comments.0.body.text}"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "role": "Button",
        "label": "Save"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "ready",
        "state": {
          "/composer": false
        },
        "timeout_ms": 15000
      }
    },
    {
      "call": "comment.list",
      "input": {
        "book": "${books.0.id}",
        "target": {
          "kind": "entry",
          "id": "${note.id}"
        },
        "module": "mod-prose"
      },
      "save": "comments",
      "expect": {
        "/0/body/text": "${seed_comments.0.body.text}",
        "/0/anchored": true,
        "/0/target/kind": "entry",
        "/0/target/id": "${note.id}",
        "/1": null
      }
    },
    {
      "app": "app.info",
      "save": "final_environment"
    }
  ]
}
