{
  "about": "K4 G3 第一交回：v3-lite 真窗口视图与泳道，保留 v2.2 路径。；v3 切换后保留全部 canonical 验收步骤，旧产品回切尾段已退役。",
  "steps": [
    {
      "seed": "v3-lite"
    },
    {
      "call": "book.list",
      "save": "books"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "views"
    },
    {
      "call": "membership.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "memberships"
    },
    {
      "launch": {
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000
      }
    },
    {
      "app": "book.open",
      "params": {
        "book": "${books.0.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/book/version": 3,
          "/bottom/pane": "timeline"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "New view",
        "role": "Button"
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "Synthetic G3 view"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "enter"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Synthetic G3 view",
        "role": "Button",
        "count": 1
      },
      "note": "G3 视图新建：真实输入提交，等待快照回到视图选择器。"
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Add lane",
        "role": "Button"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "${entries.[template=tpl-storyline].title}",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "${entries.[template=tpl-storyline].title}"
      }
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "one"
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/timeline_views": "${one}"
        }
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${views.0.lanes.1.entry}"
      },
      "save": "second"
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Add lane",
        "role": "Button"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "${second.title}",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Move up",
        "role": "Button",
        "count": 1
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Move up",
        "role": "Button"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 300
      }
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "ordered",
      "expect": {
        "/1/lanes/0/entry": "${second.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/timeline_views": "${ordered}"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Synthetic G3 view",
        "role": "Button"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Rename view",
        "role": "MenuItem"
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "Synthetic G3 renamed"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "enter"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Synthetic G3 renamed",
        "role": "Button",
        "count": 1
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Remove from view",
        "role": "Button",
        "nth": 0
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "Remove from view",
        "role": "Button",
        "count": 1
      },
      "note": "G3 泳道加进、排序、拿出；写入与读回由契约核对，窗口确认最终只有一条泳道。"
    },
    {
      "call": "membership.list",
      "input": {
        "book": "${books.0.id}"
      },
      "expect": {
        "": "${memberships}"
      }
    },
    {
      "app": "ui.screenshot",
      "png": "01-views-lanes.png"
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Synthetic G3 renamed",
        "role": "Button"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Delete view",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.find",
      "params": {
        "label": "${views.0.name}",
        "role": "Button",
        "count": 1
      }
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "expect": {
        "/0": "${views.0}"
      },
      "note": "删掉独立视图，原视图及其中摆放、时间钉逐值保持。"
    },
    {
      "app": "app.quit"
    }
  ]
}
