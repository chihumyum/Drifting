{
  "about": "K4 G3 局部编辑：隐藏绑定保留；视图改名、泳道增删排序；显示版本拒写、失败草稿与显式重试。副屏隔离主流程，不做截图或性能验收。",
  "steps": [
    {
      "seed": "v3-lite"
    },
    {
      "call": "book.list",
      "input": {},
      "save": "books"
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "views"
    },
    {
      "call": "entry.create",
      "input": {
        "book": "${books.0.id}",
        "parent": "${views.0.lanes.0.entry}",
        "template": "tpl-chapter",
        "title": "Synthetic pin-only target"
      },
      "save": "target"
    },
    {
      "call": "timeline_view.put_pin",
      "input": {
        "book": "${books.0.id}",
        "view": "${views.0.id}",
        "pin": {
          "id": "synthetic-hidden-binding",
          "at": 42.0,
          "label": "Synthetic recoverable pin",
          "color": "#345678",
          "entry": "${target.id}"
        }
      }
    },
    {
      "call": "entry.trash",
      "input": {
        "book": "${books.0.id}",
        "id": "${target.id}"
      }
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "hidden"
    },
    {
      "call": "entry.list",
      "input": {
        "book": "${books.0.id}",
        "all": true
      },
      "save": "entries"
    },
    {
      "call": "entry.create",
      "input": {
        "book": "${books.0.id}",
        "parent": "${entries.[template=tpl-manuscript].id}",
        "template": "tpl-chapter",
        "title": "Synthetic tree drag chapter"
      },
      "save": "created"
    },
    {
      "call": "entry.move",
      "input": {
        "book": "${books.0.id}",
        "id": "${created.id}",
        "parent": "${entries.[template=tpl-manuscript].id}",
        "index": 0
      }
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${created.id}"
      },
      "save": "source"
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${views.0.lanes.0.entry}"
      },
      "save": "first"
    },
    {
      "call": "entry.get",
      "input": {
        "book": "${books.0.id}",
        "id": "${views.0.lanes.1.entry}"
      },
      "save": "second"
    },
    {
      "call": "membership.list",
      "input": {
        "book": "${books.0.id}"
      },
      "save": "memberships"
    },
    {
      "launch": {
        "settings": {
          "device": {
            "modules": {
              "first_run.done": true,
              "guides.seen": [
                "workspace-tour"
              ]
            }
          },
          "account": {
            "language.ui_locale": "en"
          }
        },
        "env": {
          "DRIFTING_WINDOW_DISPLAY": "secondary"
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000
      }
    },
    {
      "app": "book.open",
      "params": {
        "book": "${books.0.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/book/version": 3,
          "/bottom/pane": "timeline"
        }
      }
    },
    {
      "app": "window.focus",
      "params": {}
    },
    {
      "app": "app.info",
      "params": {},
      "expect": {
        "/windows/0/active": true,
        "/windows/0/visible": true
      },
      "save": "environment"
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Move down",
        "role": "Button"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/timeline_views/0/lanes/0/entry": "${second.id}"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Remove from view",
        "role": "Button",
        "nth": 0
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/timeline_views/0/lanes/0/entry": "${first.id}"
        }
      }
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "expect": {
        "/0/lanes/1": null,
        "/0/pins/[id=synthetic-hidden-binding]/entry": null,
        "/0/pins/[id=synthetic-hidden-binding]/at": 42.0,
        "/0/pins/[id=synthetic-hidden-binding]/color": "#345678"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Add lane",
        "role": "Button"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "${second.title}",
        "role": "MenuItem"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/timeline_views/0/lanes/1/entry": "${second.id}"
        }
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "${views.0.name}",
        "role": "Button"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Rename view",
        "role": "MenuItem"
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "Synthetic local view"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "enter"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/timeline_views/0/name": "Synthetic local view"
        }
      }
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "expect": {
        "/0/name": "Synthetic local view",
        "/0/pins/[id=synthetic-hidden-binding]/entry": null
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Synthetic local view",
        "role": "Button"
      }
    },
    {
      "app": "ui.press",
      "params": {
        "label": "Rename view",
        "role": "MenuItem"
      }
    },
    {
      "app": "input.type",
      "params": {
        "text": "Synthetic retained view draft"
      }
    },
    {
      "call": "timeline_view.put_pin",
      "input": {
        "book": "${books.0.id}",
        "view": "${views.0.id}",
        "pin": {
          "id": "synthetic-peer-pin",
          "at": 84.0,
          "label": "Synthetic peer pin",
          "color": "#abcdef",
          "entry": null
        }
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/timeline_views/0/pins/2/label": "Synthetic peer pin"
        }
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "enter"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "until": "time",
        "ms": 350
      },
      "note": "等待失败回执绘制；下面同时核对旧写拒绝、原草稿和另一来源的成功写入。"
    },
    {
      "app": "ui.find",
      "params": {
        "contains": "Synthetic retained view draft",
        "role": "Group",
        "count": 1
      },
      "save": "viewDraft"
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "expect": {
        "/0/name": "Synthetic local view",
        "/0/pins/[id=synthetic-peer-pin]/label": "Synthetic peer pin",
        "/0/pins/[id=synthetic-hidden-binding]/entry": null
      }
    },
    {
      "call": "entry.restore",
      "input": {
        "book": "${books.0.id}",
        "id": "${target.id}"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/timeline_views/0/pins/1/entry": "${target.id}"
        }
      }
    },
    {
      "app": "ui.find",
      "params": {
        "contains": "Synthetic retained view draft",
        "role": "Group",
        "count": 1
      },
      "save": "viewDraft"
    },
    {
      "app": "input.click",
      "params": {
        "x": "${viewDraft.nodes.0.center.0}",
        "y": "${viewDraft.nodes.0.center.1}"
      }
    },
    {
      "app": "input.key",
      "params": {
        "keys": "enter"
      }
    },
    {
      "app": "ui.wait",
      "params": {
        "timeout_ms": 30000,
        "state": {
          "/v3/timeline_views/0/name": "Synthetic retained view draft"
        }
      }
    },
    {
      "call": "timeline_view.list",
      "input": {
        "book": "${books.0.id}"
      },
      "expect": {
        "/0/name": "Synthetic retained view draft",
        "/0/pins/[id=synthetic-hidden-binding]/entry": "${target.id}",
        "/0/pins/[id=synthetic-hidden-binding]/color": "#345678",
        "/0/pins/[id=synthetic-hidden-binding]/at": 42.0,
        "/0/pins/[id=synthetic-peer-pin]/label": "Synthetic peer pin",
        "/0/pins/[id=synthetic-peer-pin]/color": "#abcdef",
        "/0/pins/[id=synthetic-peer-pin]/at": 84.0
      }
    },
    {
      "call": "membership.list",
      "input": {
        "book": "${books.0.id}"
      },
      "expect": {
        "": "${memberships}"
      }
    },
    {
      "app": "app.info",
      "params": {},
      "expect": {
        "/windows/0/active": true,
        "/windows/0/visible": true
      }
    },
    {
      "app": "app.quit",
      "params": {}
    }
  ]
}
