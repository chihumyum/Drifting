  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "$defs": {
        "Definition": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "$ref": "#/$defs/LinkedTextIn",
              "default": ""
            },
            "direction": {
              "$ref": "#/$defs/RelationDirection",
              "default": "directed"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "EntryTextLink": {
          "additionalProperties": false,
          "description": "One entry link, using half-open Unicode scalar offsets in the accompanying text.",
          "properties": {
            "end": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "entry": {
              "type": "string"
            },
            "manual": {
              "description": "Picked with @: it shows whatever the switches of automatic linking\nsay (`kernel-v5.md` §16). A link without it is automatic: it reads as\nordinary text while its entry's 「自动链接」 is off.",
              "type": "boolean"
            },
            "start": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "start",
            "end",
            "entry"
          ],
          "type": "object"
        },
        "LinkedText": {
          "additionalProperties": false,
          "description": "Text with ordered, non-overlapping entry links. The saved spelling is the\nfallback when an entry cannot be resolved.",
          "properties": {
            "links": {
              "default": [],
              "items": {
                "$ref": "#/$defs/EntryTextLink"
              },
              "type": "array"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        "LinkedTextIn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LinkedText"
            }
          ],
          "description": "Commands accept plain text or text with explicit entry links. Replacing\na stored text, plain text keeps the links on the spans it leaves\nunchanged, while text with links states its visible links itself (one\nleft out comes off). A link to an entry in Recently Deleted on an\nunchanged span is always kept, and comes back with the entry."
        },
        "RelationDirection": {
          "description": "A relation's direction applies to all its rows. Switching it never moves a member.",
          "enum": [
            "directed",
            "symmetric"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "book": {
          "type": "string"
        },
        "left": {
          "description": "The left live entry's ID.",
          "type": "string"
        },
        "new_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Definition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Create the relation and the pair in the same edit."
        },
        "relation_type": {
          "default": null,
          "description": "An existing relation type. Supply exactly one of this and `new_type`.",
          "type": [
            "string",
            "null"
          ]
        },
        "right": {
          "description": "The right live entry's ID.",
          "type": "string"
        }
      },
      "required": [
        "book",
        "left",
        "right"
      ],
      "title": "PairIn",
      "type": "object"
    },
    "kind": "command",
    "name": "relation_row.create_pair",
    "output": {
      "properties": {
        "existing": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "relation_type": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "relation_type",
        "existing"
      ],
      "title": "Placed",
      "type": "object"
    },
    "summary": "Relate two distinct live entries. Reuse a matching row or start a new one. Return the row ID, with no write if the pair already exists."
  },
