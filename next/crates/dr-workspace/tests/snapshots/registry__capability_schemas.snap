          "minimum": 0,
          "type": "integer"
        },
        "block_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "at",
        "block_id"
      ],
      "title": "Replaced",
      "type": "object"
    },
    "summary": "Replace one exact passage of prose with new text (it must occur exactly once, in one paragraph)."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
