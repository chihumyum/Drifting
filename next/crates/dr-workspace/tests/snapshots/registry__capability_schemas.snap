  {
    "access": "write",
    "book_version": 4,
    "concurrency": "book",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "level": {
          "description": "The switch (`层级`): whether entries can live under this one.",
          "type": "boolean"
        }
      },
      "required": [
        "book",
        "id",
        "level"
      ],
      "title": "SetLevelIn",
      "type": "object"
    },
    "kind": "command",
    "name": "entry.set_level",
    "output": {
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "type": "boolean"
        },
        "moved": {
          "description": "The direct children moved to the root when the switch went off, in\ntheir order (trashed ones included).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "level",
        "moved"
      ],
      "title": "SetLevelOut",
      "type": "object"
    },
    "summary": "Turn an entry's switch for what lives below it on or off. Turning it off moves its direct children (trashed ones included) to the root right after the top-level entry it lives under, each with its subtree, in one commit that one undo reverts; its settings, memberships and swimlane are kept and come back when it is turned on."
  },
  {
    "access": "write",
