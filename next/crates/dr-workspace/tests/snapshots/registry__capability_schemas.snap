              },
              "type": "array"
            },
            "doc": {
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/Target",
              "description": "What the links point at (`element`, `node`, `storyline`, `category`,\n`material`)."
            }
          },
          "required": [
            "doc",
            "target",
            "anchors"
          ],
          "type": "object"
        },
        "Target": {
          "description": "A reference to an entity (relation end, comment or memory target).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "description": "`node`, `element`, `patch`, `category`, `storyline`, `comment`,\n`material`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "properties": {
        "links": {
          "description": "Any number of documents and targets: each document is written once.",
          "items": {
            "$ref": "#/$defs/LinkIn"
          },
          "type": "array"
        }
      },
      "required": [
        "links"
      ],
      "title": "LinksIn",
      "type": "object"
    },
    "kind": "command",
    "name": "prose.unlink",
    "output": {
      "properties": {
        "docs": {
          "description": "Documents written.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "ranges": {
          "description": "Ranges whose link changed (an anchor whose text is gone counts for\nnothing).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ranges",
        "docs"
      ],
      "title": "LinksChanged",
      "type": "object"
    },
    "summary": "Take links to entities off anchored ranges of prose documents (anchors, not positions: the undo of automatic links)."
  },
