  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "$defs": {
        "AnchorBytes": {
          "description": "A comment's anchor as stored: the two Loro cursors dr-doc writes\n(`Cursor::encode()`, the start on the first anchored character, the end\non the last), each in base64 (standard alphabet, padded). The editor\nmoves these bytes between the book and the prose document unchanged.",
          "properties": {
            "end": {
              "type": "string"
            },
            "start": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        "LinkIn": {
          "description": "Links to one entity on anchored ranges of one prose document.",
          "properties": {
            "anchors": {
              "description": "The ranges, as anchors (two cursors each, as comments keep them), so\ntyping since moves nothing.",
              "items": {
                "$ref": "#/$defs/AnchorBytes"
              },
              "type": "array"
            },
            "doc": {
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/Target",
              "description": "What the links point at (`element`, `node`, `storyline`, `category`,\n`material`)."
            }
          },
          "required": [
            "doc",
            "target",
            "anchors"
          ],
          "type": "object"
        },
        "Target": {
          "description": "A reference to an entity (relation end, comment or memory target).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "description": "`node`, `element`, `patch`, `category`, `storyline`, `comment`,\n`material`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "properties": {
        "links": {
          "description": "Any number of documents and targets: each document is written once.",
          "items": {
            "$ref": "#/$defs/LinkIn"
          },
          "type": "array"
        }
      },
      "required": [
        "links"
      ],
      "title": "LinksIn",
      "type": "object"
    },
    "kind": "command",
    "name": "prose.link",
    "output": {
      "properties": {
        "docs": {
          "description": "Documents written.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "ranges": {
          "description": "Ranges whose link changed (an anchor whose text is gone counts for\nnothing).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ranges",
        "docs"
      ],
      "title": "LinksChanged",
      "type": "object"
    },
    "summary": "Link anchored ranges of prose documents to entities (anchors, not positions: the undo of automatic links that were taken off)."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
        "doc": {
          "description": "The prose document: `node:<id>`, `element:<id>`, `storyline:<id>`,\n`category:<id>` or `material:<id>`.",
          "type": "string"
        },
        "from": {
          "default": 0,
          "description": "First paragraph (0-based).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "limit": {
          "description": "At most this many paragraphs (default 200).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "doc"
      ],
      "title": "ProseReadIn",
      "type": "object"
    },
    "kind": "query",
    "name": "prose.read",
    "output": {
      "$defs": {
        "ParagraphInfo": {
          "properties": {
            "block_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "heading": {
              "description": "0 for body text, 1–3 for H1–H3.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "index",
            "block_id",
            "heading",
            "text"
          ],
          "type": "object"
        }
      },
      "properties": {
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/ParagraphInfo"
          },
          "type": "array"
        },
        "total": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "The document's version (hex frontiers).",
          "type": "string"
        }
      },
      "required": [
        "paragraphs",
        "total",
        "version"
      ],
      "title": "ProseText",
      "type": "object"
    },
    "summary": "Read paragraphs of a prose document (text, block id, heading level)."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "block_id": {
          "description": "Look only in this paragraph.",
          "type": [
            "string",
            "null"
          ]
        },
        "doc": {
          "type": "string"
        },
        "find": {
          "description": "The exact current text to replace (within one paragraph).",
          "type": "string"
        },
        "replace": {
          "description": "The new text (no paragraph breaks).",
          "type": "string"
        }
      },
      "required": [
        "doc",
        "find",
        "replace"
      ],
      "title": "ProseReplaceIn",
      "type": "object"
    },
    "kind": "command",
    "name": "prose.replace",
    "output": {
      "properties": {
        "at": {
          "description": "Character offset of the replacement in the document.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "block_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "linked": {
          "description": "Entity links written on names inside the new text (automatic links\nfor an Agent's, the mirror's or an import's text, when the author has\nthem on).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at",
        "block_id",
        "linked"
      ],
      "title": "Replaced",
      "type": "object"
    },
    "summary": "Replace one exact passage of prose with new text (it must occur exactly once, in one paragraph)."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "at": {
          "description": "The version to go back to (hex frontiers, from history).",
          "type": "string"
        },
        "doc": {
          "type": "string"
        }
      },
      "required": [
        "doc",
        "at"
      ],
      "title": "ProseRestoreIn",
      "type": "object"
    },
    "kind": "command",
    "name": "prose.restore",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Restore a prose document to an earlier version, as a new change (history stays)."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
        "doc": {
          "description": "`node:<id>`, `material:<id>`, …",
          "type": "string"
        }
      },
      "required": [
        "doc"
      ],
      "title": "ProseShapeIn",
      "type": "object"
    },
    "kind": "query",
    "name": "prose.shape",
    "output": {
      "properties": {
        "dialogue": {
          "description": "The share of characters inside quotation marks, 0–1.",
          "format": "float",
          "type": "number"
        },
        "done": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "embeds": {
          "description": "The materials it embeds, in order (repeats kept).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paragraphs": {
          "description": "Paragraphs that are not blank.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sentences": {
          "description": "Sentences (a paragraph with words is at least one).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tasks": {
          "description": "Checklist items (a note's tasks) and how many are checked.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "paragraphs",
        "sentences",
        "dialogue",
        "tasks",
        "done",
        "embeds"
      ],
      "title": "ProseShapeOut",
      "type": "object"
    },
    "summary": "Shape of a prose document: paragraphs, sentences, the share of dialogue, its checklist and the materials it embeds."
  },
  {
