  {
    "access": "write",
    "book_version": 4,
    "concurrency": "book",
    "input": {
      "$defs": {
        "TodoMarkerIn": {
          "properties": {
            "block": {
              "description": "The paragraph's block id.",
              "type": "string"
            },
            "task": {
              "default": "",
              "description": "The task text after the marker.",
              "type": "string"
            }
          },
          "required": [
            "block"
          ],
          "type": "object"
        }
      },
      "properties": {
        "doc": {
          "description": "`body:<entry>/<module>` (including level `about`) or `material:<id>` of a v3 book.",
          "type": "string"
        },
        "editing": {
          "type": [
            "string",
            "null"
          ]
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/TodoMarkerIn"
          },
          "type": "array"
        }
      },
      "required": [
        "doc",
        "markers"
      ],
      "title": "TodoProjectInV3",
      "type": "object"
    },
    "kind": "command",
    "name": "todo.project",
    "output": {
      "properties": {
        "created": {
          "description": "TODOs made for new markers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "removed": {
          "description": "Open TODOs whose marker or paragraph is gone, deleted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "waiting": {
          "description": "Open TODOs whose marker is missing here, kept because this device\nhas not yet received the prose they were made from (sync brings the\nbook and the prose separately).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "created",
        "removed",
        "waiting"
      ],
      "title": "TodoProjected",
      "type": "object"
    },
    "summary": "Keep the TODOs typed as markers in one prose document (a paragraph starting with TODO or 待办) in step with it: a new marker gets a TODO, an open TODO whose marker is gone is deleted, resolved ones stay; the same marker makes the same TODO on every device."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "day": {
          "description": "`YYYY-MM-DD` in this device's calendar.",
          "type": "string"
        },
        "device": {
          "description": "This device's writing-day key (`device-` and 24 hex digits).",
          "type": "string"
        },
        "words": {
          "description": "Words this device added to the book that day (0 or more).",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "book",
        "device",
        "day",
        "words"
      ],
      "title": "WritingDayIn",
      "type": "object"
    },
    "kind": "command",
    "name": "writing_day.record",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Set this device's words for one day of a book (the writing-day recorder; not undoable)."
  }
