      "type": "object"
    },
    "kind": "query",
    "name": "prose.read",
    "output": {
      "$defs": {
        "ParagraphInfo": {
          "properties": {
            "block_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "heading": {
              "description": "0 for body text, 1–3 for H1–H3.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "index",
            "block_id",
            "heading",
            "text"
          ],
          "type": "object"
        }
      },
      "properties": {
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/ParagraphInfo"
          },
          "type": "array"
        },
        "total": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "The document's version (hex frontiers).",
          "type": "string"
        }
      },
      "required": [
        "paragraphs",
        "total",
        "version"
      ],
      "title": "ProseText",
      "type": "object"
    },
    "summary": "Read paragraphs of a prose document (text, block id, heading level)."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "block_id": {
          "description": "Look only in this paragraph.",
          "type": [
            "string",
            "null"
          ]
        },
        "doc": {
          "type": "string"
        },
        "find": {
          "description": "The exact current text to replace (within one paragraph).",
          "type": "string"
        },
        "replace": {
          "description": "The new text (no paragraph breaks).",
          "type": "string"
        }
      },
      "required": [
        "doc",
        "find",
        "replace"
      ],
      "title": "ProseReplaceIn",
      "type": "object"
