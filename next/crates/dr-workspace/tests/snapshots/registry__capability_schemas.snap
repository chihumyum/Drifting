    "kind": "query",
    "name": "project_template.working_copies",
    "output": {
      "$defs": {
        "WorkingCopy": {
          "description": "A template's working copy (`project_template.edit`,\n`project_template.working_copies`).",
          "properties": {
            "book": {
              "description": "The working copy's book: open it like any project.",
              "type": "string"
            },
            "created_at": {
              "description": "When it was made (Unix milliseconds).",
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "description": "Its name (the template's, as edited there); `None` when its book\ndocument is not there (a copy cut short while it was being made).",
              "type": [
                "string",
                "null"
              ]
            },
            "template": {
              "description": "The saved template it edits.",
              "type": "string"
            }
          },
          "required": [
            "book",
            "template",
            "name",
            "created_at"
          ],
          "type": "object"
        }
      },
      "items": {
        "$ref": "#/$defs/WorkingCopy"
      },
      "title": "Array_of_WorkingCopy",
      "type": "array"
    },
    "summary": "List the templates' working copies still on this device, oldest first."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "$defs": {
        "AnchorBytes": {
          "description": "A comment's anchor as stored: the two Loro cursors dr-doc writes\n(`Cursor::encode()`, the start on the first anchored character, the end\non the last), each in base64 (standard alphabet, padded). The editor\nmoves these bytes between the book and the prose document unchanged.",
          "properties": {
            "end": {
              "type": "string"
            },
            "start": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        "LinkIn": {
          "properties": {
            "anchors": {
              "description": "The ranges, as anchors (two cursors each, as comments keep them), so\ntyping since moves nothing.",
              "items": {
                "$ref": "#/$defs/AnchorBytes"
              },
              "type": "array"
            },
            "doc": {
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/Target",
              "description": "A canonical entry or asset-library file. Refused where a link to it\nthere carries a module, blocks or unknown data."
            }
          },
          "required": [
            "doc",
            "target",
            "anchors"
          ],
          "type": "object"
        },
        "Target": {
          "description": "A reference to an entity (comment or memory target).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "description": "Canonical `entry`, `patch` or `comment`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "properties": {
        "links": {
          "description": "Any number of documents and targets: each document is written once.",
          "items": {
            "$ref": "#/$defs/LinkIn"
          },
          "type": "array"
        }
      },
      "required": [
        "links"
      ],
      "title": "LinksIn",
      "type": "object"
    },
    "kind": "command",
    "name": "prose.link",
    "output": {
      "properties": {
        "docs": {
          "description": "Documents written.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "ranges": {
          "description": "Ranges whose link changed (an anchor whose text is gone counts for\nnothing).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ranges",
        "docs"
      ],
      "title": "LinksChanged",
      "type": "object"
    },
    "summary": "Link anchored ranges of prose documents to entities (anchors, not positions). Links to entries count as the author's own: shown even where automatic linking is off."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
        "doc": {
          "description": "Canonical prose: `body:<entry>/<module>` or `template:<book>/<template>/<module>`.",
          "type": "string"
        },
        "from": {
          "default": 0,
          "description": "First paragraph (0-based).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "limit": {
          "description": "At most this many paragraphs (default 200).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "doc"
      ],
      "title": "ProseReadIn",
      "type": "object"
    },
    "kind": "query",
    "name": "prose.read",
    "output": {
      "$defs": {
        "ParagraphInfo": {
          "properties": {
            "block_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "checked": {
              "description": "A checklist item's tick (on `task` items only): ticked is its comment\nresolved.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "heading": {
              "description": "0 for body text, 1–3 for H1–H3.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "list": {
              "description": "A list item's kind: `bullet`, `ordered` or `task` (a checklist item,\nwhich is also a comment); omitted for a paragraph that is not one.",
              "type": [
                "string",
                "null"
              ]
            },
            "list_level": {
              "description": "How deep a list item is nested; omitted when 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "index",
            "block_id",
            "heading",
            "text"
          ],
          "type": "object"
        }
      },
      "properties": {
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/ParagraphInfo"
          },
          "type": "array"
        },
        "total": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "The document's version (hex frontiers).",
          "type": "string"
        }
      },
      "required": [
        "paragraphs",
        "total",
        "version"
      ],
      "title": "ProseText",
      "type": "object"
    },
    "summary": "Read paragraphs of a prose document (text, block id, heading level; a list item's kind and level, a checklist item's tick)."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "block_id": {
          "description": "Look only in this paragraph.",
          "type": [
            "string",
            "null"
          ]
        },
        "doc": {
          "type": "string"
        },
        "find": {
          "description": "The exact current text to replace (within one paragraph).",
          "type": "string"
        },
        "replace": {
          "description": "The new text (no paragraph breaks).",
          "type": "string"
        }
      },
