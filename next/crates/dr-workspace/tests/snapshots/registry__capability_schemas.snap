    "summary": "Word counts of a book from the derived index: each chapter, idea and storyline, the book (its chapters), and the word targets."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "days": {
          "description": "How many days to list, ending today (default 7, at most 400).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "device": {
          "description": "This device's writing-day key: its own words for today are returned\ntoo.",
          "type": [
            "string",
            "null"
          ]
        },
