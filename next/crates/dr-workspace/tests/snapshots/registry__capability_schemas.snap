  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "$defs": {
        "Place": {
          "description": "Where to put something in an ordered list.",
          "oneOf": [
            {
              "const": "first",
              "description": "At the start.",
              "type": "string"
            },
            {
              "const": "last",
              "description": "At the end.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Right after the item with this id.",
              "properties": {
                "after": {
                  "type": "string"
                }
              },
              "required": [
                "after"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Right before the item with this id.",
              "properties": {
                "before": {
                  "type": "string"
                }
              },
              "required": [
                "before"
              ],
              "type": "object"
            }
          ]
        }
      },
      "properties": {
        "asset": {
          "description": "The asset of an image or PDF material (registered with `asset.put`).",
          "type": [
            "string",
            "null"
          ]
        },
        "book": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "folder": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`text`, `image` or `pdf`.",
          "type": "string"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "description": "A text material's note.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "book",
        "kind"
      ],
      "title": "MaterialCreateIn",
      "type": "object"
    },
    "kind": "command",
    "name": "material.create",
    "output": {
      "description": "The entity a command created or renamed, with its final name.",
