        "pos": {
          "description": "An exact position key (undo uses it); wins over `place`.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "key",
        "value"
      ],
      "title": "FactPutIn",
      "type": "object"
