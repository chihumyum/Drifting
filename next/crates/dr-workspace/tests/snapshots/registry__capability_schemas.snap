  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "$defs": {
        "FieldIn": {
          "description": "A field of an element's key/value list to add or change.",
          "properties": {
            "id": {
              "description": "Omitted: a new field.",
              "type": [
                "string",
                "null"
              ]
            },
            "key": {
              "type": "string"
            },
            "place": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Place"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pos": {
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "value"
          ],
          "type": "object"
        },
        "Place": {
          "description": "Where to put something in an ordered list.",
          "oneOf": [
            {
              "const": "first",
              "description": "At the start.",
              "type": "string"
            },
            {
              "const": "last",
              "description": "At the end.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Right after the item with this id.",
              "properties": {
                "after": {
                  "type": "string"
                }
              },
              "required": [
                "after"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Right before the item with this id.",
              "properties": {
                "before": {
                  "type": "string"
                }
              },
              "required": [
                "before"
              ],
              "type": "object"
            }
          ]
        }
      },
      "properties": {
        "add_aliases": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "book": {
          "type": "string"
        },
        "category": {
          "description": "`null` leaves it uncategorized.",
          "type": [
            "string",
            "null"
          ]
        },
        "group_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "description": "Refused if another element has it.",
          "type": [
            "string",
            "null"
          ]
        },
        "portrait": {
          "type": [
            "string",
            "null"
          ]
        },
        "put_fields": {
          "items": {
            "$ref": "#/$defs/FieldIn"
          },
          "type": "array"
        },
        "relate_pin": {
          "description": "Pin in the relation graph (`null` unpins).",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "double",
              "type": "number"
            },
            {
              "format": "double",
              "type": "number"
            }
          ],
          "type": [
            "array",
            "null"
          ]
        },
        "remove_aliases": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "remove_fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "book",
        "id"
      ],
      "title": "ElementUpdateIn",
      "type": "object"
    },
    "kind": "command",
    "name": "element.update",
    "output": {
      "description": "The entity a command created or renamed, with its final name.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Named",
      "type": "object"
    },
    "summary": "Change an element: name, summary, category, aliases, fields, portrait, relation-graph pin. A name or alias another element has is refused."
  },
