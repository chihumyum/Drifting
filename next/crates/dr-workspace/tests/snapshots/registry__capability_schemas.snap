  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "session": {
          "type": "string"
        },
        "turn": {
          "description": "One turn; omitted: the whole session.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "session"
      ],
      "title": "AgentIn",
      "type": "object"
    },
    "kind": "command",
    "name": "history.undo_agent",
    "output": {
      "$defs": {
        "Conflict": {
          "properties": {
            "field": {
              "description": "The field left alone, for a book entity.",
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": "string"
            },
            "what": {
              "description": "A prose document id, or `<collection>/<id>` of a book entity.",
              "type": "string"
            }
          },
          "required": [
            "what",
            "reason"
          ],
          "type": "object"
        },
        "EntityKey": {
          "description": "One entity of a book document: its collection (the root container's\nname, e.g. `nodes`, `relations`, `drift_groups`; `meta` with a field name\nas id) and id.",
          "properties": {
            "collection": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "collection",
            "id"
          ],
          "type": "object"
        }
      },
      "properties": {
        "conflicts": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "type": "array"
        },
        "restored": {
          "items": {
            "$ref": "#/$defs/EntityKey"
          },
          "type": "array"
        },
        "reverted_prose": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "trashed": {
          "items": {
            "$ref": "#/$defs/EntityKey"
          },
          "type": "array"
        }
      },
      "required": [
        "restored",
        "trashed",
        "reverted_prose",
        "conflicts"
      ],
      "title": "AgentUndone",
      "type": "object"
    },
    "summary": "Undo what an Agent session (or one turn) wrote: book fields nobody changed since go back, entities it created go to the trash, entities it deleted come back, and prose untouched since is reverted; the rest is reported as conflicts."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "double",
              "type": "number"
            },
            {
              "format": "double",
              "type": "number"
            }
          ],
          "type": [
            "array",
            "null"
          ]
        },
        "summary": {
          "default": "",
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": "",
          "description": "A taken title (chapters and ideas share titles) gets a ` 2` suffix.",
          "type": "string"
        }
      },
      "required": [
        "book"
      ],
      "title": "IdeaCreateIn",
      "type": "object"
    },
    "kind": "command",
    "name": "idea.create",
    "output": {
      "description": "The entity a command created or renamed, with its final name.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Named",
      "type": "object"
    },
    "summary": "Create an idea (构想); a taken title gets a numbered suffix and the final title is returned."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "group": {
          "description": "Only ideas in this group (`\"\"`: at the top level).",
          "type": [
            "string",
            "null"
          ]
        },
        "trashed": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "book"
      ],
      "title": "IdeaListIn",
      "type": "object"
    },
    "kind": "query",
    "name": "idea.list",
    "output": {
      "$defs": {
        "IdeaInfo": {
          "description": "An idea (构想; internal name drift).",
          "properties": {
            "group": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "narrative_order": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "status": {
              "description": "`drifting` or `resting`.",
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "trashed": {
              "type": "boolean"
            },
            "x": {
              "format": "double",
              "type": "number"
            },
            "y": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "id",
            "title",
            "summary",
            "status",
            "group",
            "x",
            "y",
            "narrative_order",
            "trashed"
          ],
          "type": "object"
        }
      },
      "items": {
        "$ref": "#/$defs/IdeaInfo"
      },
      "title": "Array_of_IdeaInfo",
      "type": "array"
    },
    "summary": "List ideas (构想), optionally of one group."
  },
