            "id": {
              "type": "string"
            },
            "kind": {
              "description": "`entry` or `material`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        "Region": {
          "description": "A rectangle on an image, or on one page of a PDF, as fractions (0–1) of\nthe picture or the page, so it stays put at any size and zoom.",
          "properties": {
            "h": {
              "format": "double",
              "type": "number"
            },
            "page": {
              "description": "The PDF page, from 1; omitted on an image.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "w": {
              "format": "double",
              "type": "number"
            },
            "x": {
              "format": "double",
              "type": "number"
            },
            "y": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "type": "object"
        }
      },
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorBytes"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stable cursors captured in the selected prose; mutually exclusive with range and region."
        },
        "author_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "block_id": {
          "description": "The paragraph it sits on (needs a target).",
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "default": "",
          "type": "string"
        },
        "book": {
          "type": "string"
        },
        "kind": {
          "description": "`note` (default) or `todo`.",
          "type": [
            "string",
            "null"
          ]
        },
        "module": {
          "description": "The entry's prose module (required for ranges, blocks and anchors); omit for a material.",
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "description": "`low`, `med` or `high`.",
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "description": "Anchor it to characters `[start, end)` of the target's prose.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          ],
          "type": [
            "array",
            "null"
          ]
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
