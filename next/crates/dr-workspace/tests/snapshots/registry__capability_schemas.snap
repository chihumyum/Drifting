    "summary": "List the fields every new storyline starts with, in order."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "$defs": {
        "Place": {
          "description": "Where to put something in an ordered list.",
          "oneOf": [
            {
              "const": "first",
              "description": "At the start.",
              "type": "string"
            },
            {
              "const": "last",
              "description": "At the end.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Right after the item with this id.",
              "properties": {
                "after": {
                  "type": "string"
                }
              },
              "required": [
