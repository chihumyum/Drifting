    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Remove one patch record from a patches module; the entry and its other records stay."
  },
  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "properties": {
        "block_id": {
          "type": "string"
        },
        "book": {
          "type": "string"
        },
        "find": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "owner": {
          "description": "Entry or template ID, selected by `template`.",
          "type": "string"
        },
        "replace": {
          "type": "string"
        },
        "template": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "book",
        "owner",
        "module",
        "block_id",
        "find",
        "replace"
      ],
      "title": "ReplaceIn",
      "type": "object"
    },
    "kind": "command",
    "name": "module.replace_prose",
    "output": {
      "properties": {
        "at": {
          "description": "Character offset of the replacement in the document.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "block_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "linked": {
          "description": "Entity links written on names inside the new text (automatic links\nfor an Agent's, the mirror's or an import's text, when the author has\nthem on).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at",
        "block_id",
        "linked"
      ],
      "title": "Replaced",
      "type": "object"
    },
    "summary": "Replace an exact passage in an entry's prose module, addressed by block ID."
  },
  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "properties": {
        "arrangement": {
          "default": null,
          "description": "`featured` (one large picture, a row of small ones to switch),\n`grid` or `list`; `null` goes back to the template's.",
          "type": [
            "string",
            "null"
          ]
        },
        "book": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "entry",
        "module"
      ],
      "title": "MediaArrangeIn",
      "type": "object"
    },
    "kind": "command",
    "name": "module.set_arrangement",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Choose how this entry lays out the files of its media module (`featured`, `grid` or `list`), or go back to its template's (`null`); the template is not changed."
  },
  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "$defs": {
        "InputValue": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "double",
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "A value given to write one block (`null` clears it)."
        },
        "ItemStep": {
          "description": "One step down to the scope a write goes to: an item of a list.",
          "properties": {
            "item": {
              "description": "The item's id.",
              "type": "string"
            },
            "list": {
              "description": "The list block.",
              "type": "string"
            }
          },
          "required": [
            "list",
            "item"
          ],
          "type": "object"
        }
      },
      "description": "An entry's custom module.",
      "properties": {
        "block": {
          "type": "string"
        },
        "book": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "module": {
          "description": "The template module (of kind `custom`).",
          "type": "string"
        },
        "path": {
          "default": [],
          "description": "The items down to the block's scope, one per list from the entry\ndown (empty for a block the entry keeps directly).",
          "items": {
            "$ref": "#/$defs/ItemStep"
          },
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/InputValue",
          "description": "The value (`null` clears it): text for text, long_text, date, select\nand image (an asset id); a number; true or false for a toggle; a list\nof texts for multi_select and entry (entry ids)."
        }
      },
      "required": [
        "book",
        "entry",
        "module",
        "block",
        "value"
      ],
      "title": "SetValueIn",
      "type": "object"
    },
    "kind": "command",
    "name": "module.set_custom_value",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Set or clear one block's value in an entry's custom module, checked against the block's kind; a block in a list is reached through its items (`path`)."
  },
  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "$defs": {
        "FieldValue": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "double",
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "properties": {
        "book": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FieldValue"
        }
      },
      "required": [
        "book",
        "entry",
        "module",
        "field",
        "value"
      ],
      "title": "FieldIn",
      "type": "object"
    },
    "kind": "command",
    "name": "module.set_field",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Set or clear a typed field value in an entry's fields module."
  },
  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "$defs": {
        "ListItemKind": {
          "description": "A list item's kind, written as in the project template format (§10).",
          "oneOf": [
            {
              "enum": [
                "bullet",
                "ordered"
              ],
              "type": "string"
            },
            {
              "const": "task",
              "description": "A checklist item: it is also a comment (origin `task`) whose words are\nthe line's, and its tick is that comment's status.",
              "type": "string"
            }
          ]
        },
        "TemplateParagraph": {
          "description": "One paragraph of a body template.",
          "properties": {
            "checked": {
              "description": "A checklist item's tick (only with `list: \"task\"`): ticked is its\ncomment resolved, cleared is it open.",
              "type": "boolean"
            },
            "heading": {
              "description": "1, 2 or 3 for H1/H2/H3; omitted (or 0, as a read gives it) for body text.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "list": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ListItemKind"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A list item: `bullet`, `ordered` or `task` (a checklist item). Omitted\nfor a paragraph that is not one."
            },
            "list_level": {
              "description": "How deep a list item is nested, 0 the outermost (only with `list`).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "default": "",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "properties": {
        "book": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "owner": {
          "description": "Entry or template ID, selected by `template`.",
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/TemplateParagraph"
          },
          "type": "array"
        },
        "template": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "book",
        "owner",
        "module",
        "paragraphs"
      ],
      "title": "SetIn",
      "type": "object"
    },
    "kind": "command",
    "name": "module.set_prose",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Write paragraphs of an entry's or a template's prose module: all of them, in order, as module.read_prose reads them. Unchanged paragraphs stay; one whose words change is edited in place and keeps its id and comments. A list item has `list` (bullet, ordered or task) and `list_level`. A task item is a checklist item and also a comment whose words are the line's: `checked` ticked resolves it, cleared reopens it, and taking the line out deletes the comment."
  },
  {
    "access": "write",
    "book_version": 5,
    "concurrency": "library",
    "input": {
      "$defs": {
        "EntryTemplate": {
          "properties": {
            "agent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TemplateAgentConfig"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Skill-style Agent instructions (`写给帮手的说明`)."
            },
            "color": {
              "default": null,
              "description": "Optional display color (`颜色`).",
              "type": [
                "string",
                "null"
              ]
            },
            "deleted_at": {
              "default": null,
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "level": {
              "default": false,
              "description": "Whether a new entry of this template starts with its switch on.\nChanging it never touches existing entries.",
              "type": "boolean"
            },
            "linkable": {
              "default": true,
              "description": "Whether entries of this template take part in auto-linking.",
              "type": "boolean"
            },
            "mark": {
              "default": null,
              "description": "Optional badge/icon mark (`记号`).",
              "type": [
                "string",
                "null"
              ]
            },
            "modules": {
              "default": [],
              "description": "Ordered module manifest (`modules`), any kinds.",
              "items": {
                "$ref": "#/$defs/ModuleSpec"
              },
              "type": "array"
            },
            "name": {
              "type": "string"
            },
            "settings": {
              "$ref": "#/$defs/LevelSettingsOverride",
              "default": {
                "accept": null,
                "auto_link": null,
                "display": null,
                "format_shortcuts": null
              },
              "description": "Settings for what lives below entries of this template whose switch\nis on (`lane` included); kept whatever `level` says."
            },
            "verbs": {
              "default": [],
              "description": "Declared actions, shown on entries of this template whose switch is on.",
              "items": {
                "$ref": "#/$defs/TemplateVerb"
              },
              "type": "array"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "type": "object"
        },
        "FieldDef": {
          "properties": {
            "default_value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FieldValue"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional initial value copied into newly created entries of this template."
            },
            "field_type": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "options": {
              "default": [],
              "description": "Candidate options for `select` and `multi_select`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "target_template": {
              "default": null,
              "description": "Optional target template filter when `field_type == \"entity_ref\"`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "field_type"
          ],
          "type": "object"
        },
        "FieldValue": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "double",
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "KvEntry": {
          "properties": {
            "id": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "key",
            "value"
          ],
          "type": "object"
        },
        "LevelSettingsOverride": {
          "properties": {
            "accept": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "auto_link": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "default_template": {
              "description": "`None` inherits; `Some(None)` clears to no default template; `Some(Some(t))` sets `t`.",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "format_shortcuts": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "home": {
              "description": "`None` defers to the entry's template; `Some(None)` clears `home`; `Some(Some(id))` sets `home`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "ModuleAgentConfig": {
          "properties": {
            "instructions": {
              "default": "",
              "description": "One-sentence instruction for the Agent when reading or writing this module.",
              "type": "string"
            },
            "read_tier": {
              "default": null,
              "description": "Context assembly tier (e.g. `\"summary\"`, `\"on_demand\"`, `\"full\"`).",
              "type": [
                "string",
                "null"
              ]
            },
            "writable": {
              "default": true,
              "description": "Whether the Agent may write to this module.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "ModuleConfig": {
          "properties": {
            "aliases_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies aliases for auto-linking.",
              "type": [
                "string",
                "null"
              ]
            },
            "arrangement": {
              "description": "For `media` modules: the default arrangement (`featured`, `grid`,\n`list`); entries may choose their own.",
              "type": [
                "string",
                "null"
              ]
            },
            "color_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the display color.",
              "type": [
                "string",
                "null"
              ]
            },
            "default_cols": {
              "default": 3,
              "description": "For `plot_grid` modules: initial column count (defaults to 3).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "default_rows": {
              "default": 3,
              "description": "For `plot_grid` modules: initial row count (defaults to 3).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "defs": {
              "default": [],
              "description": "For `fields` modules: ordered field definitions.",
              "items": {
                "$ref": "#/$defs/FieldDef"
              },
              "type": "array"
            },
            "in_book": {
              "default": true,
              "description": "For `prose` modules: whether this prose is part of the book (`成书`:\nexport, the book's word count, chapter numbering). On by default.",
              "type": "boolean"
            },
            "initial_kv": {
              "default": [],
              "description": "For `kv` modules: initial key/value rows copied into new entries of this template.",
              "items": {
                "$ref": "#/$defs/KvEntry"
              },
              "type": "array"
            },
            "module": {
              "description": "For `custom` modules: the module it draws (a module of mine, or one\nthe book already has a copy of; `custom-modules.md` §7).",
              "type": [
                "string",
                "null"
              ]
            },
            "portrait_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the portrait `AssetId`.",
              "type": [
                "string",
                "null"
              ]
            },
            "show_outline": {
              "default": false,
              "description": "For `prose` modules: whether H1/H2/H3 outline headings appear in the outline tree.",
              "type": "boolean"
            },
            "status_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the status badge.",
              "type": [
                "string",
                "null"
              ]
            },
            "summary_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the summary text.",
              "type": [
                "string",
                "null"
              ]
            },
            "task_todos": {
              "default": false,
              "description": "For `prose` modules: whether checklist items project into TODOs.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "ModuleSpec": {
          "properties": {
            "agent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModuleAgentConfig"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "config": {
              "$ref": "#/$defs/ModuleConfig",
              "default": {
                "aliases_field": null,
                "color_field": null,
                "default_cols": 3,
                "default_rows": 3,
                "defs": [],
                "in_book": true,
                "initial_kv": [],
                "portrait_field": null,
                "show_outline": false,
                "status_field": null,
                "summary_field": null,
                "task_todos": false
              }
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "name"
          ],
          "type": "object"
        },
        "ProjectBook": {
          "description": "The book (`project.book`): on when present, with its two word targets.\nIt has no start: the book reads the whole project from the root. An old\n`root` in an input is ignored.",
          "properties": {
            "daily_word_target": {
              "default": null,
              "description": "Effective daily word target (`None` when turned off).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "daily_word_target_set": {
              "default": null,
              "description": "Stored daily word target (`None` = default, `Some(0)` = off).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "word_target": {
              "default": null,
              "description": "Effective whole-book word target (`None` when turned off).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "word_target_set": {
              "default": null,
              "description": "Stored whole-book word target (`None` = default, `Some(0)` = off).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "ProjectCreateTemplate": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "template_id": {
                  "type": "string"
                }
              },
              "required": [
                "template_id"
              ],
              "type": "object"
            },
            {
              "description": "Canonical drifting.project-template v1 object.",
              "properties": {
                "format": {
                  "const": "drifting.project-template",
                  "type": "string"
                },
                "formatVersion": {
                  "const": 1,
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "format",
                "formatVersion",
                "name"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "source": {
                  "$ref": "#/$defs/ProjectTemplateRef"
                },
                "value": {
                  "type": "object"
                }
              },
              "required": [
                "value"
              ],
              "type": "object"
            },
            {
              "$ref": "#/$defs/ProjectTemplate"
            }
          ]
        },
        "ProjectDefinitionInput": {
          "properties": {
            "agent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TemplateAgentConfig"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "book": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProjectBook"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProjectTemplateRef"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "tabs": {
              "default": [],
              "items": {
                "$ref": "#/$defs/ProjectTab"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "ProjectSeedEntry": {
          "properties": {
            "fields": {
              "additionalProperties": {
                "additionalProperties": {
                  "$ref": "#/$defs/FieldValue"
                },
                "type": "object"
              },
              "default": {},
              "type": "object"
            },
            "id": {
