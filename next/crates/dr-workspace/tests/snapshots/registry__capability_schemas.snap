            {
              "const": "first",
              "description": "Before every chapter.",
              "type": "string"
            },
            {
              "const": "last",
              "description": "After every chapter.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Right after this chapter (before the next chapter or act boundary).",
              "properties": {
                "after": {
                  "type": "string"
                }
              },
              "required": [
                "after"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Right before this chapter.",
              "properties": {
                "before": {
                  "type": "string"
                }
              },
              "required": [
                "before"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "An exact book-order coordinate (undo uses it).",
              "properties": {
                "order": {
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "order"
              ],
              "type": "object"
            }
          ]
        }
      },
