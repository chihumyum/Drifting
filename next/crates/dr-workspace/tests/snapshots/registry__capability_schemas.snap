            },
            "chars": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "counted": {
              "description": "Every one of its chapters is counted.",
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "words": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "words",
            "chars",
            "chapters",
            "counted"
          ],
          "type": "object"
        }
