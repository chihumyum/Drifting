    "kind": "query",
    "name": "book.writing_days",
    "output": {
      "$defs": {
        "DayWords": {
          "properties": {
            "day": {
              "type": "string"
            },
            "words": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "day",
            "words"
          ],
          "type": "object"
        }
      },
      "properties": {
        "active_days": {
          "description": "Days with words among the last thirty, today included.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "daily_word_target": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "days": {
          "description": "The days asked for, oldest first, every day listed (0 when nothing\nwas written), summed over devices.",
          "items": {
            "$ref": "#/$defs/DayWords"
          },
          "type": "array"
        },
        "mine_today": {
          "description": "`device`'s own words today (0 without one).",
          "format": "int64",
          "type": "integer"
        },
        "streak": {
          "description": "Consecutive days with words, ending today (0 when today has none).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "streak_before": {
          "description": "Consecutive days with words, ending yesterday (the streak today's\nfirst words continue).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "today": {
          "format": "int64",
          "type": "integer"
        },
        "week": {
          "description": "The last seven days, today included.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "days",
        "today",
        "mine_today",
        "week",
        "active_days",
        "streak",
        "streak_before",
        "daily_word_target"
      ],
      "title": "WritingDaysOut",
