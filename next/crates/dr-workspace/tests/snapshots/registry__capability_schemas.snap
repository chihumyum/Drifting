    },
    "kind": "command",
    "name": "entry.create",
    "output": {
      "$defs": {
        "Below": {
          "description": "What lies below a level (`下面`).",
          "properties": {
            "children": {
              "description": "Live entries living under it, in manuscript order.",
              "items": {
                "$ref": "#"
              },
              "type": "array"
            },
            "members": {
              "description": "Live entries validly belonging to it, in the memberships' order.",
              "items": {
                "$ref": "#"
              },
              "type": "array"
            },
            "settings": {
              "$ref": "#/$defs/LevelSettings"
            },
            "sources": {
              "additionalProperties": {
                "$ref": "#/$defs/SettingSource"
              },
              "description": "Where each resolved setting comes from.",
              "type": "object"
            }
          },
          "required": [
            "settings",
            "sources",
            "children",
            "members"
          ],
          "type": "object"
        },
        "EntryLayout": {
          "properties": {
            "board": {
              "default": null,
              "description": "Position on a board / island canvas.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "double",
                  "type": "number"
                },
                {
                  "format": "double",
                  "type": "number"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            },
            "grid": {
              "default": null,
              "description": "Grid coordinates `(col, row)` in a grid layout.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "int64",
                  "type": "integer"
                },
                {
                  "format": "int64",
                  "type": "integer"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            },
            "relation_graph": {
              "default": null,
              "description": "Pinned position in the relation graph.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "double",
                  "type": "number"
                },
                {
                  "format": "double",
                  "type": "number"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "board",
            "grid",
            "relation_graph"
          ],
          "type": "object"
        },
        "FieldValue": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "double",
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "KvEntry": {
          "properties": {
            "id": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "key",
            "value",
            "pos"
          ],
          "type": "object"
        },
        "LevelSettings": {
          "properties": {
            "accept": {
              "default": false,
              "description": "Whether entries residing elsewhere may belong to this level via `memberships` (`收别处的条目`).\nSwimlane levels (`lane == true`) always accept memberships.",
              "type": "boolean"
            },
            "auto_link": {
              "default": false,
              "description": "Whether entries residing in or belonging to this level participate in\nauto-linking (when their template is `linkable`).",
              "type": "boolean"
            },
            "default_template": {
              "default": null,
              "description": "Default template when creating a new entry under this level (`None` = blank).",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": "",
              "description": "Default workspace presentation mode for entries in this level.",
              "type": "string"
            },
            "format_shortcuts": {
              "default": "",
              "description": "Editor formatting shortcut profile for prose under this level (`格式快捷输入`).",
              "type": "string"
            },
            "home": {
              "default": null,
              "description": "For levels with `accept == true`: which level entry newly created entries reside under (`新条目住在`).\n`None` means they reside under this level itself.",
              "type": [
                "string",
                "null"
              ]
            },
            "is_manuscript": {
              "default": false,
              "description": "Whether what lives under this level in tree order forms a manuscript (`成书`).",
              "type": "boolean"
            },
            "lane": {
              "default": false,
              "description": "Whether this level is a timeline swimlane (never inherited).",
              "type": "boolean"
            }
          },
          "required": [
            "default_template",
            "display",
            "auto_link",
            "accept",
            "home",
            "is_manuscript",
            "format_shortcuts",
            "lane"
          ],
          "type": "object"
        },
        "LevelSettingsOverride": {
          "properties": {
            "accept": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "auto_link": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "default_template": {
              "description": "`None` inherits; `Some(None)` clears to no default template; `Some(Some(t))` sets `t`.",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "format_shortcuts": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "home": {
              "description": "`None` inherits; `Some(None)` means reside in this level itself; `Some(Some(id))` sets `home`.",
              "type": [
                "string",
                "null"
              ]
            },
            "is_manuscript": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "lane": {
              "default": null,
              "description": "`None` leaves it to the template (on an entry) or off (on a template).",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "display",
            "auto_link",
            "accept",
            "is_manuscript",
            "format_shortcuts",
            "lane"
          ],
          "type": "object"
        },
        "SettingSource": {
          "description": "Where one resolved setting comes from (the same precedence as its value).",
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "default",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "entry": {
                  "type": "string"
                },
                "kind": {
                  "const": "override",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "entry"
              ],
              "type": "object"
            },
            {
              "properties": {
                "entry": {
                  "type": "string"
                },
                "kind": {
                  "const": "template",
                  "type": "string"
                },
                "template": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "entry",
                "template"
              ],
              "type": "object"
            },
            {
              "description": "`accept` is on because the level is a swimlane.",
              "properties": {
                "entry": {
                  "type": "string"
                },
                "kind": {
                  "const": "lane",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "entry"
              ],
              "type": "object"
            }
          ]
        }
      },
      "properties": {
        "below": {
          "anyOf": [
            {
              "$ref": "#/$defs/Below"
            },
            {
              "type": "null"
            }
          ],
          "description": "What lies below an entry whose switch is on (`entry.get`, and\n`entry.list` with `below`): resolved settings with where each comes\nfrom, resident children and accepted members. Absent otherwise."
        },
        "created_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "deleted_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "fields": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/FieldValue"
            },
            "type": "object"
          },
          "description": "Values of `fields` modules: `module_id -> (field_id -> value)`.",
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "kv": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/KvEntry"
            },
            "type": "array"
          },
          "description": "Rows of `kv` modules (`kv:<module_id>`): `module_id -> sorted KvEntry list`.",
          "type": "object"
        },
        "layout": {
          "$ref": "#/$defs/EntryLayout"
        },
        "level": {
          "default": false,
          "description": "The entry's own switch (`层级`): whether entries can live under it.",
          "type": "boolean"
        },
        "name_conflict": {
          "default": null,
          "description": "Set by readers when this entry participates in auto-linking and its\ntitle or alias collides with an earlier auto-linked entry (`V3-AUTOLINK-NAME-UNIQUE`).",
          "type": [
            "string",
            "null"
          ]
        },
        "overrides": {
          "anyOf": [
            {
              "$ref": "#/$defs/LevelSettingsOverride"
            },
            {
              "type": "null"
            }
          ],
          "description": "Overrides of the settings for what lives below (kept, but not used,\nwhile the switch is off)."
        },
        "parent": {
          "description": "Raw parent entry in the `entries` tree (`None` at the root).\nList queries apply the leaf-parent tolerance to their filtering.",
          "type": [
            "string",
            "null"
          ]
        },
        "pos": {
          "description": "Fractional-index position among siblings in the `entries` tree (`文稿顺序`).",
          "type": "string"
        },
        "primary": {
          "description": "Stored primary membership host; membership queries filter invalid records.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "description": "The template shaping this entry (`None` = untemplated entry).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "parent",
        "pos",
        "title",
        "template",
        "level",
        "overrides",
        "fields",
        "kv",
        "primary",
        "layout",
        "created_at",
        "updated_at",
        "deleted_at",
        "name_conflict"
      ],
      "title": "Entry",
      "type": "object"
    },
    "summary": "Create an entry with its template, switch, residence, membership and initial module content."
