  {
    "access": "read",
    "book_version": 5,
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "entry",
        "module"
      ],
      "title": "In",
      "type": "object"
    },
    "kind": "query",
    "name": "module.read",
    "output": {
      "$defs": {
        "Below": {
          "description": "What lies below an entry (`下面` / `挂在这里`).",
          "properties": {
            "children": {
              "description": "Live entries living under it, in the folder's manual order, also while it is a lane in a\nview (`Some` only when `level` is on).",
              "items": {
                "$ref": "#/$defs/Entry"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "members": {
              "description": "Live entries validly belonging to it, in authoritative member order (`Some` only when `accept` is on).",
              "items": {
                "$ref": "#/$defs/Entry"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "settings": {
              "$ref": "#/$defs/LevelSettings"
            },
            "sources": {
              "additionalProperties": {
                "$ref": "#/$defs/SettingSource"
              },
              "description": "Where each resolved setting comes from.",
              "type": "object"
            }
          },
          "required": [
            "settings",
            "sources"
          ],
          "type": "object"
        },
        "Cell": {
          "properties": {
            "column": {
              "type": "string"
            },
            "row": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "row",
            "column",
            "text"
          ],
          "type": "object"
        },
        "Entry": {
          "properties": {
            "arrangements": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "This entry's own arrangement of a media module (`featured`, `grid`\nor `list`): `module_id -> arrangement`; a module not listed uses its\ntemplate's (`module.read` gives the effective one).",
              "type": "object"
            },
            "auto_link": {
              "default": false,
              "description": "The entry's own 「自动链接」 (`kernel-v5.md` §16): whether its title\nand aliases link by themselves, and whether the automatic links to it\nshow as links (`entry.set_auto_link`).",
              "type": "boolean"
            },
            "below": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Below"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What lies below an entry whose switch is on (`entry.get`, and\n`entry.list` with `below`): resolved settings with where each comes\nfrom, resident children and accepted members. Absent otherwise."
            },
            "created_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "deleted_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "fields": {
              "additionalProperties": {
                "additionalProperties": {
                  "$ref": "#/$defs/FieldValue"
                },
                "type": "object"
              },
              "description": "Values of `fields` modules: `module_id -> (field_id -> value)`.",
              "type": "object"
            },
            "id": {
              "type": "string"
            },
            "kv": {
              "additionalProperties": {
                "items": {
                  "$ref": "#/$defs/KvEntry"
                },
                "type": "array"
              },
              "description": "Rows of `kv` modules (`kv:<module_id>`): `module_id -> sorted KvEntry list`.",
              "type": "object"
            },
            "level": {
              "default": false,
              "description": "The entry's own switch (`层级`): whether entries can live under it.",
              "type": "boolean"
            },
            "mark": {
              "default": null,
              "description": "Optional per-entry badge/icon mark (`记号`); falls back to the active\ntemplate's `mark` when unset (`kernel-v5.md` §8).",
              "type": [
                "string",
                "null"
              ]
            },
            "media": {
              "additionalProperties": {
                "items": {
                  "$ref": "#/$defs/MediaItem"
                },
                "type": "array"
              },
              "default": {},
              "description": "Items of `media` modules (`media:<module_id>`): `module_id -> sorted MediaItem list`.",
              "type": "object"
            },
            "missing_files": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "description": "Image fields whose file is in Recently Deleted or not in the book:\n`module_id -> field ids`, shown as placeholders (the value stays).\nSet by readers, ignored on input.",
              "type": "object"
            },
            "name_conflict": {
              "default": null,
              "description": "Set by readers when this entry participates in auto-linking and its\ntitle or alias collides with an earlier auto-linked entry (`V3-AUTOLINK-NAME-UNIQUE`).",
              "type": [
                "string",
                "null"
              ]
            },
            "overrides": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LevelSettingsOverride"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Overrides of the settings for what lives below (kept, but not used,\nwhile the switch is off)."
            },
            "parent": {
              "description": "Raw parent entry in the `entries` tree (`None` at the root).\nList queries read an entry under one whose switch is off as living\nunder the nearest level.",
              "type": [
                "string",
                "null"
              ]
            },
            "pos": {
              "description": "Fractional-index position among siblings in the `entries` tree (`文稿顺序`).",
              "type": "string"
            },
            "primary": {
              "description": "Stored primary membership host; membership queries filter invalid records.",
              "type": [
                "string",
                "null"
              ]
            },
            "template": {
              "description": "The template shaping this entry (`None` = untemplated entry).",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "updated_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "parent",
            "pos",
            "title",
            "mark",
            "template",
            "level",
            "auto_link",
            "overrides",
            "fields",
            "kv",
            "media",
            "primary",
            "created_at",
            "updated_at",
            "deleted_at",
            "name_conflict"
          ],
          "type": "object"
        },
        "FieldDef": {
          "properties": {
            "default_value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FieldValue"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional initial value copied into newly created entries of this template."
            },
            "field_type": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "options": {
              "default": [],
              "description": "Candidate options for `select` and `multi_select`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "target_template": {
              "default": null,
              "description": "Optional target template filter when `field_type == \"entity_ref\"`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "field_type",
            "options",
            "target_template",
            "pos"
          ],
          "type": "object"
        },
        "FieldValue": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "double",
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "Grid": {
          "properties": {
            "cell_h": {
              "format": "double",
              "type": "number"
            },
            "cell_w": {
              "format": "double",
              "type": "number"
            },
            "cells": {
              "items": {
                "$ref": "#/$defs/Cell"
              },
              "type": "array"
            },
            "columns": {
              "items": {
                "$ref": "#/$defs/Line"
              },
              "type": "array"
            },
            "rows": {
              "items": {
                "$ref": "#/$defs/Line"
              },
              "type": "array"
            }
          },
          "required": [
            "cell_w",
            "cell_h",
            "rows",
            "columns",
            "cells"
          ],
          "type": "object"
        },
        "KvEntry": {
          "properties": {
            "id": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "key",
            "value",
            "pos"
          ],
          "type": "object"
        },
        "LevelSettings": {
          "properties": {
            "accept": {
              "default": false,
              "description": "Whether entries may belong to this entry via `memberships` (`收别处的条目`);\nindependent of `level` and never inherited.",
              "type": "boolean"
            },
            "auto_link": {
              "default": false,
              "description": "Whether entries residing under this level participate in auto-linking\n(when their template is `linkable`).",
              "type": "boolean"
            },
            "default_template": {
              "default": null,
              "description": "Default template when creating a new entry under this level (`None` = blank).",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": "",
              "description": "Default workspace presentation mode for entries below this entry.",
              "type": "string"
            },
            "format_shortcuts": {
              "default": "",
              "description": "Editor formatting shortcut profile for prose under this level (`格式快捷输入`).",
              "type": "string"
            },
            "home": {
              "default": null,
              "description": "For entries with `accept == true`: which level entry newly created\nmembers reside under (`新条目住在`, never inherited).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "default_template",
            "display",
            "auto_link",
            "accept",
            "home",
            "format_shortcuts"
          ],
          "type": "object"
        },
        "LevelSettingsOverride": {
          "properties": {
            "accept": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "auto_link": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "default_template": {
              "description": "`None` inherits; `Some(None)` clears to no default template; `Some(Some(t))` sets `t`.",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "format_shortcuts": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "home": {
              "description": "`None` defers to the entry's template; `Some(None)` clears `home`; `Some(Some(id))` sets `home`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "display",
            "auto_link",
            "accept",
            "format_shortcuts"
          ],
          "type": "object"
        },
        "Line": {
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "pos": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "pos",
            "label"
          ],
          "type": "object"
        },
        "MediaItem": {
          "properties": {
            "asset": {
              "type": "string"
            },
            "caption": {
              "default": "",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "missing": {
              "description": "Set by readers when `asset` is not registered in the book's `assets`\n(`MEDIA-AND-EMBED-ASSET-EXISTS`). Ignored on input.",
              "type": "boolean"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "asset",
            "caption",
            "pos"
          ],
          "type": "object"
        },
        "ModuleAgentConfig": {
          "properties": {
            "instructions": {
              "default": "",
              "description": "One-sentence instruction for the Agent when reading or writing this module.",
              "type": "string"
            },
            "read_tier": {
              "default": null,
              "description": "Context assembly tier (e.g. `\"summary\"`, `\"on_demand\"`, `\"full\"`).",
              "type": [
                "string",
                "null"
              ]
            },
            "writable": {
              "default": true,
              "description": "Whether the Agent may write to this module.",
              "type": "boolean"
            }
          },
          "required": [
            "writable",
            "read_tier",
            "instructions"
          ],
          "type": "object"
        },
        "ModuleConfig": {
          "properties": {
            "aliases_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies aliases for auto-linking.",
              "type": [
                "string",
                "null"
              ]
            },
            "arrangement": {
              "description": "For `media` modules: the default arrangement (`featured`, `grid`,\n`list`); entries may choose their own.",
              "type": [
                "string",
                "null"
              ]
            },
            "color_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the display color.",
              "type": [
                "string",
                "null"
              ]
            },
            "default_cols": {
              "default": 3,
              "description": "For `plot_grid` modules: initial column count (defaults to 3).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "default_rows": {
              "default": 3,
              "description": "For `plot_grid` modules: initial row count (defaults to 3).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "defs": {
              "default": [],
              "description": "For `fields` modules: ordered field definitions.",
              "items": {
                "$ref": "#/$defs/FieldDef"
              },
              "type": "array"
            },
            "in_book": {
              "default": true,
              "description": "For `prose` modules: whether this prose is part of the book (`成书`:\nexport, the book's word count, chapter numbering). On by default.",
              "type": "boolean"
            },
            "initial_kv": {
              "default": [],
              "description": "For `kv` modules: initial key/value rows copied into new entries of this template.",
              "items": {
                "$ref": "#/$defs/KvEntry"
              },
              "type": "array"
            },
            "module": {
              "description": "For `custom` modules: the module it draws (a module of mine, or one\nthe book already has a copy of; `custom-modules.md` §7).",
              "type": [
                "string",
                "null"
              ]
            },
            "portrait_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the portrait `AssetId`.",
              "type": [
                "string",
                "null"
              ]
            },
            "show_outline": {
              "default": false,
              "description": "For `prose` modules: whether H1/H2/H3 outline headings appear in the outline tree.",
              "type": "boolean"
            },
            "status_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the status badge.",
              "type": [
                "string",
                "null"
              ]
            },
            "summary_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the summary text.",
              "type": [
                "string",
                "null"
              ]
            },
            "task_todos": {
              "default": false,
              "description": "For `prose` modules: whether checklist items project into TODOs.",
              "type": "boolean"
            }
          },
          "required": [
            "show_outline",
            "task_todos",
            "in_book",
            "defs",
            "aliases_field",
            "color_field",
            "status_field",
            "summary_field",
            "portrait_field",
            "initial_kv",
            "default_rows",
            "default_cols"
          ],
          "type": "object"
        },
        "ModuleSpec": {
          "properties": {
            "agent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModuleAgentConfig"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "config": {
              "$ref": "#/$defs/ModuleConfig",
              "default": {
                "aliases_field": null,
                "color_field": null,
                "default_cols": 3,
                "default_rows": 3,
                "defs": [],
                "in_book": true,
                "initial_kv": [],
                "portrait_field": null,
                "show_outline": false,
                "status_field": null,
                "summary_field": null,
                "task_todos": false
              }
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "name",
            "pos",
            "config",
            "agent"
          ],
          "type": "object"
        },
        "Patch": {
          "properties": {
            "body": {
              "type": "string"
            },
            "entry": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "invalidated_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "module": {
              "type": "string"
            },
            "pos": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_block": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_entry": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_module": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "entry",
            "module",
            "source_entry",
            "source_module",
            "source_block",
            "source_text",
            "title",
            "body",
            "pos",
            "invalidated_at"
          ],
          "type": "object"
        },
        "SettingSource": {
          "description": "Where one resolved setting comes from (the same precedence as its value).",
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "default",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "entry": {
                  "type": "string"
                },
                "kind": {
                  "const": "override",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "entry"
              ],
              "type": "object"
            },
            {
              "properties": {
                "entry": {
                  "type": "string"
                },
                "kind": {
                  "const": "template",
                  "type": "string"
                },
                "template": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "entry",
                "template"
              ],
              "type": "object"
            }
          ]
        },
        "Summary": {
          "properties": {
            "definition": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModuleSpec"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "type": "string"
            },
            "prose_doc": {
              "type": [
                "string",
                "null"
              ]
            },
            "retained": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "definition",
            "retained",
            "prose_doc"
          ],
          "type": "object"
        }
      },
      "properties": {
        "arrangement": {
          "description": "A `media` module: how this entry lays its files out (its own choice,\nelse its template's, else `featured`), and whether it is its own.",
          "type": [
            "string",
            "null"
          ]
        },
        "below": {
          "anyOf": [
            {
              "$ref": "#/$defs/Below"
            },
            {
              "type": "null"
            }
          ],
          "description": "A `children` module (`下面的条目`) of an entry whose switch is on:\nwhat lies below it, as `entry.get` gives it."
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldValue"
          },
          "type": "object"
        },
        "grid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grid"
            },
            {
              "type": "null"
            }
          ]
        },
        "kv": {
          "items": {
            "$ref": "#/$defs/KvEntry"
          },
          "type": "array"
        },
        "media": {
          "items": {
            "$ref": "#/$defs/MediaItem"
          },
          "type": "array"
        },
        "missing_files": {
          "description": "Image fields whose file is in Recently Deleted or not in the book\n(shown as placeholders; the values stay).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "module": {
          "$ref": "#/$defs/Summary"
        },
        "own_arrangement": {
          "type": "boolean"
        },
        "patches": {
          "items": {
            "$ref": "#/$defs/Patch"
          },
          "type": "array"
        }
      },
      "required": [
        "module",
        "fields",
        "missing_files",
        "kv",
        "media",
        "patches",
        "grid"
      ],
      "title": "Data",
      "type": "object"
    },
    "summary": "Read a current or retained module and its structured content; a children module reads what lies below the entry."
  },
  {
    "access": "read",
    "book_version": 5,
    "concurrency": "shared",
    "input": {
      "description": "An entry's custom module.",
      "properties": {
        "book": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "module": {
          "description": "The template module (of kind `custom`).",
          "type": "string"
        }
      },
      "required": [
        "book",
        "entry",
        "module"
      ],
      "title": "CustomIn",
      "type": "object"
    },
    "kind": "query",
    "name": "module.read_custom",
    "output": {
      "$defs": {
        "CopyInfo": {
          "description": "A book's copy of a module, as a reader needs it.",
          "properties": {
            "broken": {
              "description": "This build's validator refuses the copy (§16 item 6): it is drawn as\nan empty placeholder with its name; the values stay.",
              "type": "boolean"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "follows": {
              "description": "My modules have this id: the copy follows them (§7).",
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "description": "The module's name (for a broken copy: what its JSON still says).",
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "description": "`library` or `template`.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "source",
            "follows",
            "broken"
          ],
          "type": "object"
        }
      },
      "description": "`module.read_custom`.",
      "properties": {
        "copy": {
          "anyOf": [
            {
              "$ref": "#/$defs/CopyInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None`: the template names a module the book has no copy of."
        },
        "module": {
          "description": "The template module.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "description": "The copy's module, when it can be read."
        },
        "values": {
          "description": "What the copy can read of the entry's values, by block id (a list as\nits items, each with its id). A value its block cannot read now is\nleft out, and stays stored."
        }
      },
      "required": [
        "module",
        "name",
        "values"
      ],
      "title": "CustomData",
      "type": "object"
    },
    "summary": "Read an entry's custom module: the book's copy of the module (or that it is broken), and the values the copy can read, by block id."
  },
  {
    "access": "read",
    "book_version": 5,
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "owner": {
          "description": "Entry or template ID, selected by `template`.",
          "type": "string"
        },
        "template": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "book",
        "owner",
        "module"
      ],
      "title": "ProseIn",
      "type": "object"
    },
    "kind": "query",
    "name": "module.read_prose",
    "output": {
      "$defs": {
        "ParagraphInfo": {
          "properties": {
            "block_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "checked": {
              "description": "A checklist item's tick (on `task` items only): ticked is its comment\nresolved.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "heading": {
              "description": "0 for body text, 1–3 for H1–H3.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "list": {
              "description": "A list item's kind: `bullet`, `ordered` or `task` (a checklist item,\nwhich is also a comment); omitted for a paragraph that is not one.",
              "type": [
                "string",
                "null"
              ]
            },
            "list_level": {
              "description": "How deep a list item is nested; omitted when 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "index",
            "block_id",
            "heading",
            "text"
          ],
          "type": "object"
        }
      },
      "properties": {
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/ParagraphInfo"
          },
          "type": "array"
        },
        "total": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "The document's version (hex frontiers).",
          "type": "string"
        }
      },
      "required": [
        "paragraphs",
        "total",
        "version"
      ],
      "title": "ProseText",
      "type": "object"
    },
    "summary": "Read an entry's or a template's prose module with block IDs and version."
  },
