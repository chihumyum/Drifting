  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "$defs": {
        "Target": {
          "description": "A reference to an entity (relation end, comment or memory target).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "description": "`node`, `element`, `patch`, `category`, `storyline`, `comment`,\n`material`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "properties": {
        "book": {
          "type": "string"
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only what this entity's prose mentions (a chapter or idea is\n`node`)."
        },
        "limit": {
          "description": "At most this many rows, the most mentioned (a whole book has tens of\nthousands).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only what mentions this entity."
        },
        "to_kind": {
          "description": "Only targets of this kind (`element`, `node`, `material`, …).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "book"
      ],
      "title": "MentionListIn",
      "type": "object"
    },
    "kind": "query",
    "name": "mention.list",
    "output": {
      "$defs": {
        "MentionInfo": {
          "properties": {
            "blocks": {
              "description": "Paragraphs that carry it.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "count": {
              "description": "Separate spans (an embed is one).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "from": {
              "$ref": "#/$defs/Target",
              "description": "The entity whose prose mentions."
            },
            "kind": {
              "description": "`link` (an entity link in the text) or `embed` (an embedded\nmaterial).",
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/Target"
            }
          },
          "required": [
            "from",
            "to",
            "kind",
            "blocks",
            "count"
          ],
          "type": "object"
        },
        "Target": {
          "description": "A reference to an entity (relation end, comment or memory target).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "description": "`node`, `element`, `patch`, `category`, `storyline`, `comment`,\n`material`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "items": {
        "$ref": "#/$defs/MentionInfo"
      },
      "title": "Array_of_MentionInfo",
      "type": "array"
    },
    "summary": "List what prose mentions: entity links and embedded materials, from one entity's prose, to one entity, or in the whole book (live ends only, with paragraph and span counts, the most mentioned first; `limit` keeps the top rows)."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "node": {
          "description": "The chapter or idea whose prose changed.",
          "type": "string"
        }
      },
      "required": [
        "book",
        "node"
      ],
      "title": "CheckSourcesIn",
      "type": "object"
    },
    "kind": "command",
    "name": "patch.check_sources",
    "output": {
      "properties": {
        "invalidated": {
          "description": "Patches whose passage went missing now.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "restored": {
          "description": "Patches whose passage is back.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "invalidated",
        "restored"
      ],
      "title": "SourcesChecked",
      "type": "object"
    },
    "summary": "After a chapter's or idea's prose changed: mark the patches taken from it whose passage no longer occurs as invalidated, and unmark those whose passage is back. Follows the prose; not an author's step."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "$defs": {
        "AnchorBytes": {
          "description": "A comment's anchor as stored: the two Loro cursors dr-doc writes\n(`Cursor::encode()`, the start on the first anchored character, the end\non the last), each in base64 (standard alphabet, padded). The editor\nmoves these bytes between the book and the prose document unchanged.",
          "properties": {
            "end": {
              "type": "string"
            },
            "start": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        "Place": {
          "description": "Where to put something in an ordered list.",
          "oneOf": [
            {
              "const": "first",
              "description": "At the start.",
              "type": "string"
            },
            {
              "const": "last",
              "description": "At the end.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Right after the item with this id.",
              "properties": {
                "after": {
                  "type": "string"
                }
              },
              "required": [
                "after"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Right before the item with this id.",
              "properties": {
                "before": {
                  "type": "string"
                }
              },
              "required": [
                "before"
              ],
              "type": "object"
            }
          ]
        }
      },
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorBytes"
            },
            {
              "type": "null"
            }
          ],
          "description": "An anchor on the passage in `source`'s prose (dr-doc's two cursors,\nbase64, as `comment.reanchor` takes them)."
        },
        "body": {
          "default": "",
          "type": "string"
        },
        "book": {
          "type": "string"
        },
        "element": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it goes among the element's patches (last by default)."
        },
        "pos": {
          "description": "An exact position key and id (undo uses them).",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "The chapter or idea the passage comes from.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_block": {
          "description": "Its paragraph (needs `source`).",
          "type": [
            "string",
            "null"
          ]
        },
        "source_text": {
          "description": "The passage as it reads now.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "book",
        "element"
      ],
      "title": "PatchCreateIn",
      "type": "object"
    },
    "kind": "command",
    "name": "patch.create",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Add a patch to an element: a title (optional) and a body, floating or taken from a passage of a chapter or idea."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "description": "One entity of a book.",
      "properties": {
        "book": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "id"
      ],
      "title": "EntityIn",
      "type": "object"
    },
    "kind": "command",
    "name": "patch.delete",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Delete a patch at once (never refused): relations to it go and comments on it float, in the same commit; undo brings it all back."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "element": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "element"
      ],
      "title": "PatchListIn",
      "type": "object"
    },
    "kind": "query",
    "name": "patch.list",
    "output": {
      "$defs": {
        "PatchInfo": {
          "properties": {
            "anchored": {
              "description": "Whether it carries an anchor on the passage.",
              "type": "boolean"
            },
            "body": {
              "type": "string"
            },
            "element": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "invalidated_at": {
              "description": "Since when the passage no longer occurs in its source (Unix seconds).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "pos": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "description": "The chapter or idea the patch was taken from, while it exists.",
              "type": [
                "string",
                "null"
              ]
            },
            "source_block": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_text": {
              "description": "The passage as it read when the patch was taken.",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "element",
            "title",
            "body",
            "source",
            "source_block",
            "source_text",
            "anchored",
            "invalidated_at",
            "pos"
          ],
          "type": "object"
        }
      },
      "items": {
        "$ref": "#/$defs/PatchInfo"
      },
      "title": "Array_of_PatchInfo",
      "type": "array"
    },
    "summary": "List an element's patches: by their source chapter's reading order, then their own order; floating ones last. Invalidated ones are listed too."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "$defs": {
        "Place": {
          "description": "Where to put something in an ordered list.",
          "oneOf": [
            {
              "const": "first",
              "description": "At the start.",
              "type": "string"
            },
            {
              "const": "last",
              "description": "At the end.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Right after the item with this id.",
              "properties": {
                "after": {
                  "type": "string"
                }
              },
              "required": [
                "after"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Right before the item with this id.",
              "properties": {
                "before": {
                  "type": "string"
                }
              },
              "required": [
                "before"
              ],
              "type": "object"
            }
          ]
        }
      },
      "properties": {
        "book": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ]
        },
        "pos": {
          "description": "An exact position key (undo uses it); wins over `place`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "book",
        "id"
      ],
      "title": "PatchMoveIn",
      "type": "object"
    },
    "kind": "command",
    "name": "patch.move",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Move a patch among its element's patches (within the same source chapter the order is the patches' own)."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
