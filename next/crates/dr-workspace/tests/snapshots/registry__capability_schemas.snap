  {
    "access": "read",
    "book_version": 5,
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        }
      },
      "required": [
        "book"
      ],
      "title": "BookSequenceIn",
      "type": "object"
    },
    "kind": "query",
    "name": "book.sequence",
    "output": {
      "$defs": {
        "Below": {
          "description": "What lies below an entry (`下面` / `挂在这里`).",
          "properties": {
            "children": {
              "description": "Live entries living under it, in the folder's manual order, also while it is a lane in a\nview (`Some` only when `level` is on).",
              "items": {
                "$ref": "#/$defs/Entry"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "members": {
              "description": "Live entries validly belonging to it, in authoritative member order (`Some` only when `accept` is on).",
              "items": {
                "$ref": "#/$defs/Entry"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "settings": {
              "$ref": "#/$defs/LevelSettings"
            },
            "sources": {
              "additionalProperties": {
                "$ref": "#/$defs/SettingSource"
              },
              "description": "Where each resolved setting comes from.",
              "type": "object"
            }
          },
          "required": [
            "settings",
            "sources"
          ],
          "type": "object"
        },
        "Entry": {
          "properties": {
            "arrangements": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "This entry's own arrangement of a media module (`featured`, `grid`\nor `list`): `module_id -> arrangement`; a module not listed uses its\ntemplate's (`module.read` gives the effective one).",
              "type": "object"
            },
            "auto_link": {
              "default": false,
              "description": "The entry's own 「自动链接」 (`kernel-v5.md` §16): whether its title\nand aliases link by themselves, and whether the automatic links to it\nshow as links (`entry.set_auto_link`).",
              "type": "boolean"
            },
            "below": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Below"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What lies below an entry whose switch is on (`entry.get`, and\n`entry.list` with `below`): resolved settings with where each comes\nfrom, resident children and accepted members. Absent otherwise."
            },
            "created_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "deleted_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "fields": {
              "additionalProperties": {
                "additionalProperties": {
                  "$ref": "#/$defs/FieldValue"
                },
                "type": "object"
              },
              "description": "Values of `fields` modules: `module_id -> (field_id -> value)`.",
              "type": "object"
            },
            "id": {
              "type": "string"
            },
            "kv": {
              "additionalProperties": {
                "items": {
                  "$ref": "#/$defs/KvEntry"
                },
                "type": "array"
              },
              "description": "Rows of `kv` modules (`kv:<module_id>`): `module_id -> sorted KvEntry list`.",
              "type": "object"
            },
            "level": {
              "default": false,
              "description": "The entry's own switch (`层级`): whether entries can live under it.",
              "type": "boolean"
            },
            "mark": {
              "default": null,
              "description": "Optional per-entry badge/icon mark (`记号`); falls back to the active\ntemplate's `mark` when unset (`kernel-v5.md` §8).",
              "type": [
                "string",
                "null"
              ]
            },
            "media": {
              "additionalProperties": {
                "items": {
                  "$ref": "#/$defs/MediaItem"
                },
                "type": "array"
              },
              "default": {},
              "description": "Items of `media` modules (`media:<module_id>`): `module_id -> sorted MediaItem list`.",
              "type": "object"
            },
            "missing_files": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "description": "Image fields whose file is in Recently Deleted or not in the book:\n`module_id -> field ids`, shown as placeholders (the value stays).\nSet by readers, ignored on input.",
              "type": "object"
            },
            "name_conflict": {
              "default": null,
              "description": "Set by readers when this entry participates in auto-linking and its\ntitle or alias collides with an earlier auto-linked entry (`V3-AUTOLINK-NAME-UNIQUE`).",
              "type": [
                "string",
                "null"
              ]
            },
            "overrides": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LevelSettingsOverride"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Overrides of the settings for what lives below (kept, but not used,\nwhile the switch is off)."
            },
            "parent": {
              "description": "Raw parent entry in the `entries` tree (`None` at the root).\nList queries read an entry under one whose switch is off as living\nunder the nearest level.",
              "type": [
                "string",
                "null"
              ]
            },
            "pos": {
              "description": "Fractional-index position among siblings in the `entries` tree (`文稿顺序`).",
              "type": "string"
            },
            "primary": {
              "description": "Stored primary membership host; membership queries filter invalid records.",
              "type": [
                "string",
                "null"
              ]
            },
            "template": {
              "description": "The template shaping this entry (`None` = untemplated entry).",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "updated_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "parent",
            "pos",
            "title",
            "mark",
            "template",
            "level",
            "auto_link",
            "overrides",
            "fields",
            "kv",
            "media",
            "primary",
            "created_at",
            "updated_at",
            "deleted_at",
            "name_conflict"
          ],
          "type": "object"
        },
        "FieldValue": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "double",
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "KvEntry": {
          "properties": {
            "id": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "key",
            "value",
            "pos"
          ],
          "type": "object"
        },
        "LevelSettings": {
          "properties": {
            "accept": {
              "default": false,
              "description": "Whether entries may belong to this entry via `memberships` (`收别处的条目`);\nindependent of `level` and never inherited.",
              "type": "boolean"
            },
            "auto_link": {
              "default": false,
              "description": "Whether entries residing under this level participate in auto-linking\n(when their template is `linkable`).",
              "type": "boolean"
            },
            "default_template": {
              "default": null,
              "description": "Default template when creating a new entry under this level (`None` = blank).",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": "",
              "description": "Default workspace presentation mode for entries below this entry.",
              "type": "string"
            },
            "format_shortcuts": {
              "default": "",
              "description": "Editor formatting shortcut profile for prose under this level (`格式快捷输入`).",
              "type": "string"
            },
            "home": {
              "default": null,
              "description": "For entries with `accept == true`: which level entry newly created\nmembers reside under (`新条目住在`, never inherited).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "default_template",
            "display",
            "auto_link",
            "accept",
            "home",
            "format_shortcuts"
          ],
          "type": "object"
        },
        "LevelSettingsOverride": {
          "properties": {
            "accept": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "auto_link": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "default_template": {
              "description": "`None` inherits; `Some(None)` clears to no default template; `Some(Some(t))` sets `t`.",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "format_shortcuts": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "home": {
              "description": "`None` defers to the entry's template; `Some(None)` clears `home`; `Some(Some(id))` sets `home`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "display",
            "auto_link",
            "accept",
            "format_shortcuts"
          ],
          "type": "object"
        },
        "MediaItem": {
          "properties": {
            "asset": {
              "type": "string"
            },
            "caption": {
              "default": "",
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "missing": {
              "description": "Set by readers when `asset` is not registered in the book's `assets`\n(`MEDIA-AND-EMBED-ASSET-EXISTS`). Ignored on input.",
              "type": "boolean"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "asset",
            "caption",
            "pos"
          ],
          "type": "object"
        },
        "SequenceEntry": {
          "description": "One entry of the book sequence. The App numbers nothing: an author who\nwants chapter numbers writes them.",
          "properties": {
            "depth": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "entry": {
              "$ref": "#/$defs/Entry"
            },
            "prose": {
              "items": {
                "$ref": "#/$defs/SequenceProse"
              },
              "type": "array"
            }
          },
          "required": [
            "entry",
            "depth",
            "prose"
          ],
          "type": "object"
        },
        "SequenceProse": {
          "properties": {
            "doc": {
              "type": "string"
            },
            "in_book": {
              "type": "boolean"
            },
            "module": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "module",
            "name",
            "doc",
            "in_book"
          ],
          "type": "object"
        },
        "SettingSource": {
          "description": "Where one resolved setting comes from (the same precedence as its value).",
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "default",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "entry": {
                  "type": "string"
                },
                "kind": {
                  "const": "override",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "entry"
              ],
              "type": "object"
            },
            {
              "properties": {
                "entry": {
                  "type": "string"
                },
                "kind": {
                  "const": "template",
                  "type": "string"
                },
                "template": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "entry",
                "template"
              ],
              "type": "object"
            }
          ]
        }
      },
      "properties": {
        "entries": {
          "description": "The whole project read from the root, book prose only (empty when\nthe project has no book).",
          "items": {
            "$ref": "#/$defs/SequenceEntry"
          },
          "type": "array"
        },
        "has_book": {
          "type": "boolean"
        }
      },
      "required": [
        "has_book",
        "entries"
      ],
      "title": "BookSequenceOut",
      "type": "object"
    },
    "summary": "Read the ordered book sequence: the whole project from the root, book prose only (empty when the project has no book)."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
        "trashed": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "ListBooksIn",
      "type": "object"
    },
    "kind": "query",
    "name": "book.shelf",
    "output": {
      "$defs": {
        "ShelfBook": {
          "description": "One book as the bookshelf shows it.",
          "properties": {
            "chapters": {
              "description": "Live chapters, storylines and elements.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "created_at": {
              "description": "When the book was created (Unix seconds).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "daily_word_target": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "days_left": {
              "description": "… and the whole days left until then, rounded up (0: due now).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "deleted_at": {
              "description": "In Recently Deleted since (Unix seconds).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "elements": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "purge_at": {
              "description": "In Recently Deleted: when it goes for good (Unix seconds) …",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "storylines": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "subtitle": {
              "description": "The 「副标题」 project fact, trimmed, when it has a value.",
              "type": [
                "string",
                "null"
              ]
            },
            "summary": {
              "type": "string"
            },
            "trashed": {
              "type": "boolean"
            },
            "updated_at": {
              "description": "The newest stored change of any of its documents (Unix seconds).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "word_target": {
              "description": "The book's word target (`None`: turned off).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "words": {
              "description": "Words in the live chapters only (not ideas, elements or notes), as\nthe derived index counts them.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "summary",
            "trashed",
            "word_target",
            "daily_word_target",
            "created_at",
            "subtitle",
            "chapters",
            "storylines",
            "elements",
            "words",
            "updated_at",
            "deleted_at",
            "purge_at",
            "days_left"
          ],
          "type": "object"
        }
      },
      "items": {
        "$ref": "#/$defs/ShelfBook"
      },
      "title": "Array_of_ShelfBook",
      "type": "array"
    },
    "summary": "Everything the bookshelf shows, in one read: every book (not a template's working copy) with its counts, chapter words, creation, last change, and (in Recently Deleted) when it goes for good. Live books first, most recently changed first; then the trashed ones, most recently deleted first."
  },
