          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "kv": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/KvEntry"
            },
            "type": "array"
          },
          "description": "Rows of `kv` modules (`kv:<module_id>`): `module_id -> sorted KvEntry list`.",
          "type": "object"
        },
        "level": {
          "default": false,
          "description": "The entry's own switch (`层级`): whether entries can live under it.",
          "type": "boolean"
        },
        "mark": {
          "default": null,
          "description": "Optional per-entry badge/icon mark (`记号`); falls back to the active\ntemplate's `mark` when unset (`kernel-v5.md` §8).",
          "type": [
            "string",
            "null"
          ]
        },
        "media": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/MediaItem"
            },
            "type": "array"
          },
          "default": {},
          "description": "Items of `media` modules (`media:<module_id>`): `module_id -> sorted MediaItem list`.",
          "type": "object"
        },
        "missing_files": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Image fields whose file is in Recently Deleted or not in the book:\n`module_id -> field ids`, shown as placeholders (the value stays).\nSet by readers, ignored on input.",
          "type": "object"
        },
        "name_conflict": {
