          ],
          "type": "object"
        },
        "LinkedText": {
          "additionalProperties": false,
          "description": "Text with ordered, non-overlapping entry links. The saved spelling is the\nfallback when an entry cannot be resolved.",
          "properties": {
            "links": {
              "default": [],
              "items": {
                "$ref": "#/$defs/EntryTextLink"
              },
              "type": "array"
            },
