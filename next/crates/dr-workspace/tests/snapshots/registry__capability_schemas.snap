        "created_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "deleted_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "fields": {
          "additionalProperties": {
            "additionalProperties": {
