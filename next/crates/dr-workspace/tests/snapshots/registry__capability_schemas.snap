  {
    "access": "read",
    "book_version": 5,
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "entry": {
          "description": "The entry linked to.",
          "type": "string"
        },
        "from": {
          "default": 0,
          "description": "The first paragraph to return (0-based), from a previous page's `next`.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "limit": {
          "description": "At most this many paragraphs (default 20, at most 50).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
