            "format_shortcuts"
          ],
          "type": "object"
        },
        "LevelSettingsOverride": {
          "properties": {
            "accept": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "auto_link": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "default_template": {
              "description": "`None` inherits; `Some(None)` clears to no default template; `Some(Some(t))` sets `t`.",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "format_shortcuts": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "home": {
              "description": "`None` defers to the entry's template; `Some(None)` clears `home`; `Some(Some(id))` sets `home`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "display",
            "auto_link",
            "accept",
            "format_shortcuts"
          ],
          "type": "object"
        },
        "MediaItem": {
          "properties": {
