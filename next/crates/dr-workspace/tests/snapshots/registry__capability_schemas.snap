  },
  {
    "access": "read",
    "book_version": 5,
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "from": {
          "default": 0,
          "description": "The first hit to return (0-based), from a previous page's `next`.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "limit": {
          "description": "At most this many hits (default 20, at most 50).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "description": "A word or phrase, matched as written (case-insensitive), not split\ninto words.",
          "type": "string"
        },
        "trashed": {
          "default": false,
          "description": "Also search entries in Recently Deleted.",
          "type": "boolean"
        }
      },
      "required": [
        "book",
        "query"
      ],
      "title": "SearchIn",
      "type": "object"
    },
    "kind": "query",
    "name": "entry.search",
    "output": {
      "$defs": {
        "FoundIn": {
          "description": "What part of an entry a hit is in.",
          "oneOf": [
            {
              "const": "title",
              "description": "The entry's title.",
              "type": "string"
            },
            {
              "const": "field",
              "description": "A field of a fields module.",
              "type": "string"
            },
            {
              "const": "row",
              "description": "A row of a key/value module (its key and value).",
              "type": "string"
            },
            {
              "const": "patch",
              "description": "A record of a patches module (its title and text).",
              "type": "string"
            },
            {
              "const": "plot",
              "description": "A row or column label or a cell of a plot module.",
              "type": "string"
            },
            {
              "const": "prose",
              "description": "A paragraph of a prose module.",
              "type": "string"
            }
          ]
        },
        "SearchHit": {
          "description": "One place the query was found.",
          "properties": {
            "block_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "doc": {
              "description": "A prose hit's document (`body:<entry>/<module>`).",
              "type": [
                "string",
                "null"
              ]
            },
            "entry": {
              "type": "string"
            },
            "field": {
              "description": "A field hit's field id.",
              "type": [
                "string",
                "null"
              ]
            },
            "field_name": {
              "description": "A field hit's field name in the template.",
              "type": [
                "string",
                "null"
              ]
            },
            "in": {
              "$ref": "#/$defs/FoundIn"
            },
            "module": {
              "description": "The module the text is in; absent for a hit in the title.",
              "type": [
                "string",
                "null"
              ]
            },
            "module_name": {
              "description": "The module's name in the entry's template (absent for a module the\ntemplate no longer has).",
              "type": [
                "string",
                "null"
              ]
            },
            "paragraph": {
              "description": "A prose hit's paragraph (0-based, as prose.read numbers them).",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "snippet": {
              "description": "The match with the text around it.",
              "type": "string"
            },
            "title": {
              "description": "The entry's title.",
              "type": "string"
            },
            "trashed": {
              "description": "The entry is in Recently Deleted.",
              "type": "boolean"
            }
          },
          "required": [
            "entry",
            "title",
            "in",
            "snippet"
          ],
          "type": "object"
        }
      },
      "properties": {
        "hits": {
          "items": {
            "$ref": "#/$defs/SearchHit"
          },
          "type": "array"
        },
        "next": {
          "description": "The `from` of the next page; absent on the last page.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "hits"
      ],
      "title": "SearchOut",
      "type": "object"
    },
    "summary": "Search the book's entries for a word or phrase, matched as written (case-insensitive, not split into words): titles, field values, key/value rows, patches, plot cells and prose, not templates or comments. Hits come in manuscript order, each with its entry, its module and the text around the match; a prose hit (one per paragraph) also gives its document, paragraph number and block ID. At most `limit` hits (default 20, at most 50) from `from`; `next` is the `from` of the next page. Entries in Recently Deleted only with `trashed: true`. A hit is not a read of the prose."
  },
  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "properties": {
        "auto_link": {
          "description": "The entry's own 「自动链接」.",
          "type": "boolean"
        },
        "book": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "id",
        "auto_link"
      ],
      "title": "SetAutoLinkIn",
      "type": "object"
    },
    "kind": "command",
    "name": "entry.set_auto_link",
    "output": {
      "properties": {
        "auto_link": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "auto_link"
      ],
      "title": "SetAutoLinkOut",
      "type": "object"
    },
    "summary": "Turn an entry's own automatic linking (「自动链接」) on or off: whether its title and aliases link by themselves in the book's text, and whether the automatic links already pointing at it show as links. Turned off, those links read as plain text and their data stays; turned on, they show again and its names already written get linked in the background. Links picked with @ show either way. Refused when, turned on, one of its names is already another linked entry's."
  },
  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "properties": {
        "auto_link": {
