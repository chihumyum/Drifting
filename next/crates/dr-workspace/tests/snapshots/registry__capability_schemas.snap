        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorBytes"
            },
            {
              "type": "null"
            }
          ],
          "description": "The anchor as the editor holds it (dr-doc's encoding, base64);\n`null` removes the anchor (the comment stays on its paragraph or\nentity)."
        },
        "book": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "id",
        "anchor"
      ],
