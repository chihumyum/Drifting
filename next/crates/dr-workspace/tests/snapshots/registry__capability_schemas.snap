                "type": "string"
              },
              "type": "array"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "target_template": {
              "default": null,
              "description": "Optional target template filter when `field_type == \"entity_ref\"`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "field_type"
          ],
          "type": "object"
        },
        "FieldValue": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "double",
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "KvEntry": {
          "properties": {
            "id": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "key",
            "value"
          ],
          "type": "object"
        },
        "ModuleAgentConfig": {
          "properties": {
            "instructions": {
              "default": "",
              "description": "One-sentence instruction for the Agent when reading or writing this module.",
              "type": "string"
            },
            "read_tier": {
              "default": null,
              "description": "Context assembly tier (e.g. `\"summary\"`, `\"on_demand\"`, `\"full\"`).",
              "type": [
                "string",
                "null"
              ]
            },
            "writable": {
              "default": true,
              "description": "Whether the Agent may write to this module.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "ModuleConfig": {
          "properties": {
            "aliases_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies aliases for auto-linking.",
              "type": [
                "string",
                "null"
              ]
            },
            "arrangement": {
              "description": "For `media` modules: the default arrangement (`featured`, `grid`,\n`list`); entries may choose their own.",
              "type": [
                "string",
                "null"
              ]
            },
            "color_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the display color.",
              "type": [
                "string",
                "null"
              ]
            },
            "default_cols": {
              "default": 3,
              "description": "For `plot_grid` modules: initial column count (defaults to 3).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "default_rows": {
              "default": 3,
              "description": "For `plot_grid` modules: initial row count (defaults to 3).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "defs": {
              "default": [],
              "description": "For `fields` modules: ordered field definitions.",
              "items": {
                "$ref": "#/$defs/FieldDef"
              },
              "type": "array"
            },
            "in_book": {
              "default": true,
              "description": "For `prose` modules: whether this prose is part of the book (`成书`:\nexport, the book's word count, chapter numbering). On by default.",
              "type": "boolean"
            },
            "initial_kv": {
              "default": [],
              "description": "For `kv` modules: initial key/value rows copied into new entries of this template.",
              "items": {
                "$ref": "#/$defs/KvEntry"
              },
              "type": "array"
            },
            "module": {
              "description": "For `custom` modules: the module it draws (a module of mine, or one\nthe book already has a copy of; `custom-modules.md` §7).",
              "type": [
                "string",
                "null"
              ]
            },
            "portrait_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the portrait `AssetId`.",
              "type": [
                "string",
                "null"
              ]
            },
            "show_outline": {
              "default": false,
              "description": "For `prose` modules: whether H1/H2/H3 outline headings appear in the outline tree.",
              "type": "boolean"
            },
            "status_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the status badge.",
              "type": [
                "string",
                "null"
              ]
            },
            "summary_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the summary text.",
              "type": [
                "string",
                "null"
              ]
            },
            "task_todos": {
              "default": false,
              "description": "For `prose` modules: whether checklist items project into TODOs.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "ModuleSpec": {
          "properties": {
            "agent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModuleAgentConfig"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "config": {
              "$ref": "#/$defs/ModuleConfig",
              "default": {
                "aliases_field": null,
                "color_field": null,
                "default_cols": 3,
                "default_rows": 3,
                "defs": [],
                "in_book": true,
                "initial_kv": [],
                "portrait_field": null,
                "show_outline": false,
                "status_field": null,
                "summary_field": null,
                "task_todos": false
              }
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "name"
          ],
          "type": "object"
        }
      },
      "properties": {
        "book": {
          "type": "string"
        },
        "module": {
          "$ref": "#/$defs/ModuleSpec"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "template",
        "module"
      ],
      "title": "ModulePutIn",
      "type": "object"
    },
