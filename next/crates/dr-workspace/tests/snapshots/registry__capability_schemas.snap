        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Named",
      "type": "object"
    },
    "summary": "Add a material: a text note, or an image or PDF whose asset is registered."
