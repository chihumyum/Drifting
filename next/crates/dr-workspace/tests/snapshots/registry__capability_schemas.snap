            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "placements": {
          "description": "Further `(view, entry)` placements the same write changed (an order\nbeside a tie on the scale moves what is tied after it): each alone.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "primary": {
          "description": "Restore only the member's primary field, not its other metadata or home.",
          "type": "boolean"
        },
        "views": {
