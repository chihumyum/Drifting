              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "word_target": {
              "description": "The book's word target (`None`: turned off).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "words": {
              "description": "Words in the live chapters only (not ideas, elements or notes), as\nthe derived index counts them.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "name",
            "summary",
            "trashed",
            "word_target",
            "daily_word_target",
            "created_at",
            "subtitle",
