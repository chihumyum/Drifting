        },
        "KvEntry": {
          "properties": {
            "id": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "key",
            "value",
            "pos"
          ],
          "type": "object"
        },
        "ModuleAgentConfig": {
          "properties": {
            "instructions": {
              "default": "",
              "description": "One-sentence instruction for the Agent when reading or writing this module.",
              "type": "string"
            },
            "read_tier": {
              "default": null,
              "description": "Context assembly tier (e.g. `\"summary\"`, `\"on_demand\"`, `\"full\"`).",
              "type": [
                "string",
                "null"
              ]
            },
            "writable": {
              "default": true,
              "description": "Whether the Agent may write to this module.",
              "type": "boolean"
            }
          },
          "required": [
            "writable",
            "read_tier",
            "instructions"
          ],
          "type": "object"
        },
        "ModuleConfig": {
          "properties": {
            "aliases_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies aliases for auto-linking.",
              "type": [
                "string",
                "null"
              ]
            },
            "color_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the display color.",
              "type": [
                "string",
                "null"
              ]
            },
            "default_cols": {
              "default": 3,
              "description": "For `plot_grid` modules: initial column count (defaults to 3).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "default_rows": {
              "default": 3,
              "description": "For `plot_grid` modules: initial row count (defaults to 3).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "defs": {
              "default": [],
              "description": "For `fields` modules: ordered field definitions.",
              "items": {
                "$ref": "#/$defs/FieldDef"
              },
              "type": "array"
            },
            "in_book": {
              "default": true,
              "description": "For `prose` modules: whether this prose is part of the book (`成书`:\nexport, the book's word count, chapter numbering). On by default.",
              "type": "boolean"
            },
            "initial_kv": {
              "default": [],
              "description": "For `kv` modules: initial key/value rows copied into new entries of this template.",
              "items": {
                "$ref": "#/$defs/KvEntry"
              },
              "type": "array"
            },
            "portrait_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the portrait `AssetId`.",
              "type": [
                "string",
                "null"
              ]
            },
            "show_outline": {
              "default": false,
              "description": "For `prose` modules: whether H1/H2/H3 outline headings appear in the outline tree.",
              "type": "boolean"
            },
            "status_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the status badge.",
              "type": [
                "string",
                "null"
              ]
            },
            "summary_field": {
              "default": null,
              "description": "For `fields` modules: which field id supplies the summary text.",
              "type": [
                "string",
                "null"
              ]
            },
            "task_todos": {
              "default": false,
              "description": "For `prose` modules: whether checklist items project into TODOs.",
              "type": "boolean"
            }
          },
          "required": [
            "show_outline",
            "task_todos",
            "in_book",
            "defs",
            "aliases_field",
            "color_field",
            "status_field",
            "summary_field",
            "portrait_field",
            "initial_kv",
            "default_rows",
            "default_cols"
          ],
          "type": "object"
        },
        "ModuleSpec": {
          "properties": {
            "agent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModuleAgentConfig"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "config": {
              "$ref": "#/$defs/ModuleConfig",
              "default": {
                "aliases_field": null,
                "color_field": null,
                "default_cols": 3,
                "default_rows": 3,
                "defs": [],
                "in_book": true,
                "initial_kv": [],
                "portrait_field": null,
                "show_outline": false,
                "status_field": null,
                "summary_field": null,
                "task_todos": false
              }
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "name",
            "pos",
            "config",
            "agent"
          ],
          "type": "object"
        },
        "Summary": {
          "properties": {
            "definition": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModuleSpec"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "type": "string"
            },
            "prose_doc": {
              "type": [
                "string",
                "null"
              ]
            },
            "retained": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "definition",
            "retained",
            "prose_doc"
          ],
          "type": "object"
        }
      },
      "items": {
        "$ref": "#/$defs/Summary"
      },
      "title": "Array_of_Summary",
      "type": "array"
    },
    "summary": "List an entry's current and retained modules and their registered prose documents."
  },
  {
