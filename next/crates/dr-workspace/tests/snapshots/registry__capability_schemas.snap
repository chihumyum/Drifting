  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "$defs": {
        "Place": {
          "description": "Where to put something in an ordered list.",
          "oneOf": [
            {
              "const": "first",
              "description": "At the start.",
              "type": "string"
            },
            {
              "const": "last",
              "description": "At the end.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Right after the item with this id.",
              "properties": {
                "after": {
                  "type": "string"
                }
              },
              "required": [
                "after"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Right before the item with this id.",
              "properties": {
                "before": {
                  "type": "string"
                }
              },
              "required": [
                "before"
              ],
              "type": "object"
            }
          ]
        }
      },
      "description": "A field to add or change in a template.",
      "properties": {
        "book": {
          "type": "string"
        },
        "category": {
          "description": "The category, for a category's template.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "The field to change; omitted, or an id not in the template: a new\nfield (with that id).",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "default": "",
          "type": "string"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it goes (a new field goes last by default)."
        },
        "pos": {
          "description": "An exact position key (undo uses it); wins over `place`.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "default": "",
          "description": "A default or a hint, copied into new storylines or elements.",
          "type": "string"
        }
      },
      "required": [
        "book"
      ],
      "title": "TemplateFieldIn",
      "type": "object"
    },
    "kind": "command",
    "name": "category_template.put",
