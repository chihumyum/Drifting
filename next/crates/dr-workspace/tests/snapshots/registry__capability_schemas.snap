              "format": "int64",
              "type": "integer"
            },
            "kept": {
              "description": "Exempt from thinning and the 30 days.",
              "type": "boolean"
            },
            "kind": {
              "description": "Why it was taken: `auto` (every 15 minutes of writing), `close`\n(the document closed), `restore` (just before a restore), `agent`\n(before an Agent turn wrote), `import` (from the 0.1 library), or\n`other`.",
              "type": "string"
            },
            "label": {
              "description": "The label as stored (`periodic`, `agent:<session>/<turn>`, …).",
              "type": "string"
            },
            "title": {
              "description": "The owner's title (or name) then, when known.",
              "type": [
                "string",
                "null"
              ]
            },
            "ts": {
              "description": "When (ms since the epoch).",
              "format": "int64",
              "type": "integer"
            },
            "words": {
              "description": "Words in the prose then.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "ts",
            "kind",
            "label",
            "words",
            "title",
            "excerpt",
            "kept"
          ],
          "type": "object"
        },
        "PreviewParagraph": {
          "description": "One paragraph of a preview.",
          "properties": {
            "heading": {
              "description": "1, 2 or 3 for H1/H2/H3; `None` for body text.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
