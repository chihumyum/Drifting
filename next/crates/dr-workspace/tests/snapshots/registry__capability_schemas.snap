    "output": {
      "$defs": {
        "SearchHitInfo": {
          "properties": {
            "block_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "doc": {
              "description": "The owner's prose document.",
              "type": "string"
            },
            "field": {
              "description": "Where the match is: `body` (the prose), `title`, `summary`,\n`description` (a material's) or `patch` (one of an element's\npatches, its title or its text).",
              "type": "string"
            },
            "kind": {
              "description": "What owns the text: `chapter`, `idea`, `element`, `storyline`,\n`category`, `material`.",
              "type": "string"
            },
            "match_len": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "offset": {
              "description": "Character offset of the match in its paragraph or field.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "owner": {
              "type": "string"
            },
            "paragraph": {
              "description": "The paragraph of the prose (0-based); body hits only.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "snippet": {
              "description": "The match with a little context, on one line.",
              "type": "string"
            },
            "snippet_match": {
              "description": "Where the match starts in `snippet` and how long it is, in\ncharacters.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "title": {
              "description": "The owner's title or name.",
              "type": "string"
            }
          },
          "required": [
            "doc",
            "kind",
            "owner",
            "title",
            "field",
            "block_id",
            "paragraph",
            "offset",
            "snippet",
            "snippet_match",
            "match_len"
          ],
          "type": "object"
        }
      },
      "items": {
        "$ref": "#/$defs/SearchHitInfo"
      },
      "title": "Array_of_SearchHitInfo",
      "type": "array"
    },
    "summary": "Search a book: titles, summaries, prose, material descriptions and element patches (chapters in reading order first, then ideas, elements, storylines, categories, materials). One- and two-character queries work."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
