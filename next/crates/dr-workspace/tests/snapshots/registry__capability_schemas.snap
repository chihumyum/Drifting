          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "session"
      ],
      "title": "AgentIn",
      "type": "object"
    },
    "kind": "command",
    "name": "history.undo_agent",
    "output": {
      "$defs": {
        "Conflict": {
          "properties": {
            "field": {
              "description": "The field left alone, for a book entity.",
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": "string"
            },
            "what": {
              "description": "A prose document id, or `<collection>/<id>` of a book entity.",
              "type": "string"
            }
          },
          "required": [
            "what",
            "reason"
          ],
          "type": "object"
        },
        "EntityKey": {
          "description": "One entity of a book document: its collection (the root container's\nname, e.g. `nodes`, `relations`, `drift_groups`; `meta` with a field name\nas id) and id.",
          "properties": {
            "collection": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "collection",
            "id"
          ],
          "type": "object"
        }
      },
      "properties": {
        "conflicts": {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "type": "array"
        },
        "restored": {
          "items": {
            "$ref": "#/$defs/EntityKey"
          },
          "type": "array"
        },
        "reverted_prose": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "trashed": {
          "items": {
            "$ref": "#/$defs/EntityKey"
