    },
    "kind": "query",
    "name": "book.word_counts",
    "output": {
      "$defs": {
        "Count": {
          "description": "Words and characters.",
          "properties": {
            "chars": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "words": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "words",
            "chars"
          ],
          "type": "object"
        },
        "DocCount": {
          "description": "One prose document's count.",
          "properties": {
            "chars": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "counted": {
              "description": "The derived index has counted it (false: still counting; the count\nis 0 then).",
              "type": "boolean"
            },
            "doc": {
              "description": "Its prose document.",
              "type": "string"
            },
            "id": {
              "description": "The chapter's or idea's id.",
              "type": "string"
            },
            "storylines": {
              "description": "A chapter's storylines.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "words": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "doc",
            "words",
            "chars",
            "counted",
            "storylines"
          ],
          "type": "object"
        },
        "StorylineCount": {
          "description": "Words and characters.",
          "properties": {
            "chapters": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "chars": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "counted": {
              "description": "Every one of its chapters is counted.",
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "words": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "words",
            "chars",
            "chapters",
            "counted"
          ],
          "type": "object"
        }
      },
      "properties": {
        "book": {
          "$ref": "#/$defs/Count",
          "description": "The book: its live chapters."
        },
        "chapters": {
          "description": "Live chapters, in reading order.",
          "items": {
            "$ref": "#/$defs/DocCount"
          },
          "type": "array"
        },
        "counted": {
          "description": "Every chapter is counted.",
          "type": "boolean"
        },
        "daily_word_target": {
          "description": "Words per day (`None`: turned off).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "ideas": {
          "description": "Live ideas (构想).",
          "items": {
            "$ref": "#/$defs/DocCount"
          },
          "type": "array"
        },
        "storylines": {
          "description": "Live storylines, in their order.",
          "items": {
            "$ref": "#/$defs/StorylineCount"
          },
          "type": "array"
        },
        "word_target": {
          "description": "The book's word target (`None`: turned off).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "chapters",
        "ideas",
        "storylines",
        "book",
        "counted",
        "word_target",
        "daily_word_target"
      ],
      "title": "WordCountsOut",
      "type": "object"
    },
    "summary": "Word counts of a book from the derived index: each chapter, idea and storyline, the book (its chapters), and the word targets."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "days": {
          "description": "How many days to list, ending today (default 7, at most 400).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "device": {
          "description": "This device's writing-day key: its own words for today are returned\ntoo.",
          "type": [
            "string",
            "null"
          ]
        },
        "today": {
          "description": "Today in the writer's own calendar, `YYYY-MM-DD`.",
          "type": "string"
        }
      },
      "required": [
        "book",
        "today"
      ],
      "title": "WritingDaysIn",
      "type": "object"
    },
    "kind": "query",
    "name": "book.writing_days",
    "output": {
      "$defs": {
        "DayWords": {
          "properties": {
            "day": {
              "type": "string"
            },
            "words": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "day",
            "words"
          ],
          "type": "object"
        }
      },
      "properties": {
        "active_days": {
          "description": "Days with words among the last thirty, today included.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "daily_word_target": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "days": {
          "description": "The days asked for, oldest first, every day listed (0 when nothing\nwas written), summed over devices.",
          "items": {
            "$ref": "#/$defs/DayWords"
          },
          "type": "array"
        },
        "mine_today": {
          "description": "`device`'s own words today (0 without one).",
          "format": "int64",
          "type": "integer"
        },
        "streak": {
          "description": "Consecutive days with words, ending today (0 when today has none).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "streak_before": {
          "description": "Consecutive days with words, ending yesterday (the streak today's\nfirst words continue).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "today": {
          "format": "int64",
          "type": "integer"
        },
        "week": {
          "description": "The last seven days, today included.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "days",
        "today",
        "mine_today",
        "week",
        "active_days",
        "streak",
        "streak_before",
        "daily_word_target"
      ],
      "title": "WritingDaysOut",
      "type": "object"
    },
    "summary": "A book's writing days: words written per day (all devices), today, the last seven days, active days and the streak."
  },
  {
