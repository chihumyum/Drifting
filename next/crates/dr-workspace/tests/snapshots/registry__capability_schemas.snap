        "active_days",
        "streak",
        "streak_before",
        "daily_word_target"
      ],
      "title": "WritingDaysOut",
      "type": "object"
    },
    "summary": "A book's writing days: words written per day (all devices), today, the last seven days, active days and the streak."
  },
  {
    "access": "read",
    "book_version": 4,
    "concurrency": "shared",
    "input": {
      "$defs": {
        "CommentTargetV3": {
          "description": "A v3 comment target. Old structural kinds are not accepted by v3 writes.",
