    "kind": "query",
    "name": "history.preview",
    "output": {
      "$defs": {
        "HistoryPoint": {
          "description": "One history point of a prose document.",
          "properties": {
            "excerpt": {
              "description": "The prose's first characters then, whitespace collapsed (at most\n[`EXCERPT_CHARS`]), as the 0.1 history list showed them.",
              "type": "string"
            },
            "id": {
