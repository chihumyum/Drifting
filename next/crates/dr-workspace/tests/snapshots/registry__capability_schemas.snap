  {
    "access": "write",
    "book_version": 5,
    "concurrency": "library",
    "input": {
      "$defs": {
        "ProjectTemplateCredit": {
          "description": "A template's credit: its author's name only (no homepage, no 「改自」;\nan old caller's extra keys are ignored).",
          "properties": {
            "author": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "TemplateAgentConfig": {
          "properties": {
            "description": {
              "default": "",
              "description": "One-sentence description of what this template is and when to use it.",
              "type": "string"
            },
            "instructions": {
              "default": "",
              "description": "Detailed instructions on what to pay attention to when reading or writing.",
              "type": "string"
            },
            "name": {
              "default": "",
              "description": "Name the Agent uses for entries of this template.",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateAgentConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "The words for the Agent the template carries (`project.agent`):\nleft out, the project's own; `null`, none; given, these (the\nproject keeps its own either way). A working copy refuses it: its\ntemplate's are the copy's project's (`project.update`'s `agent`)."
        },
        "book": {
          "type": "string"
        },
        "credit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectTemplateCredit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional author attribution (`credit`: the author's name). Nothing is\nfilled in from `project.source`."
        },
        "description": {
          "description": "Left out when replacing: the replaced template keeps its own. A\nworking copy refuses it: its template's is the copy's profile\n(`project.update`'s `summary`).",
          "type": [
            "string",
            "null"
          ]
        },
        "exclude_skeleton": {
          "default": [],
          "description": "Unlocked skeleton entries (`level` or `accept` on) to exclude from the template.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "locale": {
          "description": "Optional BCP-47 locale tag (defaults to `\"zh-CN\"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The template's name. Needed for a new template; replacing one\n(`replace`) without it keeps the name that one has. A working copy\nrefuses it: its template is named after the copy's book\n(`project.update`'s `name`).",
          "type": [
            "string",
            "null"
          ]
        },
        "replace": {
          "description": "Optional existing `project-template:<id>` to replace (`revision` increments by 1).",
          "type": [
            "string",
            "null"
          ]
        },
        "sample_entries": {
          "default": [],
          "description": "Live entries whose content (`fields`, `kv`, `arrangements`, `prose`, `memberships`, `placements`) is carried as sample content.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "view_pins": {
          "default": [],
          "description": "Live timeline views whose time pins are carried.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "book"
      ],
      "title": "ProjectTemplateSaveIn",
      "type": "object"
    },
    "kind": "command",
    "name": "project_template.save",
    "output": {
      "$defs": {
        "ProjectTemplateCredit": {
          "description": "A template's credit: its author's name only (no homepage, no 「改自」;\nan old caller's extra keys are ignored).",
          "properties": {
            "author": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "description": "Summary card of a saved project template in `project-template:<id>`.",
