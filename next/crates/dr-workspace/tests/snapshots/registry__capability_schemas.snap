            "integer",
            "null"
          ]
        },
        "credit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectTemplateCredit"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "entry_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "has_book": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "description": "`\"own\"` (saved from a project on this library) or `\"file\"` (imported from `.driftingtemplate`).",
          "type": "string"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "template_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "updated_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "origin",
        "revision",
        "locale",
        "has_book",
        "template_count",
        "entry_count"
      ],
      "title": "ProjectTemplateSummary",
      "type": "object"
    },
    "summary": "Save a project's structure and selected sample items as a project template, or a template's working copy over that template."
  },
