              "default": false,
              "description": "Whether entries may belong to this entry via `memberships` (`收别处的条目`);\nindependent of `level` and never inherited.",
              "type": "boolean"
            },
            "auto_link": {
              "default": false,
              "description": "Whether entries residing under this level participate in auto-linking\n(when their template is `linkable`).",
              "type": "boolean"
            },
            "default_template": {
              "default": null,
              "description": "Default template when creating a new entry under this level (`None` = blank).",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": "",
              "description": "Default workspace presentation mode for entries below this entry.",
              "type": "string"
            },
