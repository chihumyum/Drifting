  {
    "access": "read",
    "book_version": 4,
    "concurrency": "shared",
    "input": {
      "properties": {
        "book": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "entry",
        "module"
      ],
      "title": "In",
      "type": "object"
    },
    "kind": "query",
    "name": "module.read",
    "output": {
      "$defs": {
        "Below": {
          "description": "What lies below a level (`下面`).",
          "properties": {
            "children": {
              "description": "Live entries living under it, in manuscript order.",
              "items": {
                "$ref": "#/$defs/Entry"
              },
              "type": "array"
            },
            "members": {
              "description": "Live entries validly belonging to it, in the memberships' order.",
              "items": {
                "$ref": "#/$defs/Entry"
              },
              "type": "array"
            },
            "settings": {
              "$ref": "#/$defs/LevelSettings"
            },
            "sources": {
              "additionalProperties": {
                "$ref": "#/$defs/SettingSource"
              },
              "description": "Where each resolved setting comes from.",
              "type": "object"
            }
          },
          "required": [
            "settings",
            "sources",
            "children",
            "members"
          ],
          "type": "object"
        },
        "Cell": {
          "properties": {
            "column": {
              "type": "string"
            },
            "row": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "row",
            "column",
            "text"
          ],
          "type": "object"
        },
        "Entry": {
          "properties": {
            "below": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Below"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What lies below an entry whose switch is on (`entry.get`, and\n`entry.list` with `below`): resolved settings with where each comes\nfrom, resident children and accepted members. Absent otherwise."
            },
            "created_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "deleted_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "fields": {
              "additionalProperties": {
                "additionalProperties": {
                  "$ref": "#/$defs/FieldValue"
                },
                "type": "object"
              },
              "description": "Values of `fields` modules: `module_id -> (field_id -> value)`.",
              "type": "object"
            },
            "id": {
              "type": "string"
            },
            "kv": {
              "additionalProperties": {
                "items": {
                  "$ref": "#/$defs/KvEntry"
                },
                "type": "array"
              },
              "description": "Rows of `kv` modules (`kv:<module_id>`): `module_id -> sorted KvEntry list`.",
              "type": "object"
            },
            "layout": {
              "$ref": "#/$defs/EntryLayout"
            },
            "level": {
              "default": false,
              "description": "The entry's own switch (`层级`): whether entries can live under it.",
              "type": "boolean"
            },
            "name_conflict": {
              "default": null,
              "description": "Set by readers when this entry participates in auto-linking and its\ntitle or alias collides with an earlier auto-linked entry (`V3-AUTOLINK-NAME-UNIQUE`).",
              "type": [
                "string",
                "null"
              ]
            },
            "overrides": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LevelSettingsOverride"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Overrides of the settings for what lives below (kept, but not used,\nwhile the switch is off)."
            },
            "parent": {
              "description": "Raw parent entry in the `entries` tree (`None` at the root).\nList queries apply the leaf-parent tolerance to their filtering.",
              "type": [
                "string",
                "null"
              ]
            },
            "pos": {
              "description": "Fractional-index position among siblings in the `entries` tree (`文稿顺序`).",
              "type": "string"
            },
            "primary": {
              "description": "Stored primary membership host; membership queries filter invalid records.",
              "type": [
                "string",
                "null"
              ]
            },
            "template": {
              "description": "The template shaping this entry (`None` = untemplated entry).",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "updated_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "parent",
            "pos",
            "title",
            "template",
            "level",
            "overrides",
            "fields",
            "kv",
            "primary",
            "layout",
            "created_at",
            "updated_at",
            "deleted_at",
            "name_conflict"
          ],
          "type": "object"
        },
        "EntryLayout": {
          "properties": {
            "board": {
              "default": null,
              "description": "Position on a board / island canvas.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "double",
                  "type": "number"
                },
                {
                  "format": "double",
                  "type": "number"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            },
            "grid": {
              "default": null,
              "description": "Grid coordinates `(col, row)` in a grid layout.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "int64",
                  "type": "integer"
                },
                {
                  "format": "int64",
                  "type": "integer"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            },
            "relation_graph": {
              "default": null,
              "description": "Pinned position in the relation graph.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "double",
                  "type": "number"
                },
                {
                  "format": "double",
                  "type": "number"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "board",
            "grid",
            "relation_graph"
          ],
          "type": "object"
        },
        "FieldDef": {
          "properties": {
            "default_value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FieldValue"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional initial value copied into newly created entries of this template."
            },
            "field_type": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "options": {
              "default": [],
              "description": "Candidate options for `select` and `multi_select`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "target_template": {
              "default": null,
              "description": "Optional target template filter when `field_type == \"entity_ref\"`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "field_type",
            "options",
            "target_template",
            "pos"
          ],
          "type": "object"
        },
        "FieldValue": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "format": "double",
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "Grid": {
          "properties": {
            "cell_h": {
              "format": "double",
              "type": "number"
            },
            "cell_w": {
              "format": "double",
              "type": "number"
            },
            "cells": {
              "items": {
                "$ref": "#/$defs/Cell"
              },
              "type": "array"
            },
            "columns": {
              "items": {
                "$ref": "#/$defs/Line"
              },
              "type": "array"
            },
            "rows": {
              "items": {
                "$ref": "#/$defs/Line"
              },
              "type": "array"
            }
          },
          "required": [
            "cell_w",
            "cell_h",
            "rows",
            "columns",
            "cells"
          ],
          "type": "object"
        },
        "KvEntry": {
          "properties": {
            "id": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "pos": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "key",
            "value",
            "pos"
          ],
          "type": "object"
        },
        "LevelSettings": {
          "properties": {
            "accept": {
              "default": false,
              "description": "Whether entries residing elsewhere may belong to this level via `memberships` (`收别处的条目`).\nSwimlane levels (`lane == true`) always accept memberships.",
              "type": "boolean"
            },
            "auto_link": {
              "default": false,
              "description": "Whether entries residing in or belonging to this level participate in\nauto-linking (when their template is `linkable`).",
              "type": "boolean"
            },
            "default_template": {
              "default": null,
              "description": "Default template when creating a new entry under this level (`None` = blank).",
              "type": [
                "string",
