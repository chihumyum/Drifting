        },
        "level": {
          "default": null,
          "description": "The new entry's switch; the template's default when omitted.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "parent": {
          "default": null,
          "description": "The level from which creation is requested; its default template and home apply.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "default": null,
          "type": [
