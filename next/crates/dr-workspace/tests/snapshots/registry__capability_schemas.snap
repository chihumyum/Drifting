          "default": false,
          "description": "Also list paragraphs of entries in Recently Deleted.",
          "type": "boolean"
        }
      },
      "required": [
        "book",
        "entry"
      ],
      "title": "MentionsIn",
      "type": "object"
    },
    "kind": "query",
    "name": "entry.mentions",
    "output": {
      "$defs": {
        "Mention": {
          "description": "One paragraph that links to the entry.",
          "properties": {
            "block_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "doc": {
              "description": "The prose document (`body:<entry>/<module>`).",
              "type": "string"
            },
            "entry": {
              "description": "The entry whose prose it is.",
              "type": "string"
            },
            "links": {
              "description": "Separate links to the entry in the paragraph.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "module": {
              "type": "string"
            },
            "module_name": {
              "description": "The module's name in the entry's template (absent for a module the\ntemplate no longer has).",
              "type": [
                "string",
                "null"
              ]
            },
            "paragraph": {
              "description": "The paragraph (0-based, as prose.read numbers them); absent when\nthe index cannot place it.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "snippet": {
              "description": "The paragraph's text around the entry's name (from its start when\nthe linked text is not one of the entry's names).",
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "trashed": {
              "description": "The entry the prose belongs to is in Recently Deleted.",
              "type": "boolean"
            }
          },
          "required": [
            "entry",
            "title",
            "module",
            "doc",
            "links",
            "snippet"
          ],
          "type": "object"
        }
      },
      "properties": {
        "entry": {
          "description": "The entry linked to and its title.",
          "type": "string"
        },
        "links": {
          "description": "Links in all (a paragraph can hold several).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "mentions": {
          "items": {
            "$ref": "#/$defs/Mention"
          },
          "type": "array"
        },
        "next": {
          "description": "The `from` of the next page; absent on the last page.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "total": {
          "description": "Paragraphs in all (every page).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "entry",
        "title",
        "total",
        "links",
        "mentions"
      ],
      "title": "MentionsOut",
      "type": "object"
    },
    "summary": "List the paragraphs of the book's prose that link to an entry (its name or an alias linked automatically, counted while the entry's own automatic linking and the author's setting are on, or a link the author picked with @, always counted), in manuscript order, each with the entry and module it is in, its document, paragraph number and block ID, how many links to the entry it holds and the text around the entry's name. `total` counts the paragraphs, `links` the links. At most `limit` paragraphs (default 20, at most 50) from `from`; `next` is the `from` of the next page. Paragraphs in entries in Recently Deleted only with `trashed: true`. Text that names the entry without a link is found with entry.search."
  },
  {
    "access": "write",
    "book_version": 5,
