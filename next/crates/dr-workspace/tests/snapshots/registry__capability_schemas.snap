    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Move a book to the trash (restorable; storage deletes it for good later)."
