            "string",
            "null"
          ]
        },
        "summary": {
          "default": "",
          "type": "string"
        },
        "text": {
          "description": "Initial text; a newline starts a new paragraph.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": "",
          "description": "A taken title gets a ` 2` suffix; empty becomes \"Untitled\".",
          "type": "string"
        }
      },
      "required": [
        "book"
      ],
      "title": "ChapterCreateIn",
      "type": "object"
    },
