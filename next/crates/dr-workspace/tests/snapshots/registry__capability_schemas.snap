          "type": "string"
        },
        "usages": {
          "default": true,
          "description": "List where the file is used (the default). `false` reads only the\nrecord: a caller showing one embedded file does not pay for scanning\nevery entry and prose index of the book, and `usages` comes back empty.",
          "type": "boolean"
        }
      },
      "required": [
        "book",
        "id"
      ],
