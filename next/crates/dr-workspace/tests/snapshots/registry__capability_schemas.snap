  {
    "access": "write",
    "book_version": 4,
    "concurrency": "book",
    "input": {
      "$defs": {
        "EntryLayout": {
          "properties": {
            "board": {
              "default": null,
              "description": "Position on a board / island canvas.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "double",
                  "type": "number"
                },
                {
                  "format": "double",
                  "type": "number"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            },
            "grid": {
              "default": null,
              "description": "Grid coordinates `(col, row)` in a grid layout.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "int64",
                  "type": "integer"
                },
                {
                  "format": "int64",
                  "type": "integer"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            },
            "relation_graph": {
              "default": null,
              "description": "Pinned position in the relation graph.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "double",
                  "type": "number"
                },
                {
                  "format": "double",
                  "type": "number"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "LevelSettingsOverride": {
          "properties": {
            "accept": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "auto_link": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "default_template": {
              "description": "`None` inherits; `Some(None)` clears to no default template; `Some(Some(t))` sets `t`.",
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "format_shortcuts": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "home": {
              "description": "`None` inherits; `Some(None)` means reside in this level itself; `Some(Some(id))` sets `home`.",
              "type": [
                "string",
                "null"
              ]
            },
            "is_manuscript": {
              "default": null,
              "type": [
                "boolean",
                "null"
              ]
            },
            "lane": {
              "default": null,
              "description": "`None` leaves it to the template (on an entry) or off (on a template).",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "properties": {
        "book": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntryLayout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "overrides": {
          "anyOf": [
            {
              "$ref": "#/$defs/LevelSettingsOverride"
            },
            {
              "type": "null"
            }
          ]
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "book",
        "id"
      ],
      "title": "UpdateIn",
      "type": "object"
    },
    "kind": "command",
    "name": "entry.update",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Rename an entry, switch its template or change the overrides of what lives below it, without deleting retained content or touching its switch."
  },
  {
    "access": "write",
    "book_version": 4,
    "concurrency": "book",
    "input": {
