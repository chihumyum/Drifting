            "text"
          ],
          "type": "object"
        }
      },
      "properties": {
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/PreviewParagraph"
          },
          "type": "array"
        },
        "point": {
          "$ref": "#/$defs/HistoryPoint"
        },
        "same_as_now": {
          "description": "Whether the prose then is the prose now (restoring changes no text).",
          "type": "boolean"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "The owner's title (or name) then; `None` when it is not known (no\nbook version with the point, or the owner did not exist yet).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "point",
        "title",
        "summary",
        "paragraphs",
        "same_as_now"
      ],
      "title": "HistoryPreviewOut",
      "type": "object"
    },
