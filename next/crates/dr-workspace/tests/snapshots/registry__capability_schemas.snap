        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Put a comment's anchor back where the editor's undo brought its text back (the author's change, synced; it follows the editor's undo, so it is not an entry of the object-level undo)."
  },
