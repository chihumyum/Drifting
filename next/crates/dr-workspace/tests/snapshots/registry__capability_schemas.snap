  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "description": "A prose document.",
      "properties": {
        "doc": {
          "description": "`node:<id>`, `element:<id>`, `storyline:<id>`, `category:<id>` or\n`material:<id>`.",
          "type": "string"
        }
      },
      "required": [
        "doc"
      ],
      "title": "DocIn",
      "type": "object"
    },
    "kind": "query",
    "name": "history.points",
    "output": {
      "$defs": {
        "HistoryPoint": {
          "description": "One history point of a prose document.",
          "properties": {
            "excerpt": {
              "description": "The prose's first characters then, whitespace collapsed (at most\n[`EXCERPT_CHARS`]), as the 0.1 history list showed them.",
              "type": "string"
            },
            "id": {
              "description": "Pass it to `history.preview` and `history.restore_point`.",
              "format": "int64",
              "type": "integer"
            },
            "kept": {
              "description": "Exempt from thinning and the 30 days.",
              "type": "boolean"
            },
            "kind": {
              "description": "Why it was taken: `auto` (every 15 minutes of writing), `close`\n(the document closed), `restore` (just before a restore), `agent`\n(before an Agent turn wrote), `import` (from the 0.1 library), or\n`other`.",
              "type": "string"
            },
            "label": {
              "description": "The label as stored (`periodic`, `agent:<session>/<turn>`, …).",
              "type": "string"
            },
            "title": {
              "description": "The owner's title (or name) then, when known.",
              "type": [
                "string",
                "null"
              ]
            },
            "ts": {
              "description": "When (ms since the epoch).",
              "format": "int64",
              "type": "integer"
            },
            "words": {
              "description": "Words in the prose then.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "ts",
            "kind",
            "label",
            "words",
            "title",
            "excerpt",
            "kept"
          ],
          "type": "object"
        }
      },
      "properties": {
        "doc": {
          "type": "string"
        },
        "points": {
          "description": "Newest first.",
          "items": {
            "$ref": "#/$defs/HistoryPoint"
          },
          "type": "array"
        },
        "words": {
          "description": "Words in the prose now.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "doc",
        "words",
        "points"
      ],
      "title": "HistoryPointsOut",
      "type": "object"
    },
    "summary": "List a prose document's history points (kept 30 days, at most one every 15 minutes of writing), newest first, with the words at each."
  },
  {
    "access": "read",
    "concurrency": "shared",
    "input": {
      "properties": {
        "doc": {
          "type": "string"
        },
        "point": {
          "description": "A point's id from `history.points`.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "doc",
        "point"
      ],
      "title": "PointIn",
      "type": "object"
    },
    "kind": "query",
    "name": "history.preview",
    "output": {
      "$defs": {
        "HistoryPoint": {
          "description": "One history point of a prose document.",
          "properties": {
            "excerpt": {
              "description": "The prose's first characters then, whitespace collapsed (at most\n[`EXCERPT_CHARS`]), as the 0.1 history list showed them.",
              "type": "string"
            },
            "id": {
              "description": "Pass it to `history.preview` and `history.restore_point`.",
              "format": "int64",
              "type": "integer"
            },
            "kept": {
              "description": "Exempt from thinning and the 30 days.",
              "type": "boolean"
            },
            "kind": {
              "description": "Why it was taken: `auto` (every 15 minutes of writing), `close`\n(the document closed), `restore` (just before a restore), `agent`\n(before an Agent turn wrote), `import` (from the 0.1 library), or\n`other`.",
              "type": "string"
            },
            "label": {
              "description": "The label as stored (`periodic`, `agent:<session>/<turn>`, …).",
              "type": "string"
            },
            "title": {
              "description": "The owner's title (or name) then, when known.",
              "type": [
                "string",
                "null"
              ]
            },
            "ts": {
              "description": "When (ms since the epoch).",
              "format": "int64",
              "type": "integer"
            },
            "words": {
              "description": "Words in the prose then.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "ts",
            "kind",
            "label",
            "words",
            "title",
            "excerpt",
            "kept"
          ],
          "type": "object"
        },
        "PreviewParagraph": {
          "description": "One paragraph of a preview.",
          "properties": {
            "heading": {
              "description": "1, 2 or 3 for H1/H2/H3; `None` for body text.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "heading",
            "text"
          ],
          "type": "object"
        }
      },
      "properties": {
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/PreviewParagraph"
          },
          "type": "array"
        },
        "point": {
          "$ref": "#/$defs/HistoryPoint"
        },
        "same_as_now": {
          "description": "Whether the prose then is the prose now (restoring changes no text).",
          "type": "boolean"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "The owner's title (or name) then; `None` when it is not known (no\nbook version with the point, or the owner did not exist yet).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "point",
        "title",
        "summary",
        "paragraphs",
        "same_as_now"
      ],
      "title": "HistoryPreviewOut",
      "type": "object"
    },
    "summary": "Read a prose document as it was at a history point: its paragraphs (with H1/H2/H3 levels) and its owner's title and summary then."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "$defs": {
        "EntityKey": {
          "description": "One entity of a book document: its collection (the root container's\nname, e.g. `nodes`, `relations`, `drift_groups`; `meta` with a field name\nas id) and id.",
          "properties": {
            "collection": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "collection",
            "id"
          ],
          "type": "object"
        }
      },
      "properties": {
        "at": {
          "description": "The book document's version to restore from (hex of Loro frontiers).",
          "type": "string"
        },
        "book": {
          "type": "string"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/EntityKey"
          },
          "type": "array"
        }
      },
      "required": [
        "book",
        "at",
        "entities"
      ],
      "title": "RestoreIn",
      "type": "object"
    },
    "kind": "command",
    "name": "history.restore_entities",
    "output": {
      "$defs": {
        "EntityKey": {
          "description": "One entity of a book document: its collection (the root container's\nname, e.g. `nodes`, `relations`, `drift_groups`; `meta` with a field name\nas id) and id.",
          "properties": {
            "collection": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "collection",
            "id"
          ],
          "type": "object"
        }
      },
      "properties": {
        "restored": {
          "items": {
            "$ref": "#/$defs/EntityKey"
          },
          "type": "array"
        }
      },
      "required": [
        "restored"
      ],
      "title": "Restored",
      "type": "object"
    },
    "summary": "Make named entities of a book equal to an earlier version (one commit; the rest of the book is untouched). The undo of every purge."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "at": {
          "description": "Or an exact prose version (hex Loro frontiers; the undo uses it).",
          "type": [
            "string",
            "null"
          ]
        },
        "book_at": {
          "description": "With `at`: the book document's version to take the owner's fields\nfrom (hex); omitted: the fields stay.",
          "type": [
            "string",
            "null"
          ]
        },
        "doc": {
          "type": "string"
        },
        "point": {
          "description": "A point's id from `history.points`.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "doc"
      ],
      "title": "RestorePointIn",
      "type": "object"
    },
    "kind": "command",
    "name": "history.restore_point",
    "output": {
      "properties": {
        "doc": {
          "type": "string"
        },
        "fields": {
          "description": "The owner's fields written back (empty when they already matched or\nthe point has no book version).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prose": {
          "description": "Whether the prose changed (it was not already the point's).",
          "type": "boolean"
        },
        "skipped": {
          "description": "Fields left as they are: an element's `name` and `aliases` when\nanother element has taken one of them since.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "doc",
        "prose",
        "fields",
        "skipped"
      ],
      "title": "PointRestored",
      "type": "object"
    },
    "summary": "Restore a prose document to a history point, per entity: the prose goes back (a new change; history stays) and its owner's title, summary and other metadata fields go back to that time; the rest of the book is untouched."
  },
  {
    "access": "write",
    "concurrency": "book",
    "input": {
      "properties": {
        "session": {
          "type": "string"
        },
        "turn": {
