              "type": [
                "integer",
                "null"
              ]
            },
            "deleted_at": {
              "description": "In Recently Deleted since (Unix seconds).",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "elements": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "purge_at": {
              "description": "In Recently Deleted: when it goes for good (Unix seconds) …",
