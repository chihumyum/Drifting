          ],
          "type": "object"
        }
      },
      "properties": {
        "book": {
          "type": "string"
        },
        "module": {
          "description": "The entry's prose module (required for ranges, blocks and anchors); omit for a material.",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "$ref": "#/$defs/CommentTargetV3",
          "description": "The entity whose prose the anchors are in."
        }
      },
      "required": [
        "book",
        "target"
      ],
      "title": "CommentAnchorsInV3",
      "type": "object"
    },
    "kind": "query",
    "name": "comment.anchors",
    "output": {
      "$defs": {
        "AnchorBytes": {
          "description": "A comment's anchor as stored: the two Loro cursors dr-doc writes\n(`Cursor::encode()`, the start on the first anchored character, the end\non the last), each in base64 (standard alphabet, padded). The editor\nmoves these bytes between the book and the prose document unchanged.",
          "properties": {
            "end": {
              "type": "string"
            },
            "start": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        "CommentAnchor": {
          "description": "One anchored comment, for an editor laying anchors out.",
          "properties": {
            "anchor": {
              "$ref": "#/$defs/AnchorBytes"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "description": "`note` or `todo`.",
              "type": "string"
            },
            "status": {
              "description": "`open` or `resolved`.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "status",
            "anchor"
          ],
          "type": "object"
        }
      },
      "items": {
        "$ref": "#/$defs/CommentAnchor"
      },
      "title": "Array_of_CommentAnchor",
      "type": "array"
    },
    "summary": "The stored anchors of the comments on one entity's prose, for an editor laying them out (comments without an anchor are not listed)."
  },
  {
    "access": "write",
    "book_version": 4,
    "concurrency": "book",
    "input": {
      "$defs": {
        "AnchorBytes": {
          "description": "A comment's anchor as stored: the two Loro cursors dr-doc writes\n(`Cursor::encode()`, the start on the first anchored character, the end\non the last), each in base64 (standard alphabet, padded). The editor\nmoves these bytes between the book and the prose document unchanged.",
          "properties": {
            "end": {
              "type": "string"
            },
            "start": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        "CommentTargetV3": {
