  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "$defs": {
        "CommentTaskIn": {
          "properties": {
            "block": {
              "description": "The task list paragraph's block id.",
              "type": "string"
            },
            "checked": {
              "default": false,
              "description": "The item's tick as the caller sees it. Not used: `comment.project`\nreads the tick from the document (ticked = resolved).",
              "type": "boolean"
            },
            "task": {
              "default": "",
              "description": "The item's text as the caller sees it. Not used: `comment.project`\nreads the text from the document.",
              "type": "string"
            }
          },
          "required": [
            "block"
          ],
          "type": "object"
        },
        "TodoMarkerIn": {
          "properties": {
            "block": {
              "description": "The paragraph's block id.",
              "type": "string"
            },
            "task": {
              "default": "",
              "description": "The task text after the marker.",
              "type": "string"
            }
          },
          "required": [
            "block"
          ],
          "type": "object"
        }
      },
      "properties": {
        "doc": {
          "description": "`body:<entry>/<module>` of a book.",
          "type": "string"
        },
        "editing": {
          "type": [
            "string",
            "null"
          ]
        },
        "markers": {
          "default": [],
          "description": "Paragraphs starting with TODO / 待办 markers.",
          "items": {
            "$ref": "#/$defs/TodoMarkerIn"
          },
          "type": "array"
        },
        "tasks": {
          "description": "Present (even empty): project the document's checklist items too.\nTheir text and ticks are read from the document itself, not from\nthis list.",
          "items": {
            "$ref": "#/$defs/CommentTaskIn"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "doc"
      ],
      "title": "CommentProjectIn",
      "type": "object"
    },
    "kind": "command",
    "name": "comment.project",
    "output": {
      "properties": {
        "created": {
          "description": "Comments made for new markers or task items.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "removed": {
          "description": "Projected comments deleted because their line is gone: a marker's\nopen comment, a checklist item's comment whether resolved or not.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "waiting": {
          "description": "Open projected comments whose marker or task item is missing here, kept\nbecause this device has not yet received the prose they were made from\n(sync brings the book and the prose separately).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "created",
        "removed",
        "waiting"
      ],
      "title": "CommentProjected",
      "type": "object"
    },
    "summary": "Keep projected comments from TODO markers (origin = marker) and checklist items (origin = task) in one prose document in step with it: a new marker or checklist item gets a comment; a marker's open comment whose line is gone is deleted and its resolved one stays; a checklist item's comment follows the line's text and tick (ticked = resolved) and is deleted with the line, resolved or not; deterministic ids merge across devices."
  },
  {
    "access": "write",
    "book_version": 5,
    "concurrency": "book",
    "input": {
      "$defs": {
        "AnchorBytes": {
          "description": "A comment's anchor as stored: the two Loro cursors dr-doc writes\n(`Cursor::encode()`, the start on the first anchored character, the end\non the last), each in base64 (standard alphabet, padded). The editor\nmoves these bytes between the book and the prose document unchanged.",
          "properties": {
            "end": {
              "type": "string"
            },
            "start": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        }
      },
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchorBytes"
            },
            {
              "type": "null"
            }
          ],
          "description": "The anchor as the editor holds it (dr-doc's encoding, base64);\n`null` removes the anchor (the comment stays on its paragraph or\nentity)."
        },
        "book": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "book",
        "id",
        "anchor"
      ],
      "title": "CommentReanchorIn",
      "type": "object"
    },
    "kind": "command",
    "name": "comment.reanchor",
    "output": {
      "description": "The entity a command changed.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Done",
      "type": "object"
    },
    "summary": "Put a comment's anchor back where the editor's undo brought its text back (the author's change, synced; it follows the editor's undo, so it is not an entry of the object-level undo)."
  },
