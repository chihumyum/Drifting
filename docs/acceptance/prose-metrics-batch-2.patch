+    const { db, gateway, doc, rows } = await fixture();
+    const before = rows();
+    gateway.failNextExecute(sql => sql.startsWith('insert into "node_content"'), 'synthetic cache failure');
+    await expect(reconcile()).rejects.toMatchObject({ cause: { message: 'synthetic cache failure' } });
+    expect(rows()).toEqual(before);
+    await expect(db.transaction(async tx => persistNodeProseProjectionInTransaction(tx, {
+      ...await expected(doc, 3), projectId: 'another-project', updatedAt: NOW, touchNodeUpdatedAt: false,
+    }))).rejects.toThrow('no longer exists');
+    expect(rows()).toEqual(before);
+    await reconcile();
+    expect(rows()[0]).toMatchObject({ word_count_basis_revision: 3 });
+  });
+
+  it('does not revive a node deleted after batch capture', async () => {
+    const { gateway, rows } = await fixture();
+    const before = rows()[0];
+    const original = yjsRepo.readPersistedYjsDocuments;
+    vi.spyOn(yjsRepo, 'readPersistedYjsDocuments').mockImplementationOnce(async (tx, ids) => {
+      const captured = await original(tx, ids);
+      await tx.update(BookNodeTable).set({ deletedAt: NOW }).where(eq(BookNodeTable.id, 'node-0'));
+      return captured;
+    });
+    await reconcile();
+    expect(rows()[0]).toEqual(before);
+    expect(gateway.database.prepare("SELECT deleted_at FROM book_node WHERE id='node-0'").get()!.deleted_at).toBe(NOW);
+  });
