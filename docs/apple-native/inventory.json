  "decisionTasks": {
    "D1": "Yrs 0.28.0 with redone-offset and sparse-replay patches / Yjs 13.6.32 document matrix; full native behavior remains P2b/P2c",
    "D2": "TextKit engine choice and instrumentation: P2b",
    "D3": "UTF-16/CRDT/composition mapping: P2b",
    "D4": "Undo origins and shared multi-view owner: P2b",
    "D5": "Signing/sandbox/credentials/distribution/minimum-OS/Intel: before P5 exit",
    "D6": "Prose metric port, dependency and license parity: P3",
    "D7": "Minimal Rust Agent permission/read/write/review portability and platform transport matrix: before P4 bulk port",
    "D8": "PDF/audio/import/export library replacement or bounded transition: before P5 integration"
  },
  "excludedMigrationCapabilities": [
    "google-drive-sync",
    "google-drive-provider-snapshot-bootstrap"
  ],
  "scopeDecisions": {
    "2026-09-26-google-drive": "User excluded Google Drive synchronization from the native migration and will redesign it afterwards. Shared CRDT/local durability and accepted receiver foundations remain."
  }
