        "checklist": [
          { "id": "pov1", "type": "semantic", "assertion": "全文须保持第三人称限知视角，只呈现奥伦本人的所见所感；写出其他角色的内心活动、或奥伦当时不可能知道的信息，即为违反（头跳/全知）。" }
        ]
      },
      {
        "id": "rule-fact",
        "checklist": [
